
<div class="yw-alert yw-alert-info yw-search-building">
    {% if not exists %}
        {{ _t('SEARCH_INDEX_MISSING') }}
    {% else %}
        {{ _t('SEARCH_INDEX_BUILDING', {pending: pending}) }}
    {% endif %}
    {% if jobsUrl %}
        <br />
        <a href="{{ jobsUrl }}">{{ _t('SEARCH_INDEX_JOBS_LINK') }}</a>
    {% endif %}
    <br />
    <small><code>./yeswicli messenger:drain</code></small>
</div>
