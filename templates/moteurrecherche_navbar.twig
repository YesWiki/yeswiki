<form class="yeswiki-search-form navbar-search navbar-form {{ class }}" method="get" action="{{ url }}" role="search">
	<div class="yw-form-group">
		<div class="input-group input-append">    
		    <input type="text" class="search-query yw-input" placeholder="{{ _t('TEMPLATE_SEARCH_PLACEHOLDER') }}" value="{{ phrase }}" title="{{ _t('TEMPLATE_SEARCH_INPUT_TITLE') }}" accesskey="C" tabindex="1" name="phrase">
		    <span class="input-group-btn"><button type="submit" class="btn btn-default btn-search search-btn" title="{{ _t('TEMPLATE_SEARCH_BUTTON_TITLE') }}"><svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#search"/></svg></button></span>
	    </div>
	</div>          
	<input type="hidden" value="RechercheTexte" name="wiki">
</form> <!-- /.yeswiki-search-form -->
