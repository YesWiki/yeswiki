<h2>{{ _t('LOGIN_CHANGE_PASSWORD') }}</h2>

<form method="post">
  {% if errorType == 'emptyEmail' %}
    <div class="alert alert-danger">{{ _t('LOGIN_ADD_EMAIL_TO_CONTINUE') }}.</div>
  {% elseif errorType %}
    <div class="alert alert-danger">{{ errorType }}</div>
  {% endif %}
  <div class="yw-form-group">
    <label class="yw-form-label" for="email">{{ _t('LOGIN_EMAIL') }}</label>
    <div class="controls">
      <input type="email" class="yw-input" name="email" required value="" placeholder="{{ _t('LOGIN_EMAIL') }}">
    </div>
  </div>
  <div class="yw-form-group">
    <input type="hidden" name="subStep" value="1" />
    <div class="controls">
      <button type="submit" class="yw-btn yw-btn--primary">{{ _t('LOGIN_SEND') }}</button>
    </div>
  </div>
</form>