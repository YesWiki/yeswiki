{{ include_css('styles/yw-entries.css') }}
{% if entries|length > 0 %}
  <div class="trombi-container">
    {% for entry in entries %}
       <a class="bazar-entry modalbox" data-size="modal-lg" {{ entry.html_data|raw }}
          href="{{ entry.url ~ (entry['external-data']  ? "/iframe" : "") }}"{{ entry['external-data']  ? " data-iframe=\"1\"" : ''  }}

          title="{{ entry.title|striptags }}"
          aria-label="{{ entry.title|striptags }}">
          <div class="image-container">
            {% if entry.imagebf_image is not empty %}
              <img loading="lazy" class="trombi-image" alt=""
                   src="{{ entry['external-data']
                        ? entry['external-data']['baseUrl'] ~ 'cache/image_300_300_' ~ entry.imagebf_image
                        : resizedImage(entry.imagebf_image, 300, 300, 'crop', '_') }}"
                   {{ entry['external-data']
                    ? 'onerror=this.src=\'' ~ entry['external-data'].baseUrl ~ 'files/' ~ entry.imagebf_image ~ "\'"
                    : '' }} > 
            {% else %}
              <div class="trombi-image img-placeholder" aria-hidden="true"></div>
              <svg class="yw-icon trombi-image icon-placeholder" aria-hidden="true"><use href="src/assets/icons.svg#user-circle"/></svg>
            {% endif %}
          </div>

          <div class="caption trombi-content">
            <span class="title">{{ entry.title }}</span>
         </div>
       </a> <!-- / bazar-entry -->
    {% endfor %}
  </div> <!-- / trombi-container -->
{% endif %}
{{ pager_links }}
