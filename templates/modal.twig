{% extends "@core/default.twig" %}

{% block logoutLinkClass %}yw-btn{% endblock %}

{% block connected %}
    <a href="#LoginModal" role="button" class="navbar-btn {{ not nobtn ? 'yw-btn ' ~ btnclass : '' }}" data-toggle="modal" data-tooltip="tooltip" data-placement="bottom" aria-label="{{ _t('LOGIN_MY_OPTIONS')}}" title="{{ _t('LOGIN_MY_OPTIONS')}}">
        <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#user"/></svg> {{ user }}
    </a>
    <div class="yw-modal" id="LoginModal" tabindex="-1" role="dialog" aria-labelledby="LoginModalLabel">
        <div class="yw-modal__dialog">
            <div class="yw-modal__content">
                <div class="yw-modal__header">
                    <h3 class="yw-modal__title" id="LoginModalLabel">{{ _t('LOGIN_CONNECTED_AS') }} {{ user }}</h3>
                    <button type="button" class="yw-close" data-yw-dismiss="modal" aria-label="close">&times;</button>
                </div>
                <div class="yw-modal__body">
                    <ul class="login-actions">
                        {{ block('loginActionsPart1') }}
                    </ul>
                </div>
                <div class="yw-modal__footer">
                    {{ block('logoutLink') }}
                </div>
            </div><!-- /.yw-modal__content -->
        </div><!-- /.yw-modal__dialog -->
    </div> <!-- /#LoginModal-->
{% endblock %}

{% block formClass %}login-form-modal{% endblock %}
{% block formTitle %}{% endblock %}

{% block notConnected %}
    <a href="#LoginModal" role="button" class="btn-icon navbar-btn {{ not nobtn ? 'yw-btn ' ~ btnclass : '' }}" data-toggle="modal" data-placement="bottom" title="{{ _t('LOGIN_LOGIN') }}" data-tooltip="tooltip" aria-label="{{ _t('LOGIN_LOGIN')}}">
        <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#user"/></svg><span class="login-text"> {{ _t('LOGIN_LOGIN') }}</span>
    </a>
    <div class="yw-modal" id="LoginModal" tabindex="-1" role="dialog" aria-labelledby="LoginModalLabel">
        <div class="yw-modal__dialog yw-modal__dialog--sm">
            <div class="yw-modal__content">
                <div class="yw-modal__header">
                    <h3 class="yw-modal__title" id="LoginModalLabel">{{ _t('LOGIN_LOGIN') }}</h3>
                    <button type="button" class="yw-close" data-yw-dismiss="modal" aria-label="close">&times;</button>
                </div>
                <div class="yw-modal__body">
                    {{ block('form') }}
                </div>
            </div>
        </div><!-- /.yw-modal__dialog -->
    </div> <!-- /#LoginModal-->
{% endblock %}
