{% if error %}
  <div class="alert alert-danger">{{ error|raw }}</div>
{% endif %}

{# Preview #}
{% if preview and hasContent %}
  <h1>{{ _t('EDIT_PREVIEW') }}</h1>
  <div class="page_preview">
    {{ bodyPreview|raw }}
  </div>
{% endif %}

{# the edited form and the actions-builder rail are siblings in one flex row: the rail
   configures what is being edited, it is not part of what gets posted #}
<div class="yw-designer">
<div class="yw-designer__canvas">

{# hx-boost="false": htmx swallows a boosted multipart POST -- see ADR-0004/ticket 16 #}
<form id="ACEditor" name="ACEditor" enctype="multipart/form-data" hx-boost="false"
      action="{{ url({ handler: handler }) }}" method="POST">

  {% if passwordForEditing %}
    <input type="hidden" name="password_for_editing" value="{{ request.post['password_for_editing'] }}" />
  {% endif %}

  <input type="hidden" name="previous" value="{{ previous }}" />

  {# The Page form's own fields (ticket 10). Whatever the webmaster declared before the
     `content` field renders above the editor and whatever comes after renders below, so
     the designer decides this page's layout the same way it decides an entry's. #}
  {% for input in fieldsBeforeContent %}{{ input|raw }}{% endfor %}

  {# A Content type with no `content` field has no prose: an account and a file are not
     wiki markup, so they get their fields and no editor at all. #}
  {% if hasContent %}
    {% if preview %}
      <input type="hidden" name="body" value="{{ body|raw }}" />
    {% else %}
      {# no saveButton: `content` is one field among the form's own (ticket 10), and the
         form already has its Save below -- two save buttons on one form is one too many #}
      {{ renderAction('aceditor', { name: 'body', value: body })|raw }}
    {% endif %}
  {% endif %}

  {% for input in fieldsAfterContent %}{{ input|raw }}{% endfor %}

  {% if request.get.newpage is same as '1' and request.get.theme is not empty %}
    <input type="hidden" name="newpage" value="1"/>
    {% for key in [
          'theme',
          'style',
          'squelette',
          'bgimg',
          'PageFooter',
          'PageHeader',
          'PageMenu',
          'favorite_preset'
          ] %}
      {% if request[key] is not empty %}
          <input type="hidden" name="{{key}}" value="{{request[key]}}"/>
      {% endif %}
    {% endfor %}
  {% endif %}

  {# What you can do while editing, said twice: floating in the corner, so it is at hand
     wherever you are in a long page, and again at the foot of the form, where a form's
     buttons have always been and where you end up after filling one in. Same buttons from
     one macro, so the two cannot drift apart.

     `{{editbar}}` renders no cluster on an edit screen -- one corner, one set of actions --
     and these live in the editor's own template rather than in the bar so that the only way
     to save a page is never in a template a theme may leave out.

     Inside the <form>, so the buttons submit it without naming it. #}
  <nav class="yw-page-actions yw-page-actions--editing" aria-label="{{ _t('TEMPLATE_SAVE') }}">
    {{ _self.saveButton(saveValue, true) }}
    <div class="yw-page-actions__more">
      {{ _self.otherActions(config, preview, cancelUrl, deleteUrl, true) }}
    </div>
  </nav>

  <div class="form-actions">
    {{ _self.saveButton(saveValue, false) }}
    {{ _self.otherActions(config, preview, cancelUrl, deleteUrl, false) }}

    {# Reedit Button: only ever here. It belongs to the preview screen, which is a page you
       are reading rather than a corner you are working from. #}
    {% if preview %}
      <button type="submit" name="submit" value="reedit" class="yw-btn">
        {{ icon('arrow-back-up') }}
        <span>{{ _t('TEMPLATE_REEDIT') }}</span>
      </button>
    {% endif %}

    {# Theme Button #}
    {% if not preview %}
      <span class="theme-container">
        {# Filled by tools/template/handler/page/edit__ #}
        {# TODO: stop using all those edit__, and put directly the code here #}
      </span>
    {% endif %}
  </div>

</form>

</div>{# .yw-designer__canvas #}
{{ include('@core/aceditor-rails.twig') }}
</div>{# .yw-designer #}

{# The buttons themselves, in one place. `floating` is the only difference between the two
   copies: in the corner the cluster collapses to the save button and shrinks the rest, at
   the foot of the form they are one plain row. #}
{% macro saveButton(saveValue, floating) %}
  <button type="submit"
          name="submit"
          value="{{ saveValue }}"
          class="yw-btn {{ floating ? 'yw-page-actions__edit' : 'yw-btn--primary' }}">
    {{ icon('device-floppy') }}
    <span>{{ _t('TEMPLATE_SAVE') }}</span>
  </button>
{% endmacro %}

{% macro otherActions(config, preview, cancelUrl, deleteUrl, floating) %}
  {% set size = floating ? 'yw-btn--sm' : '' %}
  {% if config['preview_before_save'] and not preview %}
    <button type="submit" name="submit" value="preview" class="yw-btn {{ size }}">
      {{ icon('eye') }}
      <span>{{ _t('EDIT_PREVIEW') }}</span>
    </button>
  {% endif %}
  {# leaving, then destroying: the two ways out, in that order, and the one that keeps the
     page comes first #}
  <a href="{{ cancelUrl }}" class="yw-btn {{ size }} link-cancel">
    {{ icon('x') }}
    <span>{{ _t('TEMPLATE_CANCEL') }}</span>
  </a>
  {% if deleteUrl %}
    <a href="{{ deleteUrl }}"
       title="{{ _t('TEMPLATE_DELETE_PAGE') }}"
       class="yw-btn {{ size }} yw-btn--danger link-deletepage modalbox">
      {{ icon('trash') }}
      <span>{{ _t('TEMPLATE_DELETE') }}</span>
    </a>
  {% endif %}
{% endmacro %}
