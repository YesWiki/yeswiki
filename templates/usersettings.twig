{% if adminIsActing %} <a href="{{ url({tag: 'GererUtilisateurs'}) }}" class="btn btn-primary pull-right"><svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#arrow-left"/></svg> {{ _t('USER_GOTOADMIN') }}</a>{% endif %}
<h2>{{ _t('USER_SETTINGS') }}{% if adminIsActing %} — {{ user.name }}{% endif %}</h2>

{% if errorUpdate is not empty %}
  <div class="alert alert-danger">{{ errorUpdate }}</div>
{% endif %}

<form
  action="{{ url({tag: ''}|merge((
    adminIsActing
    ? {params: {user: user.name, from: referrer}}
    : {}
    ))) }}"
  method="post"
  enctype="multipart/form-data"
  hx-boost="false"
  class="">
  <input type="hidden" name="usersettings_action" value="update{{ adminIsActing ? 'ByAdmin' : '' }}" />
  {% if avatar %}
    <div class="yw-account-face">
      {% include '@core/_avatar.twig' with { avatar: avatar } only %}
      <span class="yw-account-face__name">{{ user.name }}</span>
    </div>
  {% endif %}
  <div class="yw-form-group">
        <label class="yw-form-label">{{ _t('USER_EMAIL_ADDRESS') }}</label>
        <div class="controls">
            <input class="yw-input" name="email" value="{{ user.email }}" size="40" />
        </div>
    </div>

  {{ profileFields|raw }}

  <div class="yw-form-group">
        <div class="controls">
      <input type="hidden" name="csrf-token-update" value="{{ csrfToken({id: 'main', refresh: false}) }}">
            <input class="btn btn-primary" type="submit" value="{{ _t('USER_UPDATE')|e('html_attr') }}" />
      {% if userLoggedIn %}
        <input
          class="btn btn-warning"
          type="button"
          value="{{ _t('USER_DISCONNECT')|e('html_attr') }}"
          onclick="document.location='{{ url({params: {usersettings_action: 'logout'}})|e('html_attr') }}'" />
      {% endif %}
        </div>
    </div>
</form>

{{ include('@core/aceditor-rails.twig') }}

{% if adminIsActing %}
  <form action="{{ url({params: {user: user.name, from: referrer}}) }}" method="post" class="">
    <input type="hidden" name="csrf-token-delete" value="{{ csrfToken({id: 'main', refresh: false})|e('html_attr') }}">
    <input type="hidden" name="usersettings_action" value="resetpass" />
    <input class="btn btn-neutral" type="submit" value="{{ _t('RESETTING_THE_PASSWORD') }}" />
  </form>
  <form action="{{ url({params: {user: user.name, from: referrer}}) }}" method="post" class="">
    <input type="hidden" name="csrf-token-delete" value="{{ csrfToken({id: 'main', refresh: false})|e('html_attr') }}">
    <input type="hidden" name="usersettings_action" value="deleteByAdmin" />
    <input class="btn btn-danger" type="submit" value="{{ _t('USER_DELETE')|e('html_attr') }}" />
  </form>
{% endif %}

{% if userLoggedIn %}
  <form action="{{ url({tag: ''}) }}" method="post" class="">
      <hr>
      <input type="hidden" name="usersettings_action" value="changepass" />
      <h2>{{ _t('USER_CHANGE_THE_PASSWORD') }}</h2>
    {% if errorPasswordChange is not empty %}
      <div class="alert alert-danger">{{ errorPasswordChange }}</div>
    {% endif %}
    {% if inIframe %}
      {% set urlWithoutIframe = url({handler: 'show'})|replace({'/show': ''}) %}
      <div class="alert alert-warning">{{ _t('USERSETTINGS_CHANGE_PWD_IN_IFRAME')|nl2br
        |replace({
          '{baseUrl}': urlWithoutIframe,
          '{link}': "<a target=\"_blank\" href=\"#{urlWithoutIframe}\">#{urlWithoutIframe}</a>",
          })|raw }}</div>
    {% endif %}
    <div class="yw-form-group">
      <label class="yw-form-label">{{ _t('USER_OLD_PASSWORD') }}</label>
      <div class="controls">
        <input class="yw-input" type="password" name="oldpass" size="40" />
      </div>
    </div>
    <div class="yw-form-group">
      <label class="yw-form-label">{{ _t('LOGIN_NEW_PASSWORD') }}</label>
      <div class="controls">
        <input class="yw-input" type="password" name="password" size="40" />
      </div>
    </div>
    <div class="yw-form-group">
      <div class="controls">
        <input type="hidden" name="csrf-token-changepass" value="{{ csrfToken({id: 'main', refresh: false})|e('html_attr') }}">
        <input class="btn btn-primary" type="submit" value="{{ _t('USER_CHANGE')|e('html_attr') }}" size="40" />
      </div>
    </div>
  </form>
{% endif %}

