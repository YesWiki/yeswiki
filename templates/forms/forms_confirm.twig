<div>
	<form action="{{ url({params:{
			view: 'formulaire',
			action: type,
			formid: int(request.get.formid ?? 'error')
		}}) }}"
		method="post"
		style="display: inline"
		>
		{{ include("@core/alert-message.twig",{
			type: "warning",
			message: 
				_t(type == 'delete' ? 'BAZ_FORM_DELETE' : 'BAZ_FORM_EMPTY',{'formId': int(request.get.formid)}) ~ '<br/>' ~
		    '<b>' ~ _t(type == 'delete' ? 'BAZ_CONFIRM_SUPPRIMER_FORMULAIRE' : 'BAZ_CONFIRM_VIDER_FORMULAIRE') ~ ' ?</b><br/>'
		}) }}
		<input type="hidden" name="confirm{{ type == 'delete' ? 'Delete' : 'Empty' }}Token" value="{{ csrfToken({id:'main',refresh:false})|e('html_attr') }}">
		<input type="submit"
			class="yw-btn yw-btn--danger"
			value="{{ _t(type == 'delete' ? 'BAZ_SUPPRIMER_FORMULAIRE' : 'BAZ_VIDER_FORMULAIRE') }}" 
			style="vertical-align: middle; display: inline" />
	</form>
	<form action="{{ url({params:{
			view: 'formulaire'
		}}) }}"
		method="post"
		style="display: inline"
		>
		<input type="submit" 
			value="{{ _t('BAZ_ANNULER') }}" 
			class="yw-btn"
			style="vertical-align: middle; display: inline" />
	</form>
</div>
