
<article class="form-card" data-yw-card-filter-item="{{ (form.title ~ ' ' ~ (form.description ?? '') ~ ' ' ~ key)|lower }}">
  <header class="form-card__header">
    <h3 class="form-card__title">
      {% if form.contentType %}
        <span class="form-card__icon">{{ icon({
          page: 'file', user: 'user', file: 'paperclip', entry: 'briefcase',
        }[form.contentType]|default('briefcase')) }}</span>
      {% endif %}
      {{ form.title }}
      <span class="form-card__id" title="{{ _t('BAZ_ID') }}">#{{ key }}</span>
    </h3>
    {% if form.description %}<p class="form-card__description">{{ form.description }}</p>{% endif %}

    <p class="form-card__stats">
      {% if form.stats.count is null %}
        <span class="form-card__count" title="{{ _t('BAZ_FORM_ENTRY_COUNT_UNKNOWN_HINT') }}">{{ _t('BAZ_FORM_ENTRY_COUNT_UNKNOWN') }}</span>
      {% elseif form.stats.count == 0 %}
        <span class="form-card__count form-card__count--empty">{{ _t('BAZ_FORM_ENTRY_COUNT_NONE') }}</span>
      {% elseif form.stats.count == 1 %}
        <span class="form-card__count">{{ _t('BAZ_FORM_ENTRY_COUNT_ONE') }}</span>
      {% else %}
        <span class="form-card__count">{{ _t('BAZ_FORM_ENTRY_COUNT', { count: form.stats.count }) }}</span>
      {% endif %}
      {% if form.stats.last ?? '' %}
        <span class="form-card__last" title="{{ form.stats.last }}">
          {{ _t('BAZ_FORM_LAST_ENTRY', { date: form.stats.last|date(_t('BAZ_FORM_DATE_FORMAT')) }) }}
        </span>
      {% endif %}
    </p>
  </header>

  <div class="form-card__entries">
    <a class="yw-btn yw-btn--sm" href="{{ url({ params: { view: 'consulter', action: 'recherche', id: key }}) }}">
      <svg class="yw-icon icon-search" aria-hidden="true"><use href="src/assets/icons.svg#loupe"/></svg>
      {{ _t('BAZ_RECHERCHER') }}
    </a>

    {% if form.canCreateContent %}
      <a class="yw-btn yw-btn--sm" href="{{ url({ params: { view: 'saisir', action: 'saisir_fiche', id: key }}) }}">
        <svg class="yw-icon icon-plus" aria-hidden="true"><use href="src/assets/icons.svg#plus"/></svg>
        {{ _t('BAZ_SAISIR_UNE_NOUVELLE_FICHE') }}
      </a>
    {% endif %}
  </div>

  <div class="form-card__formats">
    <span class="form-card__formats-label">{{ _t('BAZ_DATA_FORMAT') }}</span>

    <a class="form-card__format" title="{{ _t('BAZ_RSS') }}" href="{{ url({ tag: 'api/entries/rss', params: { id: key }}) }}">RSS</a>
    <a class="form-card__format" title="{{ _t('BAZ_CSV') }}" href="{{ url({ tag: 'api', handler: 'forms/' ~ key ~ '/entries/csv'}) }}">CSV</a>
    <a class="form-card__format" target="_blank" title="{{ _t('BAZ_JSON') }}" href="{{ url({ tag: 'api', handler: 'forms/' ~ key ~ '/entries'}) }}">JSON</a>
    {% if form.isSemantic %}
      <a class="form-card__format" target="_blank" title="{{ _t('BAZ_JSON_LD') }}" href="{{ url({ tag: 'api', handler: 'forms/' ~ key ~ '/entries/json-ld'}) }}">JSON-LD</a>
    {% endif %}
    {% if form.isGeo %}
      <a class="form-card__format" target="_blank" title="{{ _t('BAZ_GEOJSON') }}" href="{{ url({ tag: 'api', handler: 'forms/' ~ key ~ '/entries/geojson'}) }}">GeoJSON</a>
    {% endif %}
    {% if form.isDate %}
      <a class="form-card__format" target="_blank" title="{{ _t('BAZ_ICAL') }}" href="{{ url({ tag: 'api', handler: 'forms/' ~ key ~ '/entries/ical'}) }}">iCal</a>
    {% endif %}
    {% if form.isActivityPubEnabled %}
      <a class="form-card__format" target="_blank" title="{{ _t('BAZ_ACTIVITYPUB_ACTOR') }}" href="/actors/{{ key }}">ActivityPub</a>
    {% endif %}
  </div>

  <footer class="form-card__actions">
    <div class="yw-table__actions">
      {% if form.canEdit %}
        <a class="yw-btn yw-btn--sm" title="{{ _t('BAZ_MODIFIER_FORMULAIRE') }}" href="{{ url({ params: { view: 'formulaire', action: 'modif', formid: key }}) }}" data-toggle="tooltip" data-placement="bottom">
          <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#pencil"/></svg>
        </a>
      {% else %}
        <button type="button" class="yw-btn yw-btn--sm" disabled="disabled" data-toggle="tooltip" data-placement="bottom" title="{{ tooltipMessage }}">
          <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#pencil"/></svg>
        </button>
      {% endif %}
      {% if not form.isSystem %}
        {% if form.canEdit %}
          <a class="yw-btn yw-btn--sm" title="{{ _t('BAZ_CLONE_FORM') }}" href="{{ url({ params: { view: 'formulaire', action: 'clone', formid: key }}) }}" data-toggle="tooltip" data-placement="bottom">
            <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#copy"/></svg>
          </a>
        {% else %}
          <button type="button" class="yw-btn yw-btn--sm" disabled="disabled" data-toggle="tooltip" data-placement="bottom" title="{{ tooltipMessage }}">
            <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#copy"/></svg>
          </button>
        {% endif %}
      {% endif %}
      {% if form.isActivityPubEnabled %}
        <a class="yw-btn yw-btn--sm" title="{{ _t('BAZ_GESTION_ABONNEMENTS') }}" href="{{ url({ params: { view: 'abonnements', action: 'list', formid: key }}) }}" data-toggle="tooltip" data-placement="bottom">
          <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#user-plus"/></svg>
        </a>
      {% endif %}
      {% if form.bookmarklet %}

        <a class="yw-btn yw-btn--sm" title="{{ _t('FORM_EDIT_BOOKMARKLET') }}" data-toggle="collapse" href="#bookmarklet-{{ key }}" data-placement="bottom">
          <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#bookmark"/></svg>
        </a>
      {% endif %}
    </div>

    {% if not form.isSystem %}

      <div class="yw-table__actions form-card__destructive">
        {% if form.canDelete %}
          <a class="yw-btn yw-btn--sm yw-btn--danger modalbox" title="{{ _t('BAZ_VIDER_FORMULAIRE') }}" href="{{ url({ params: { view: 'formulaire', action: 'confirm_empty', formid: key, showmenu: 0 }}) }}" data-toggle="tooltip" data-placement="bottom">
            <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#eraser"/></svg>
          </a>
          <a class="yw-btn yw-btn--sm yw-btn--danger modalbox" title="{{ _t('BAZ_SUPPRIMER_FORMULAIRE') }}" href="{{ url({ params: { view: 'formulaire', action: 'confirm_delete', formid: key, showmenu: 0 }}) }}" data-toggle="tooltip" data-placement="bottom">
            <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#trash"/></svg>
          </a>
        {% else %}
          <button type="button" class="yw-btn yw-btn--sm yw-btn--danger" disabled="disabled" data-toggle="tooltip" data-placement="bottom" title="{{ tooltipMessage }}">
            <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#eraser"/></svg>
          </button>
          <button type="button" class="yw-btn yw-btn--sm yw-btn--danger" disabled="disabled" data-toggle="tooltip" data-placement="bottom" title="{{ tooltipMessage }}">
            <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#trash"/></svg>
          </button>
        {% endif %}
      </div>
    {% endif %}
  </footer>

  {% if form.bookmarklet %}
    <div id="bookmarklet-{{ key }}" class="yw-collapse">
      {{ include('@core/forms/bookmarklet-widget.twig', {
        formId: key,
        urlField: form.bookmarklet.url_field ?? 'bf_url',
        descriptionField: form.bookmarklet.description_field ?? 'bf_description',
        text: form.bookmarklet.text_field ?? '',
      }) }}
    </div>
  {% endif %}
</article>
