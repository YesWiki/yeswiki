{# ticket 26: the form designer is a vanilla ES module (javascripts/form-builder/)
   editing the stored JSON template directly — no jQuery, no vendored formBuilder #}
{{ include_javascript('javascripts/vendor/sortablejs/sortable.js') }}
{{ include_javascript('javascripts/form-builder/form-builder.js', false, true) }}
{{ include_css('styles/form-builder.css') }}

<form
  action=""
  method="post"
  name="formulaire"
  id="formulaire"
>
  <div class="yw-form-group">
    <label class="yw-form-label">
      {{ _t('BAZ_NOM_FORMULAIRE') }}
      <span class="symbole_obligatoire"></span>
    </label>
    <input
      class="yw-input"
      name="label"
      type="text"
      value="{{ form.label }}"
      required
    />
  </div>
  <div class="yw-form-group">
    <label class="yw-form-label">
      {{ _t('BAZ_DESCRIPTION') }}
    </label>
    <textarea
      class="yw-input"
      cols="20"
      rows="3"
      name="description"
    >
      {{- form.description -}}
    </textarea>
  </div>

  <div class="yw-form-group">
    <label class="yw-form-label form-builder-label">
      {{ _t('BAZ_TEMPLATE') }}
      <span class="symbole_obligatoire"></span>
    </label>
    <ul class="yw-nav" role="tablist">
      <li role="presentation" class="active">
        <a href="#formbuilder" aria-controls="formbuilder" role="tab" data-toggle="tab">
          {{ _t('BAZ_FORM_GRAPHICAL_BUILDER') }}
        </a>
      </li>
      <li role="presentation">
        <a href="#code" aria-controls="code" role="tab" data-toggle="tab">
          {{ _t('BAZ_FORM_WIKI_CODE') }}
        </a>
      </li>
    </ul>

    <div class="yw-tabs__content">
      <div role="tabpanel" class="yw-tabs__pane active" id="formbuilder">
        <!-- container where the form builder will be rendered -->
        <div id="form-builder-container"></div>
      </div>
      <div role="tabpanel" class="yw-tabs__pane" id="code">
        <textarea
          class="yw-input"
          id="form-builder-text"
          cols="20"
          rows="25"
          name="template"
          required
        >
          {{- form.template is defined and form.template is not null
              ? form.template|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES'))
              : ('[{"type": "texte", "name": "bf_titre", "label": "' ~ _t('BAZ_TITREANNONCE') ~ '", "sub_type": "text", "required": "1"}]') -}}
        </textarea>
      </div>
    </div>
  </div>

  {# ---- Entry title (entry_title_template, ADR-0010): a select of the form's
     fields, rebuilt live by the designer, plus a custom-template mode ---- #}
  <div class="yw-form-group" id="entry-title-group">
    <label class="yw-form-label">
      {{ _t('FORM_EDIT_ENTRY_TITLE') }}
      <span class="symbole_obligatoire"></span>
    </label>
    <select id="entry-title-select" class="yw-input"></select>
    <input
      class="yw-input"
      id="entry-title-custom"
      name="entry_title_template"
      type="text"
      value="{{ form.entry_title_template ?? '{{bf_titre}}' }}"
      placeholder="{{ '{{bf_field1}} - {{bf_field2}}' }}"
      required
    />
  </div>

  {# ---- Permissions (entry_*_access + comments toggle) ---- #}
  <fieldset class="yw-form-group">
    <legend class="yw-form-label">{{ _t('FORM_EDIT_PERMISSIONS') }}</legend>
    <div class="yw-form-group">
      <label class="yw-form-label">{{ _t('BAZ_FORM_EDIT_ACL_READ_LABEL') }}</label>
      <input class="yw-input" name="entry_read_access" type="text" value="{{ form.entry_read_access }}" placeholder="*" />
    </div>
    <div class="yw-form-group">
      <label class="yw-form-label">{{ _t('BAZ_FORM_EDIT_ACL_WRITE_LABEL') }}</label>
      <input class="yw-input" name="entry_write_access" type="text" value="{{ form.entry_write_access }}" placeholder="%" />
    </div>
    <div class="yw-form-group">
      <label class="yw-form-label">{{ _t('BAZ_FORM_EDIT_ACL_COMMENT_LABEL') }}</label>
      <input class="yw-input" name="entry_comment_access" type="text" value="{{ form.entry_comment_access }}" placeholder="comments-closed" />
    </div>
    <div class="yw-form-group">
      <label>
        <input type="checkbox" name="entry_permit_activate_comments" value="1" {% if form.entry_permit_activate_comments %}checked{% endif %}>
        {{ _t('BAZ_FORM_EDIT_ACL_ASK_IF_ACTIVATE_COMMENT_LABEL') }}
      </label>
    </div>
  </fieldset>

  {# ---- Presentation (entry_metadatas) ---- #}
  <fieldset class="yw-form-group">
    <legend class="yw-form-label">{{ _t('FORM_EDIT_PRESENTATION') }}</legend>
    <div class="yw-form-group">
      <label class="yw-form-label">{{ _t('BAZ_FORM_EDIT_METADATA_THEME_LABEL') }}</label>
      <input class="yw-input" name="entry_metadatas[theme]" type="text" value="{{ form.entry_metadatas.theme ?? '' }}" />
    </div>
    <div class="yw-form-group">
      <label class="yw-form-label">{{ _t('BAZ_FORM_EDIT_METADATA_SQUELETON_LABEL') }}</label>
      <input class="yw-input" name="entry_metadatas[skeleton]" type="text" value="{{ form.entry_metadatas.skeleton ?? '' }}" />
    </div>
    <div class="yw-form-group">
      <label class="yw-form-label">{{ _t('BAZ_FORM_EDIT_METADATA_STYLE_LABEL') }}</label>
      <input class="yw-input" name="entry_metadatas[style]" type="text" value="{{ form.entry_metadatas.style ?? '' }}" />
    </div>
    <div class="yw-form-group">
      <label class="yw-form-label">{{ _t('BAZ_FORM_EDIT_METADATA_BACKGROUND_IMAGE_LABEL') }}</label>
      <input class="yw-input" name="entry_metadatas[background_image]" type="text" value="{{ form.entry_metadatas.background_image ?? '' }}" />
    </div>
    <div class="yw-form-group">
      <label class="yw-form-label">{{ _t('BAZ_FORM_EDIT_METADATA_PRESET_LABEL') }}</label>
      <input class="yw-input" name="entry_metadatas[css_preset]" type="text" value="{{ form.entry_metadatas.css_preset ?? '' }}" />
    </div>
  </fieldset>

  {% if onlyOneEntryOptionAvailable %}
    <div class="yw-form-group">
      <label for="only_one_entry">
        {% apply spaceless %}
          <input
            id="only_one_entry"
            type="checkbox"
            value="Y"
            name="only_one_entry"{{ form.only_one_entry == "Y" ? ' checked' : ''}}
            onchange="document.getElementById('only_one_entry_message-group').classList.toggle('hide', !this.checked)"
            />
          <span>{{ _t('BAZ_ONLY_ONE_ENTRY_FOR_THIS_FORM') }}</span>
        {% endapply %}
      </label>
    </div>
    <div id="only_one_entry_message-group" class="yw-form-group{{ form.only_one_entry == "Y" ? '': ' hide' }}">
      <label class="yw-form-label">
        {{ _t('BAZ_MESSAGE_IF_OTHER_ENTRY_EXIST') }}
      </label>
      <input
        class="yw-input"
        name="only_one_entry_message"
        type="text"
        value="{{ form.only_one_entry_message }}"
        placeholder="{{ _t('BAZ_FORM_DEFAULT_MESSAGE_FOR_OTHER_ENTRY_IN_FORM') }}"
      />
    </div>
  {% endif %}

  <div class="yw-form-group">
    <a
      class="plusinfos yw-btn yw-btn--sm yw-btn--info"
      data-toggle="collapse"
      href="#collapseFour"
    >
      {{ _t('ADVANCED_CONFIGURATION') }}
    </a>
  </div>

  <div id="collapseFour" class="yw-collapse">
    {# ---- Account creation (entry_creates_user) ---- #}
    <div class="yw-form-group">
      <label>
        <input type="checkbox" id="entry-creates-user-enable" name="entry_creates_user_enable" value="1"
          {% if form.entry_creates_user %}checked{% endif %}
          onchange="document.getElementById('entry-creates-user-config').classList.toggle('hide', !this.checked)">
        {{ _t('FORM_EDIT_CREATES_USER') }}
      </label>
    </div>
    <div id="entry-creates-user-config" class="{{ form.entry_creates_user ? '' : 'hide' }}">
      <div class="yw-form-group">
        <label class="yw-form-label">{{ _t('BAZ_FORM_EDIT_USERS_WIKINI_NAME_FIELD_LABEL') }}</label>
        <input class="yw-input" name="entry_creates_user[name_field]" type="text" value="{{ form.entry_creates_user.name_field ?? 'bf_titre' }}" />
      </div>
      <div class="yw-form-group">
        <label class="yw-form-label">{{ _t('BAZ_FORM_EDIT_USERS_WIKINI_EMAIL_FIELD_LABEL') }}</label>
        <input class="yw-input" name="entry_creates_user[email_field]" type="text" value="{{ form.entry_creates_user.email_field ?? 'bf_mail' }}" />
      </div>
      <div class="yw-form-group">
        <label class="yw-form-label">{{ _t('BAZ_FORM_EDIT_ADD_TO_GROUP_LABEL') }}</label>
        <input class="yw-input" name="entry_creates_user[add_to_group]" type="text" value="{{ form.entry_creates_user.add_to_group ?? '' }}"
          placeholder="{{ _t('BAZ_FORM_EDIT_ADD_TO_GROUP_DESCRIPTION') }}" />
      </div>
      <div class="yw-form-group">
        <label>
          <input type="checkbox" name="entry_creates_user[update_email]" value="1"
            {% if (form.entry_creates_user.update_email ?? '') in ['1', 1, true] %}checked{% endif %}>
          {{ _t('BAZ_FORM_EDIT_USERS_WIKINI_AUTOUPDATE_MAIL') }}
        </label>
      </div>
      <div class="yw-form-group">
        <label class="yw-form-label">{{ _t('BAZ_FORM_EDIT_INSCRIPTIONLISTE_MAILINGLIST') }}</label>
        <input class="yw-input" name="entry_creates_user[mailing_list]" type="text" value="{{ form.entry_creates_user.mailing_list ?? '' }}" />
      </div>
    </div>

    {# ---- Bookmarklet (entry_bookmarklet; the install widget lives on the forms table) ---- #}
    <div class="yw-form-group">
      <label>
        <input type="checkbox" id="entry-bookmarklet-enable" name="entry_bookmarklet_enable" value="1"
          {% if form.entry_bookmarklet %}checked{% endif %}
          onchange="document.getElementById('entry-bookmarklet-config').classList.toggle('hide', !this.checked)">
        {{ _t('FORM_EDIT_BOOKMARKLET') }}
      </label>
    </div>
    <div id="entry-bookmarklet-config" class="{{ form.entry_bookmarklet ? '' : 'hide' }}">
      <div class="yw-form-group">
        <label class="yw-form-label">{{ _t('BAZ_FORM_EDIT_BOOKMARKLET_URLFIELD_LABEL') }}</label>
        <input class="yw-input" name="entry_bookmarklet[url_field]" type="text" value="{{ form.entry_bookmarklet.url_field ?? 'bf_url' }}" />
      </div>
      <div class="yw-form-group">
        <label class="yw-form-label">{{ _t('BAZ_FORM_EDIT_BOOKMARKLET_DESCRIPTIONFIELD_LABEL') }}</label>
        <input class="yw-input" name="entry_bookmarklet[description_field]" type="text" value="{{ form.entry_bookmarklet.description_field ?? 'bf_description' }}" />
      </div>
      <div class="yw-form-group">
        <label class="yw-form-label">{{ _t('BAZ_FORM_EDIT_BOOKMARKLET_TEXT_LABEL') }}</label>
        <input class="yw-input" name="entry_bookmarklet[text_field]" type="text" value="{{ form.entry_bookmarklet.text_field ?? '' }}" />
      </div>
    </div>

    <div class="yw-form-group">
      <label class="yw-form-label">
        {{ _t('BAZ_CONDITION') }}
      </label>
      <textarea
        class="yw-input"
        cols="20"
        rows="3"
        name="condition"
      >
        {{- form.condition -}}
      </textarea>
    </div>
    <div class="yw-form-group">
      <label>
        <input type="checkbox" name="activitypub_enable" value="1" {% if form.activitypub_enable %}checked{% endif %}>
        {{ _t('BAZ_ACTIVITYPUB_ENABLE') }}
      </label>
    </div>
    <div class="yw-form-group">
      <label class="yw-form-label">
        {{ _t('BAZ_ACTIVITYPUB_USERNAME') }}
      </label>
      <input
        class="yw-input"
        name="activitypub_username"
        type="text"
        value="{{ form.activitypub_username }}"
      />
    </div>
    <div class="yw-form-group">
      <label class="yw-form-label">{{ _t('BAZ_SEM_TEMPLATE') }}</label>
      <textarea
        class="yw-input"
        cols="20"
        rows="6"
        name="sem_template"
      >
        {{- form.sem_template -}}
      </textarea>
    </div>
    <div class="yw-form-group">
      <label class="yw-form-label">
        {{ _t('BAZ_SEM_REVERSE_TEMPLATE') }}
      </label>
      <textarea
        class="yw-input"
        cols="20"
        rows="6"
        name="sem_reverse_template"
      >
        {{- form.sem_reverse_template -}}
      </textarea>
    </div>
  </div>

  <div class="yw-form-group">
    <button type="submit" name="valider" class="yw-btn yw-btn--primary">
      {{ _t('BAZ_VALIDER') }}
    </button>
    <a class="yw-btn yw-btn--sm" href="{{ url({ params: { vue: 'formulaire' }}) }}">
      {{ _t('BAZ_ANNULER') }}
    </a>
  </div>
  <div class="symbole_obligatoire">
    {{ _t('BAZ_CHAMPS_REQUIS') }}
  </div>
  {% if form %}
  <input
    type="hidden"
    name="id"
    value="{{ form.id }}"
  />
  {% endif %}
</form>

<script>
  var groupsList = {{ groupsList|json_encode()|raw }};
  var formAndListIds = {{ formAndListIds|json_encode()|raw }};
</script>
