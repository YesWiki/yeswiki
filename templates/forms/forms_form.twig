
{{ include_javascript('javascripts/vendor/sortablejs/sortable.js') }}
{{ include_javascript('javascripts/form-builder/form-builder.js', false, true) }}
{{ include_css('styles/yw-admin.css') }}

<form
  action=""
  method="post"
  name="formulaire"
  id="formulaire"
>
  <div class="yw-form-group">
    <label class="yw-form-label">
      {{ _t('BAZ_NOM_FORMULAIRE') }}
      <span class="symbole_obligatoire"></span>
    </label>
    <input
      class="yw-input"
      name="label"
      type="text"
      value="{{ form.label }}"
      required
    />
  </div>
  <div class="yw-form-group">
    <label class="yw-form-label">
      {{ _t('BAZ_DESCRIPTION') }}
    </label>
    <textarea
      class="yw-input"
      cols="20"
      rows="3"
      name="description"
    >
      {{- form.description -}}
    </textarea>
  </div>

  <div class="yw-form-group">
    <label class="yw-form-label form-builder-label">
      {{ _t('BAZ_TEMPLATE') }}
      <span class="symbole_obligatoire"></span>
    </label>
    <div class="yw-fb__tabs">
      <ul class="yw-nav" role="tablist">
        <li role="presentation" class="active">
          <a href="#formbuilder" aria-controls="formbuilder" role="tab" data-toggle="tab">
            {{ _t('BAZ_FORM_GRAPHICAL_BUILDER') }}
          </a>
        </li>
        <li role="presentation">
          <a href="#code" aria-controls="code" role="tab" data-toggle="tab">
            {{ _t('BAZ_FORM_WIKI_CODE') }}
          </a>
        </li>
      </ul>

      <button type="button" class="yw-btn yw-fb__rail-open" data-yw-fb-open>
        <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#plus"/></svg>
        {{ _t('FORM_BUILDER_ADD_FIELDS') }}
      </button>
    </div>

    <div class="yw-tabs__content">
      <div role="tabpanel" class="yw-tabs__pane active" id="formbuilder">
        <div
          id="form-builder-container"
          data-locked-fields="{{ (lockedFields|default([]))|json_encode }}"
          data-groups="{{ (groupsList|default([]))|json_encode }}"
          data-form-and-list-ids="{{ (formAndListIds|default({}))|json_encode }}"
        ></div>
      </div>
      <div role="tabpanel" class="yw-tabs__pane" id="code">
        <textarea
          class="yw-input"
          id="form-builder-text"
          cols="20"
          rows="25"
          name="template"
          required
        >
          {{- form.template is defined and form.template is not null
              ? form.template|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES'))
              : ('[{"type": "texte", "name": "bf_titre", "label": "' ~ _t('BAZ_TITREANNONCE') ~ '", "sub_type": "text", "required": "1"}]') -}}
        </textarea>
      </div>
    </div>
  </div>

  <div class="yw-form-group" id="entry-title-group">
    <label class="yw-form-label">
      {{ _t('FORM_EDIT_ENTRY_TITLE') }}
      <span class="symbole_obligatoire"></span>
    </label>
    <select id="entry-title-select" class="yw-input"></select>
    <input
      class="yw-input"
      id="entry-title-custom"
      name="entry_title_template"
      type="text"
      value="{{ form.entry_title_template ?? '{{bf_titre}}' }}"
      placeholder="{{ '{{bf_field1}} - {{bf_field2}}' }}"
      required
    />
  </div>

  <div class="yw-accordion yw-fb__options">
    {% embed '@core/_accordion-item.twig' with { summary: _t('FORM_EDIT_FIELD_ROLES') } %}
      {% block body %}
        <p class="yw-text-muted">{{ _t('FORM_EDIT_FIELD_ROLES_HINT') }}</p>
        {% for role in fieldRoles %}
          <div class="yw-form-group">
            <label class="yw-form-label" for="field-role-{{ role.name }}">{{ _t(role.label) }}</label>
            <select
              class="yw-input"
              id="field-role-{{ role.name }}"
              name="{{ role.property }}[{{ role.name }}]"
              data-yw-field-role="{{ role.name }}"
              data-yw-role-types="{{ role.types|join(',') }}"
              data-yw-role-current="{{ role.current }}"
            ></select>
          </div>
        {% endfor %}
      {% endblock %}
    {% endembed %}

    {% embed '@core/_accordion-item.twig' with { summary: _t('FORM_EDIT_PERMISSIONS') } %}
      {% block body %}
        {% for privilege, label in {
          read: _t('BAZ_FORM_EDIT_ACL_READ_LABEL'),
          write: _t('BAZ_FORM_EDIT_ACL_WRITE_LABEL'),
          comment: _t('BAZ_FORM_EDIT_ACL_COMMENT_LABEL'),
        } %}
          <fieldset class="yw-form-group">
            <legend class="yw-form-label">{{ label }}</legend>
            {{ include('@core/_acl-picker.twig', {
              name: 'entry_' ~ privilege ~ '_access',
              value: attribute(form, 'entry_' ~ privilege ~ '_access')|default(''),
              options: aclOptions[privilege],
            }) }}
          </fieldset>
        {% endfor %}
        <div class="yw-form-group">
          <label>
            <input type="checkbox" name="entry_permit_activate_comments" value="1" {% if form.entry_permit_activate_comments %}checked{% endif %}>
            {{ _t('BAZ_FORM_EDIT_ACL_ASK_IF_ACTIVATE_COMMENT_LABEL') }}
          </label>
        </div>
      {% endblock %}
    {% endembed %}

    {% embed '@core/_accordion-item.twig' with { summary: _t('FORM_EDIT_PRESENTATION'), attrs: 'id="entry-presentation"' } %}
      {% block body %}
        <div class="yw-fb__presentation" data-yw-presentation data-themes="{{ presentation.themes|json_encode }}" data-custom-presets="{{ presentation.customPresets|json_encode }}">
          {% set defaultTheme = presentation.current.theme ?: presentation.defaults.theme %}
          {% set theme = presentation.themes[defaultTheme] ?? { squelettes: {}, styles: {}, presets: {} } %}
          <div class="yw-form-group">
            <label class="yw-form-label" for="entry-theme">{{ _t('BAZ_FORM_EDIT_METADATA_THEME_LABEL') }}</label>
            <select class="yw-input" id="entry-theme" name="entry_metadatas[theme]" data-yw-presentation-theme>
              <option value="">{{ _t('FORM_EDIT_PRESENTATION_DEFAULT', { value: presentation.defaults.theme }) }}</option>
              {% for name in presentation.themes|keys %}
                <option value="{{ name }}"{% if name == presentation.current.theme %} selected{% endif %}>{{ name }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="yw-form-group">
            <label class="yw-form-label" for="entry-skeleton">{{ _t('BAZ_FORM_EDIT_METADATA_SQUELETON_LABEL') }}</label>
            <select class="yw-input" id="entry-skeleton" name="entry_metadatas[skeleton]" data-yw-presentation-part="squelettes">
              <option value="">{{ _t('FORM_EDIT_PRESENTATION_DEFAULT', { value: presentation.defaults.skeleton|replace({'.twig': ''}) }) }}</option>
              {% for file, label in theme.squelettes %}
                <option value="{{ file }}"{% if file == presentation.current.skeleton %} selected{% endif %}>{{ label }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="yw-form-group">
            <label class="yw-form-label" for="entry-style">{{ _t('BAZ_FORM_EDIT_METADATA_STYLE_LABEL') }}</label>
            <select class="yw-input" id="entry-style" name="entry_metadatas[style]" data-yw-presentation-part="styles">
              <option value="">{{ _t('FORM_EDIT_PRESENTATION_DEFAULT', { value: presentation.defaults.style|replace({'.css': ''}) }) }}</option>
              {% for file, label in theme.styles %}
                <option value="{{ file }}"{% if file == presentation.current.style %} selected{% endif %}>{{ label }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="yw-form-group">
            <label class="yw-form-label" for="entry-preset">{{ _t('BAZ_FORM_EDIT_METADATA_PRESET_LABEL') }}</label>
            <select class="yw-input" id="entry-preset" name="entry_metadatas[css_preset]" data-yw-presentation-part="presets">
              <option value="">{{ presentation.defaults.css_preset ? _t('FORM_EDIT_PRESENTATION_DEFAULT', { value: presentation.defaults.css_preset|replace({'.css': ''}) }) : _t('FORM_EDIT_PRESENTATION_DEFAULT_NONE') }}</option>
              {% for file, label in theme.presets %}
                <option value="{{ file }}"{% if file == presentation.current.css_preset %} selected{% endif %}>{{ label }}</option>
              {% endfor %}
              {% for file, label in presentation.customPresets %}
                <option value="{{ file }}"{% if file == presentation.current.css_preset %} selected{% endif %}>{{ label }}</option>
              {% endfor %}
            </select>
          </div>
        </div>

        {% if canEditTemplate %}
          <div class="yw-form-group yw-fb__template">
            <label class="yw-form-label" for="entry-template">{{ _t('FORM_EDIT_ENTRY_TEMPLATE') }}</label>
            <p class="yw-text-muted">{{ _t('FORM_EDIT_ENTRY_TEMPLATE_HINT', { file: entryTemplateFile }) }}</p>
            {% if not entryTemplateWritable %}
              <div class="yw-alert yw-alert--warning">{{ _t('FORM_EDIT_ENTRY_TEMPLATE_NOT_WRITABLE', { path: entryTemplateFile }) }}</div>
            {% endif %}
            <div class="yw-fb__template-actions">
              <button type="button" class="yw-btn yw-btn--sm" data-yw-fb-template-starter{% if not entryTemplateWritable %} disabled{% endif %}>
                {{ _t('FORM_EDIT_ENTRY_TEMPLATE_STARTER') }}
              </button>
            </div>
            <textarea id="entry-template" name="entry_template" class="yw-input yw-templates__editor" rows="14"
              spellcheck="false" autocomplete="off" data-yw-twig-editor{% if not entryTemplateWritable %} readonly{% endif %}>{{ entryTemplate }}</textarea>
          </div>
        {% endif %}
      {% endblock %}
    {% endembed %}

    {% if onlyOneEntryOptionAvailable %}
      {% embed '@core/_accordion-item.twig' with { summary: _t('BAZ_ONLY_ONE_ENTRY_FOR_THIS_FORM'), open: form.only_one_entry == "Y" } %}
        {% block body %}
          <div class="yw-form-group">
            <label for="only_one_entry">
              {% apply spaceless %}
                <input
                  id="only_one_entry"
                  type="checkbox"
                  value="Y"
                  name="only_one_entry"{{ form.only_one_entry == "Y" ? ' checked' : ''}}
                  onchange="document.getElementById('only_one_entry_message-group').classList.toggle('hide', !this.checked)"
                  />
                <span>{{ _t('BAZ_ONLY_ONE_ENTRY_FOR_THIS_FORM') }}</span>
              {% endapply %}
            </label>
          </div>
          <div id="only_one_entry_message-group" class="yw-form-group{{ form.only_one_entry == "Y" ? '': ' hide' }}">
            <label class="yw-form-label">
              {{ _t('BAZ_MESSAGE_IF_OTHER_ENTRY_EXIST') }}
            </label>
            <input
              class="yw-input"
              name="only_one_entry_message"
              type="text"
              value="{{ form.only_one_entry_message }}"
              placeholder="{{ _t('BAZ_FORM_DEFAULT_MESSAGE_FOR_OTHER_ENTRY_IN_FORM') }}"
            />
          </div>
        {% endblock %}
      {% endembed %}
    {% endif %}

    {% if entryOnlyPropertiesAvailable %}
      {% embed '@core/_accordion-item.twig' with { summary: _t('FORM_EDIT_CREATES_USER'), open: form.entry_creates_user is not empty } %}
        {% block body %}
          <div class="yw-form-group">
            <label>
              <input type="checkbox" id="entry-creates-user-enable" name="entry_creates_user_enable" value="1"
                {% if form.entry_creates_user %}checked{% endif %}
                onchange="document.getElementById('entry-creates-user-config').classList.toggle('hide', !this.checked)">
              {{ _t('FORM_EDIT_CREATES_USER') }}
            </label>
          </div>
          <div id="entry-creates-user-config" class="{{ form.entry_creates_user ? '' : 'hide' }}">
            <div class="yw-form-group">
              <label class="yw-form-label">{{ _t('BAZ_FORM_EDIT_USERS_WIKINI_NAME_FIELD_LABEL') }}</label>
              <input class="yw-input" name="entry_creates_user[name_field]" type="text" value="{{ form.entry_creates_user.name_field ?? 'bf_titre' }}" />
            </div>
            <div class="yw-form-group">
              <label class="yw-form-label">{{ _t('BAZ_FORM_EDIT_USERS_WIKINI_EMAIL_FIELD_LABEL') }}</label>
              <input class="yw-input" name="entry_creates_user[email_field]" type="text" value="{{ form.entry_creates_user.email_field ?? 'bf_mail' }}" />
            </div>
            <div class="yw-form-group">
              <label class="yw-form-label">{{ _t('BAZ_FORM_EDIT_ADD_TO_GROUP_LABEL') }}</label>
              <input class="yw-input" name="entry_creates_user[add_to_group]" type="text" value="{{ form.entry_creates_user.add_to_group ?? '' }}"
                placeholder="{{ _t('BAZ_FORM_EDIT_ADD_TO_GROUP_DESCRIPTION') }}" />
            </div>
            <div class="yw-form-group">
              <label>
                <input type="checkbox" name="entry_creates_user[update_email]" value="1"
                  {% if (form.entry_creates_user.update_email ?? '') in ['1', 1, true] %}checked{% endif %}>
                {{ _t('BAZ_FORM_EDIT_USERS_WIKINI_AUTOUPDATE_MAIL') }}
              </label>
            </div>
            <div class="yw-form-group">
              <label class="yw-form-label">{{ _t('BAZ_FORM_EDIT_INSCRIPTIONLISTE_MAILINGLIST') }}</label>
              <input class="yw-input" name="entry_creates_user[mailing_list]" type="text" value="{{ form.entry_creates_user.mailing_list ?? '' }}" />
            </div>
          </div>
        {% endblock %}
      {% endembed %}

      {% embed '@core/_accordion-item.twig' with { summary: _t('FORM_EDIT_BOOKMARKLET'), open: form.entry_bookmarklet is not empty } %}
        {% block body %}
          <div class="yw-form-group">
            <label>
              <input type="checkbox" id="entry-bookmarklet-enable" name="entry_bookmarklet_enable" value="1"
                {% if form.entry_bookmarklet %}checked{% endif %}
                onchange="document.getElementById('entry-bookmarklet-config').classList.toggle('hide', !this.checked)">
              {{ _t('FORM_EDIT_BOOKMARKLET') }}
            </label>
          </div>
          <div id="entry-bookmarklet-config" class="{{ form.entry_bookmarklet ? '' : 'hide' }}">
            <div class="yw-form-group">
              <label class="yw-form-label">{{ _t('BAZ_FORM_EDIT_BOOKMARKLET_URLFIELD_LABEL') }}</label>
              <input class="yw-input" name="entry_bookmarklet[url_field]" type="text" value="{{ form.entry_bookmarklet.url_field ?? 'bf_url' }}" />
            </div>
            <div class="yw-form-group">
              <label class="yw-form-label">{{ _t('BAZ_FORM_EDIT_BOOKMARKLET_DESCRIPTIONFIELD_LABEL') }}</label>
              <input class="yw-input" name="entry_bookmarklet[description_field]" type="text" value="{{ form.entry_bookmarklet.description_field ?? 'bf_description' }}" />
            </div>
            <div class="yw-form-group">
              <label class="yw-form-label">{{ _t('BAZ_FORM_EDIT_BOOKMARKLET_TEXT_LABEL') }}</label>
              <input class="yw-input" name="entry_bookmarklet[text_field]" type="text" value="{{ form.entry_bookmarklet.text_field ?? '' }}" />
            </div>
          </div>
        {% endblock %}
      {% endembed %}
    {% endif %}

    {% embed '@core/_accordion-item.twig' with { summary: _t('FORM_EDIT_ACTIVITYPUB'), open: form.activitypub_enable } %}
      {% block body %}
        <div class="yw-form-group">
          <label>
            <input type="checkbox" id="activitypub-enable" name="activitypub_enable" value="1" {% if form.activitypub_enable %}checked{% endif %}
              onchange="document.getElementById('activitypub-config').classList.toggle('hide', !this.checked)">
            {{ _t('BAZ_ACTIVITYPUB_ENABLE') }}
          </label>
        </div>
        <div id="activitypub-config" class="{{ form.activitypub_enable ? '' : 'hide' }}">
          <div class="yw-form-group">
            <label class="yw-form-label" for="activitypub-username">{{ _t('BAZ_ACTIVITYPUB_USERNAME') }}</label>
            <input
              class="yw-input"
              id="activitypub-username"
              name="activitypub_username"
              type="text"
              value="{{ form.activitypub_username }}"
            />
          </div>
          <div class="yw-form-group">
            <label class="yw-form-label" for="sem-template">{{ _t('BAZ_SEM_TEMPLATE') }}</label>
            <textarea
              class="yw-input"
              id="sem-template"
              cols="20"
              rows="6"
              name="sem_template"
            >
              {{- form.sem_template -}}
            </textarea>
          </div>
          <div class="yw-form-group">
            <label class="yw-form-label" for="sem-reverse-template">{{ _t('BAZ_SEM_REVERSE_TEMPLATE') }}</label>
            <textarea
              class="yw-input"
              id="sem-reverse-template"
              cols="20"
              rows="6"
              name="sem_reverse_template"
            >
              {{- form.sem_reverse_template -}}
            </textarea>
          </div>
        </div>
      {% endblock %}
    {% endembed %}
  </div>

  <div class="yw-form-group">
    <button type="submit" name="valider" class="yw-btn yw-btn--primary">
      {{ _t('BAZ_VALIDER') }}
    </button>
    <a class="yw-btn yw-btn--sm" href="{{ url({ params: { view: 'formulaire' }}) }}">
      {{ _t('BAZ_ANNULER') }}
    </a>
  </div>
  <div class="symbole_obligatoire">
    {{ _t('BAZ_CHAMPS_REQUIS') }}
  </div>
  {% if form %}
  <input
    type="hidden"
    name="id"
    value="{{ form.id }}"
  />
  {% endif %}
</form>
