
<div class="yw-alert yw-alert--info">
  <a
    href="javascript:var wleft = (screen.width-700)/2; var wtop=(screen.height-530)/2; window.open('{{
        url({handler:'iframe',params:{
            view: 'saisir',
            action: 'saisir_fiche',
            id: formId,
            bf_titre: "_",
            (urlField): "_",
            (descriptionField): "_"
        }})|replace({
            "bf_titre=_": "bf_titre='+escape(document.title)+'",
            (urlField~"=_"): urlField~"='+encodeURIComponent(location.href)+'",
            (descriptionField~"=_"): descriptionField~"='+encodeURIComponent(document.getSelection())+'",
        })
    }}', 'bookmarklet{{ formId }}', 'height=530,width=700,left='+wleft+',top='+wtop+',toolbar=no,location=no,directories=no,status=no,scrollbars=yes,resizable=yes,menubar=no');void 0;"
    class="yw-btn"
  >
    {{ _t('BAZ_BOOKMARKLET_LABEL', {form: formId}) }}
  </a>
  << {{ text|raw }}
</div>
