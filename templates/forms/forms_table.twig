
{% set tooltipMessage =  isWikiHibernated ? _t('WIKI_IN_HIBERNATION') : _t('BAZ_NEED_ADMIN_RIGHTS') %}

{% if message %}
<div class="yw-alert yw-alert--success">
  <a data-yw-dismiss="alert" class="yw-close" type="button">&times;</a>
  {{ _t(message) }}
</div>
{% endif %}

{% macro formsTable(id, forms, tooltipMessage, paginate) %}
  <table id="{{ id }}" class="bazar-table yw-table yw-table--fluid" data-yw-datatable
         {% if paginate %}data-yw-page-size="25"{% else %}data-yw-no-paginate data-yw-no-search{% endif %}>
    <thead>
      {# proportional, not pixel-fixed: a px column overflows at some viewport width #}
      <tr>
        <th style="width:38%">{{ _t('BAZ_FORMULAIRE') }}</th>
        <th style="width:11%">{{ _t('BAZ_ACTIONS_FICHES') }}</th>
        <th style="width:26%">{{ _t('BAZ_DATA_FORMAT') }}</th>
        <th style="width:8%">{{ _t('BAZ_ID') }}</th>
        <th style="width:17%">{{ _t('BAZ_ACTIONS') }}</th>
      </tr>
    </thead>
    <tbody>
      {% for key, form in forms %}
        {{ include('@core/forms/forms_table_row.twig', { key: key, form: form, tooltipMessage: tooltipMessage }) }}
      {% endfor %}
    </tbody>
  </table>
{% endmacro %}

{# Core's own Content types first, and apart: these describe the wiki's pages, accounts
   and files rather than data a webmaster designed. Always few, so no pagination. #}
{% if systemForms|length > 0 %}
  <h3 class="forms-table__heading">{{ _t('BAZ_SYSTEM_FORMS') }}</h3>
  <p class="forms-table__hint">{{ _t('BAZ_SYSTEM_FORMS_HINT') }}</p>
  {# no .table-responsive wrapper: a fluid table is never wider than its container, and
     the wrapper's overflow-x reports a phantom scrollbar for a fixed-layout table even
     when nothing actually sticks out (measured: no descendant crosses its right edge) #}
  {{ _self.formsTable('system-forms-table', systemForms, tooltipMessage, false) }}
{% endif %}

{% if forms|length > 0 %}
  {% if systemForms|length > 0 %}
    <h3 class="forms-table__heading">{{ _t('BAZ_USER_FORMS') }}</h3>
  {% endif %}
  {{ _self.formsTable('existing-forms-table', forms, tooltipMessage, true) }}
{% else %}
<div class="yw-alert yw-alert--info">
	<a data-yw-dismiss="alert" class="yw-close">&times;</a>{{ _t('BAZ_INTRO_AJOUT_FORMULAIRE')|raw }}
</div>
{% endif %}

{% if userIsAdmin and not isWikiHibernated %}
  <a class="yw-btn yw-btn--primary" href="{{ url({ params: { view: 'formulaire', action: 'new' }}) }}">
    {% block createformbutton %}
      <svg class="yw-icon icon-plus icon-white" aria-hidden="true"><use href="src/assets/icons.svg#plus"/></svg>
      {{ _t('BAZ_NOUVEAU_FORMULAIRE') }}
    {% endblock createformbutton %}
  </a>
{% else %}
  <button type="button" class="yw-btn yw-btn--primary" disabled="disabled" data-toggle="tooltip" data-placement="bottom" title="{{ tooltipMessage  }}">
    {{ block('createformbutton') }}
  </button>
{% endif %}
