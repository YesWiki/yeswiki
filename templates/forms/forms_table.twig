
{% set tooltipMessage =  isWikiHibernated ? _t('WIKI_IN_HIBERNATION') : _t('BAZ_NEED_ADMIN_RIGHTS') %}

{% if message %}
<div class="yw-alert yw-alert--success">
  <a data-yw-dismiss="alert" class="yw-close" type="button">&times;</a>
  {{ _t(message) }}
</div>
{% endif %}

{% if forms|length > 0 %}
<div class="table-responsive">
  <table id="existing-forms-table" class="bazar-table yw-table" data-yw-datatable>
    <thead>
      <tr>
        <th>{{ _t('BAZ_FORMULAIRE') }}</th>
        <th style="width:100px;">{{ _t('BAZ_ACTIONS_FICHES') }}</th>
        <th style="width:240px;">{{ _t('BAZ_DATA_FORMAT') }}</th>
        <th style="width:40px;">{{ _t('BAZ_ID') }}</th>
        <th style="width:100px;">{{ _t('BAZ_ACTIONS') }}</th>
      </tr>
    </thead>
    <tbody>
      {% for key, form in forms %}
        <tr>
          <td>
            <strong>{{ form.title }}</strong>
            {% if form.description %}<br />{{ form.description }}{% endif %}
          </td>
          <td>
            <a class="yw-btn yw-btn--sm" title="{{ _t('BAZ_RECHERCHER') }}" href="{{ url({ params: { vue: 'consulter', action: 'recherche', id: key }}) }}" data-toggle="tooltip" data-placement="bottom">
              <i class="fa fa-search icon-search"></i>
            </a>
            <a class="yw-btn yw-btn--sm" title="{{ _t('BAZ_SAISIR_UNE_NOUVELLE_FICHE') }}" href="{{ url({ params: { vue: 'saisir', action: 'saisir_fiche', id: key }}) }}" data-toggle="tooltip" data-placement="bottom">
              <i class="fa fa-plus icon-plus"></i>
            </a>
          </td>
          <td>
            <a class="yw-btn yw-btn--sm" title="{{ _t('BAZ_RSS') }}" href="{{ url({ handler: 'rss', params: { id: key }}) }}" data-toggle="tooltip" data-placement="bottom" >
              <i class="fa fa-signal"></i>
            </a>
            <a class="yw-btn yw-btn--sm" title="{{ _t('BAZ_CSV') }}" href="{{ url({ tag: 'api',handler:'forms/' ~ key ~'/entries/csv'}) }}" data-toggle="tooltip" data-placement="bottom">
              CSV
            </a>
            <a class="yw-btn yw-btn--sm" target="_blank" title="{{ _t('BAZ_JSON') }}" href="{{ url({ tag: 'api',handler:'forms/' ~ key ~'/entries'}) }}" data-toggle="tooltip" data-placement="bottom">
              JSON
            </a>
            {% if form.isSemantic %}
              <a class="yw-btn yw-btn--sm" target="_blank" title="{{ _t('BAZ_JSON_LD') }}" href="{{ url({ tag: 'api',handler:'forms/' ~ key ~'/entries/json-ld'}) }}" data-toggle="tooltip" data-placement="bottom">
                JSON-LD
              </a>
            {% endif %}
            {% if form.isGeo %}
              <a class="yw-btn yw-btn--sm" target="_blank" title="{{ _t('BAZ_GEOJSON') }}" href="{{ url({ tag: 'api',handler:'forms/' ~ key ~'/entries/geojson'}) }}" data-toggle="tooltip" data-placement="bottom">
                Geo
              </a>
            {% endif %}
            {% if form.isDate %}
              <a class="yw-btn yw-btn--sm" 
                target="_blank" title="{{ _t('BAZ_ICAL') }}" 
                href="{{ url({ tag: 'api',handler:'forms/' ~ key ~'/entries/ical'}) }}" 
                data-toggle="tooltip" data-placement="bottom">
                ICAL
              </a>
            {% endif %}
            {% if form.isActivityPubEnabled %}
              <a class="yw-btn yw-btn--sm" target="_blank" title="{{ _t('BAZ_ACTIVITYPUB_ACTOR') }}" href="/actors/{{ key }}" data-toggle="tooltip" data-placement="bottom">
                AP
              </a>
            {% endif %}
          </td>
          <td>
            {{ key }}
          </td>
          <td>
            <div class="create-actions">
            {% if form.canEdit %}
            <a class="yw-btn yw-btn--sm" title="{{ _t('BAZ_CLONE_FORM') }}" href="{{ url({ params: { vue: 'formulaire', action: 'clone', idformulaire: key }}) }}" data-toggle="tooltip" data-placement="bottom" >
              <i class="far fa-clone"></i>
            </a>
            {% else %}
              <button type="button" class="yw-btn yw-btn--sm" disabled="disabled" data-toggle="tooltip" data-placement="bottom" title="{{ tooltipMessage }}">
                <i class="far fa-clone"></i>
              </button>
            {% endif %}
            {% if form.canEdit %}
              <a class="yw-btn yw-btn--sm" title="{{ _t('BAZ_MODIFIER_FORMULAIRE') }}" href="{{ url({ params: { vue: 'formulaire', action: 'modif', idformulaire: key }}) }}" data-toggle="tooltip" data-placement="bottom" >
                <i class="fa fa-pencil-alt"></i>
              </a>
            {% else %}
              <button type="button" class="yw-btn yw-btn--sm" disabled="disabled" data-toggle="tooltip" data-placement="bottom" title="{{ tooltipMessage }}">
                <i class="fa fa-pencil-alt"></i>
              </button>
            {% endif %}
            {% if form.isActivityPubEnabled %}
              <a class="yw-btn yw-btn--sm" title="{{ _t('BAZ_GESTION_ABONNEMENTS') }}" href="{{ url({ params: { vue: 'abonnements', action: 'list', idformulaire: key }}) }}" data-toggle="tooltip" data-placement="bottom" >
                <i class="fa fa-user-plus"></i>
              </a>
            {% endif %}
            {% if form.bookmarklet %}
              {# entry_bookmarklet configured: the install widget lives here now, not in
                 the entry form (ticket 27, ADR-0010) #}
              <a class="yw-btn yw-btn--sm" title="{{ _t('FORM_EDIT_BOOKMARKLET') }}" data-toggle="collapse" href="#bookmarklet-{{ key }}" data-placement="bottom">
                <i class="fa fa-bookmark"></i>
              </a>
            {% endif %}
            </div>
            {% if form.bookmarklet %}
              <div id="bookmarklet-{{ key }}" class="yw-collapse">
                {{ include('@core/forms/bookmarklet-widget.twig', {
                  formId: key,
                  urlField: form.bookmarklet.url_field ?? 'bf_url',
                  descriptionField: form.bookmarklet.description_field ?? 'bf_description',
                  text: form.bookmarklet.text_field ?? '',
                }) }}
              </div>
            {% endif %}
            <div class="erase-actions">
            {% if form.canDelete %}
              <a class="yw-btn yw-btn--sm yw-btn--danger modalbox" title="{{ _t('BAZ_VIDER_FORMULAIRE') }}" href="{{ url({ params: { vue: 'formulaire', action: 'confirm_empty', idformulaire: key, voirmenu: 0 }}) }}" data-toggle="tooltip" data-placement="bottom">
                <i class="fas fa-eraser"></i>
              </a>
              <a class="yw-btn yw-btn--sm yw-btn--danger modalbox" title="{{ _t('BAZ_SUPPRIMER_FORMULAIRE') }}" href="{{ url({ params: { vue: 'formulaire', action: 'confirm_delete', idformulaire: key, voirmenu: 0 }}) }}" data-toggle="tooltip" data-placement="bottom">
                <i class="fa fa-trash"></i>
              </a>
            {% else %}
              <button type="button" class="yw-btn yw-btn--sm yw-btn--danger" disabled="disabled" data-toggle="tooltip" data-placement="bottom" title="{{ tooltipMessage }}">
                <i class="fas fa-eraser"></i>
              </button>
              <button type="button" class="yw-btn yw-btn--sm yw-btn--danger" disabled="disabled" data-toggle="tooltip" data-placement="bottom" title="{{ tooltipMessage }}">
                <i class="fa fa-trash"></i>
              </button>
            {% endif %}
            </div>
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div> <!-- /.table-responsive -->
{% else %}
<div class="yw-alert yw-alert--info">
	<a data-yw-dismiss="alert" class="yw-close">&times;</a>{{ _t('BAZ_INTRO_AJOUT_FORMULAIRE')|raw }}
</div>
{% endif %}

{% if userIsAdmin and not isWikiHibernated %}
  <a class="yw-btn yw-btn--primary" href="{{ url({ params: { vue: 'formulaire', action: 'new' }}) }}">
    {% block createformbutton %}
      <i class="fa fa-plus icon-plus icon-white"></i>
      {{ _t('BAZ_NOUVEAU_FORMULAIRE') }}
    {% endblock createformbutton %}
  </a>
{% else %}
  <button type="button" class="yw-btn yw-btn--primary" disabled="disabled" data-toggle="tooltip" data-placement="bottom" title="{{ tooltipMessage  }}">
    {{ block('createformbutton') }}
  </button>
{% endif %}


