{% extends "@core/layouts/field.twig" %}

{% block value_container %}
	<div class="BAZ_texte">
		{% if entryDisplay|default('') in ['newtab', 'direct'] %}
		<a href="{{ entryUrl|e }}"
			{{ entryDisplay == 'newtab' ? 'target="_blank" rel="noopener"' : '' }}
			title="{{ _t('BAZ_SEE_ENTRY') }} {{ label|striptags }}">
				{{- label|raw -}}
		</a>
		{% else %}
		<a href="{{ entryUrl|e ~ '/iframe' }}"
			{{ not isInIframe ? 'class="modalbox" data-size="modal-lg"' : '' }}
			data-header="false" data-iframe="1"
			title="{{ _t('BAZ_SEE_ENTRY') }} {{ label|striptags }}">
				{{- label|raw -}}
		</a>
		{% endif %}
	</div>
{% endblock %}
