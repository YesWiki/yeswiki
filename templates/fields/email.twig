{% extends "@core/layouts/field.twig" %}

{% block value %}
    {% if field.showContactForm %}

        <a class="yw-btn modalbox" title="{{ _t('BAZ_CONTACT_BY_MAIL') }}"
           href="{{ url({tag: 'api/contact/form', params: {pageTag: pageTag, field: field.propertyName}}) }}">
            <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#mail"/></svg> {{ _t('BAZ_CONTACT_BY_MAIL') }}
        </a>
    {% else %}
        <a href="mailto:{{ value }}" class="BAZ_lien_mail">{{ value }}</a></span>
    {% endif %}
{% endblock %}
