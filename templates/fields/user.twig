{% extends "@core/layouts/field.twig" %}

{% block label %}{{ _t('BAZ_GIVEN_ID') }}{% endblock %}

{% block value %}
    {{ value }}
    {% if isLoggedUser %}
        <a class="btn btn-xs btn-default" href="{{ editUrl }}">
            <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#pencil"/></svg>{{ _t('BAZ_EDIT_MY_ENTRY') }}
        </a>
        <a  class="btn btn-xs btn-default" href="{{ settingsUrl }}">
            <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#lock"/></svg>{{ _t('BAZ_CHANGE_PWD') }}
        </a>
    {% endif %}
{% endblock %}
