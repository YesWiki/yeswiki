{% extends "@core/layouts/field.twig" %}

{% block label %}{{ field.readLabel|replace({'{filename}':shortFileName}) }}{% endblock %}

{% block value %}
    <a class="yw-btn yw-btn--primary"
            href="{{ fileUrl }}"
            title="{{ _t('BAZ_DOWNLOAD_FILE') ~ ' ' ~ shortFileName}}"
            data-toggle="tooltip"
            data-placement="right"
            {% if isUrl|default(false) %}
                target="_blank"
            {% else %}
                download{{ shortFileName ? '='~ shortFileName  : ''}}
            {% endif %}>
        {% if isUrl|default(false) %}
            <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#external-link"/></svg> {{ _t('BAZ_OPEN_LINK') }}
        {% else %}
            {{ _t('TAGS_DOWNLOAD') }}
        {% endif %}
    </a>
{% endblock %}
