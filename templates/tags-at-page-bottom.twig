{% if tags|length > 0 %}
  <div class="page-tags">
    <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#tags"/></svg>
    {% for tag in tags|sort %}
      <a class="tag-label label label-info"
        href="{{ url({tag:'search',params:{tags: tag}}) }}"
        title="{{ _t('TAGS_SEE_ALL_PAGES_WITH_THIS_TAGS') }}"
        >{{- tag -}}</a>
    {% endfor %}
  </div>
{% endif %}
