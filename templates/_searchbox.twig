
{% set name = name|default('phrase') %}
{% set placeholder = placeholder|default(_t('TEMPLATE_SEARCH_PLACEHOLDER')) %}
{% set button = button is defined ? button : _t('SEARCH') %}
<div class="yw-searchbox {{ modifier|default('') }}">
    <span class="yw-searchbox__icon">{{ icon('loupe') }}</span>
    <input type="search"
           name="{{ name }}"
           {% if id is defined and id %}id="{{ id }}"{% endif %}
           class="yw-searchbox__input"
           value="{{ value|default('') }}"
           placeholder="{{ placeholder }}"
           aria-label="{{ placeholder }}"
           autocomplete="off"
           accesskey="C"
           {% if autofocus|default(false) %}autofocus data-yw-autofocus{% endif %}
           {% for attribute, attributeValue in attrs|default({}) %}{{ attribute }}="{{ attributeValue }}" {% endfor %} />
    {% if button is not empty %}
        <button type="submit"
                class="yw-searchbox__button"
                {% for attribute, attributeValue in button_attrs|default({}) %}{{ attribute }}="{{ attributeValue }}" {% endfor %}>
            {% if spinner_id is defined and spinner_id %}

                <span id="{{ spinner_id }}" class="htmx-indicator yw-searchbox__spinner" aria-hidden="true">
                    {{ icon('loader-2') }}
                </span>
            {% endif %}
            <span class="yw-searchbox__button-label">{{ button }}</span>
        </button>
    {% endif %}
</div>
