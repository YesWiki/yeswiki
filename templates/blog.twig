{{ include_css('styles/yw-blog.css') }}
{{ include_javascript('javascripts/relative-time.js') }}
{% set withLead = ((params.header ?? 'true') ~ '')|lower in ['true', '1'] %}
{% set showAuthor = ((params.show_author ?? '1') ~ '') != '0' %}
{% set showDate = ((params.show_date ?? '1') ~ '') != '0' %}

{% macro meta(entry, showDate, showAuthor) %}
  {% set author = entry.origin.author ?? {} %}
  {% if (showDate and entry.created_at is not empty) or (showAuthor and author.name is not empty) %}
    <p class="blog-entry__meta">
      {% if showDate and entry.created_at is not empty %}
        {% set time %}<time class="yw-relative-time" datetime="{{ entry.created_at|date('c') }}">{{ entry.created_at|date('d/m/Y H:i') }}</time>{% endset %}
        {% if entry.origin.generatedTitle ?? false %}
          <a class="blog-entry__permalink" href="{{ entry.url }}">{{ time }}</a>
        {% else %}
          {{ time }}
        {% endif %}
      {% endif %}
      {% if showAuthor and author.name is not empty %}
        {% if author.url %}
          <a class="blog-entry__author" href="{{ author.url }}" title="{{ author.handle }}" rel="nofollow noopener">{{ author.name }}</a>
        {% else %}
          <span class="blog-entry__author">{{ author.name }}</span>
        {% endif %}
      {% endif %}
    </p>
  {% endif %}
{% endmacro %}

{% import _self as blog %}
{% if entries|length > 0 %}
  {% set leadEntry = withLead ? (entries|filter(entry => entry.imagebf_image is not empty)|first ?: entries|first) : null %}
  {% set ordered = leadEntry ? [leadEntry]|merge(entries|filter(entry => entry.tag != leadEntry.tag)) : entries %}
  <div class="blog-entries">
    {% for entry in ordered %}
      {% set isLead = leadEntry and loop.first %}
      {% set summary = entry.bf_chapeau ?? entry.soustitre ?? '' %}
      {% set warning = entry.bf_avertissement ?? '' %}
      {% set generatedTitle = entry.origin.generatedTitle ?? false %}
      {% set width = isLead ? 650 : 340 %}
      {% set height = isLead ? 416 : 212 %}
      {% set file = entry.imagebf_image ?? '' %}
      {% set src = '' %}
      {% if file is empty %}
      {% elseif entry['external-data'] is defined %}
        {% set src = entry['external-data'].baseUrl ~ 'files/' ~ file %}
      {% elseif file matches '#^(https?:)?//#i' %}
        {% set src = image_at(file, width, height) %}
      {% elseif fileExists('files/' ~ file) %}
        {% set src = resizedImage(file, width, height, 'crop') %}
      {% endif %}
      <article class="blog-entry bazar-entry{{ isLead ? ' blog-entry--lead' }}{{ src is empty ? ' blog-entry--no-media' }}{{ warning is not empty ? ' blog-entry--warned' }}" {{ entry.html_data|raw }}>
        {% if src is not empty %}
          <a class="blog-entry__media" href="{{ entry.url }}" tabindex="-1" aria-hidden="true">
            <img loading="lazy" alt="" src="{{ src }}" width="{{ width }}" height="{{ height }}">
          </a>
        {% endif %}
        <div class="blog-entry__body">
          {% set content %}
            {% if generatedTitle %}
              <div class="blog-entry__text">{{ format(summary is not empty ? summary : (entry.bf_description ?? ''))|raw }}</div>
            {% else %}
              <h3 class="blog-entry__title"><a href="{{ entry.url }}">{{ entry.title }}</a></h3>
            {% endif %}
            {% if isLead and summary is not empty and not generatedTitle %}
              {% set text = format(summary)|striptags|trim %}
              <p class="blog-entry__summary">{{ (text|length > 280 ? text|slice(0, 280)|split(' ')|slice(0, -1)|join(' ') ~ '…' : text)|raw }}</p>
            {% endif %}
          {% endset %}
          {% if warning is not empty %}
            <details class="blog-entry__warning">
              <summary class="blog-entry__warning-label">
                <span class="blog-entry__warning-text">{{ warning|striptags|raw }}</span>
                <span class="blog-entry__warning-toggle" data-show="{{ _t('BAZ_BLOG_SHOW_WARNED') }}" data-hide="{{ _t('BAZ_BLOG_HIDE_WARNED') }}"></span>
              </summary>
              {{ content }}
            </details>
          {% else %}
            {{ content }}
          {% endif %}
          {{ blog.meta(entry, showDate, showAuthor) }}
        </div>
      </article>
    {% endfor %}
  </div>
{% endif %}
{{ pager_links|raw }}
