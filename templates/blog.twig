{% set premier = params.header|default('true') in ['true', '1'] or params.header|default('true') == 1 %}
{% set showauthor = params.show_author|default('') == '1' %}
{% set showdate = params.show_date|default('') == '1' %}
{% set columns = params.columns|default('') %}
{% set columns = columns in ['1', '2', '3', '4'] ? columns : 1 %}
{% import "@core/bazar/entry-decoration-macro.twig" as decoration %}
{% if entries|length > 0 %}
<div class="cols{{ columns }}">
    {% for entry in entries %}
    {% set soustitre = (entry.soustitre is defined and entry.soustitre is not empty)
        ? format(entry.soustitre)|striptags('<br>')|nl2br : '' %}
	    {% if premier %}{% set premier = false %}
		    <div class="well bazar-entry" {{ entry.html_data|raw }}>
				{% if entry.imagebf_image is defined and entry.imagebf_image is not empty and (fileExists('files/' ~ entry.imagebf_image) or entry['external-data'] is defined) %}
					<a class="pull-right" style="margin:0 0 1em 1em;" href="{{ entry.url|raw }}">
					<img loading="lazy" class="img-blog" alt="{{ entry.title|striptags }}"
						src="{{ entry['external-data'] is defined
						? entry['external-data'].baseUrl ~ 'cache/image_400_300_' ~ entry.imagebf_image
						: resizedImage(entry.imagebf_image, 400, 300, 'crop', '_') }}" {{ entry['external-data'] is defined
						? 'onerror="this.src=\'' ~ entry['external-data'].baseUrl ~ 'files/' ~ entry.imagebf_image ~ '\'"style="max-width:400px;max-height:300px;"'
						: '' }}>
					</a>
				{% endif %}	  
				<h2 style="margin-top:0;margin-bottom:.25em;">
					<a href="{{ entry.url|raw }}">
						{{ entry.title|raw }}
					</a>
				</h2>
				{% if showdate %}
				<small>
					<a href="{{ entry.url|raw }}/revisions">
						<svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#calendar-event"/></svg>
					</a>
					&nbsp;{{ entry.updated_at|date('d.m.Y') }}
				</small>
				{% endif %}
				{% if showauthor %}
					<small>par {% if entry['external-data'] is defined %}<a href="{{ entry['external-data'].baseUrl }}?{{ entry.owner }}">{{ entry.owner }}</a>{% else %}{{ format(entry.owner)|raw }}{% endif %}</small>
				{% endif %}

        {% if soustitre is not empty %}
          <p class='lead text-justify'>
            {{ (soustitre|slice(0, 280) ~ (soustitre|length > 280 ? '...' : ''))|raw }}
          </p>
        {% endif %}
				<p class="lead">
					<a href="{{ entry.url|raw }}">{{ _t('BAZ_MORE_INFOS') }}...</a>
				</p>
				<div class="clearfix"></div>
			</div>
		{% else %}
			<div class="article bazar-entry" {{ entry.html_data|raw }}>
				{% if entry.imagebf_image is defined and entry.imagebf_image is not empty and (fileExists('files/' ~ entry.imagebf_image) or entry['external-data'] is defined) %}
					<a class="pull-left" style="margin:0 1em 1em 0;" href="{{ entry.url|raw }}">
					<img loading="lazy" class="img-blog" alt="{{ entry.title|striptags }}"
						src="{{ entry['external-data'] is defined
						? entry['external-data'].baseUrl ~ 'cache/image_200_150_' ~ entry.imagebf_image
						: resizedImage(entry.imagebf_image, 200, 150, 'crop', '_') }}"{{ entry['external-data'] is defined
						? 'onerror="this.src=\'' ~ entry['external-data'].baseUrl ~ 'files/' ~ entry.imagebf_image ~ '\'"style="max-width:200px;max-height:150px;"'
						: '' }}>
					</a>
				{% endif %}	  
				<h4 class="title-article">
					<a href="{{ entry.url|raw }}">
						{{ entry.title|raw }}
					</a>
				</h4>
				{% if showdate %}
				<small>
					<a href="{{ entry.url|raw }}/revisions">
						<svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#calendar-event"/></svg>
					</a>
					&nbsp;{{ entry.updated_at|date('d.m.Y') }}
				</small>
				{% endif %}
				{% if showauthor %}
					<small>par {% if entry['external-data'] is defined %}<a href="{{ entry['external-data'].baseUrl }}?{{ entry.owner }}">{{ entry.owner }}</a>{% else %}{{ format(entry.owner)|raw }}{% endif %}</small>
				{% endif %}
        {% if soustitre is not empty %}
          <p class='desc text-justify'>
            {{ (soustitre|slice(0, 280) ~ (soustitre|length > 280 ? '...' : ''))|raw }}
          </p>
        {% endif %}
				<a class="link-more" href="{{ entry.url|raw }}">{{ _t('BAZ_MORE_INFOS') }}...</a>
				<div class="clearfix"></div>
			</div>
		{% endif %}
	{% endfor %}
</div>
{% endif %}
{{ pager_links|raw }}
