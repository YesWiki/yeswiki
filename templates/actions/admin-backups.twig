{{ include_javascript('javascripts/actions/admin-backups.js', false, true) }}
{{ include_css('styles/yw-admin.css') }}

<div class="admin-backups admin-backups-container no-dblclick">
  <h1>{{ _t('ADMIN_BACKUPS_TITLE') }}</h1>
  <div class="alert {{ schedule and schedule.failed ? 'alert-danger' : 'alert-info' }} admin-backups-schedule">
    {% if schedule %}
      {{ _t('ADMIN_BACKUPS_SCHEDULED_ON', {type: _t(schedule.type == 'full' ? 'ADMIN_BACKUPS_ARCHIVE_TYPE_FULL' : 'ADMIN_BACKUPS_ARCHIVE_TYPE_ONLY_DATABASES'), keep: schedule.keep}) }}
      {% if schedule.last %}{{ _t('ADMIN_BACKUPS_SCHEDULED_LAST', {when: schedule.last, status: schedule.status}) }}{% else %}{{ _t('ADMIN_BACKUPS_SCHEDULED_NEVER') }}{% endif %}
      {% if schedule.failed and schedule.error %}<br><strong>{{ schedule.error }}</strong>{% endif %}
      {% if schedule.next %}<br>{{ _t('ADMIN_BACKUPS_SCHEDULED_NEXT', {when: schedule.next}) }}{% endif %}
    {% else %}
      {{ _t('ADMIN_BACKUPS_SCHEDULED_OFF') }}
    {% endif %}
  </div>
  <div class="well">{{ archive|raw }}</div>
  <div class="well">{{ remote|raw }}</div>
  <div id="backups-restore"></div>
  {{ list|raw }}
</div>
