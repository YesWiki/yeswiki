

<table class="yw-table table-updates" data-yw-datatable>
  <thead>
    <tr>
        <th>{{ _t('AU_NAME') }}</th>
        <th>{{ _t('AU_INSTALLED_REVISION') }}</th>
        <th>{{ _t('AU_AVAILABLE_REVISION') }}</th>
        <th></th>
        <th></th>
    </tr>
  </thead>
  <tbody>
      {% for ext in exts %}
        <tr>
            <td>
                <strong>{{ ext.name }}</strong>
                <a class="small" href="{{ ext.documentation }}">
                    ({{ _t('AU_DOCUMENTATION_LINK') }})
                </a>
                <br />
                <small>{{ ext.description }}</small>
            </td>
            <td>
                {% if ext.installed %}
                    {{ ext.localRelease }}
                {% else %}
                    {{ _t('AU_ABSENT') }}
                {% endif %}
            </td>
            <td>
                {{ ext.release }}
            </td>
            <td>
                {% if isAdmin and ext.updateAvailable and ext.installed %}
                    {% if canTriggerExtensionUpdate %}
                        {% include '@core/update-action-button.twig' with {
                            params: {action: 'upgrade', package: ext.updateLink},
                            buttonClass: 'yw-btn yw-btn--sm yw-btn--primary',
                            label: _t('AU_UPDATE')
                        } only %}
                    {% else %}
                        <button disabled
                            class="yw-btn yw-btn--sm yw-btn--primary"
                            title="{{ extensionBlockedReason }}"
                            data-toggle="tooltip"
                            data-placement="bottom"
                        >
                            {{ _t('AU_UPDATE') }}
                        </button>
                    {% endif %}
                {% endif %}

            </td>
            <td>
                {% if isAdmin and not ext.installed %}
                    {% if canTriggerExtensionUpdate %}
                        {% include '@core/update-action-button.twig' with {
                            params: {action: 'upgrade', package: ext.updateLink},
                            buttonClass: 'yw-btn yw-btn--sm yw-btn--primary',
                            label: _t('AU_INSTALL')
                        } only %}
                    {% else %}
                        <button disabled
                            class="yw-btn yw-btn--sm yw-btn--primary"
                            title="{{ extensionBlockedReason }}"
                            data-toggle="tooltip"
                            data-placement="bottom"
                        >
                            {{ _t('AU_INSTALL') }}
                        </button>
                    {% endif %}
                {% endif %}

                {% if isAdmin and ext.installed and ext.name != 'autoupdate' %}
                    {% if canTriggerExtensionUpdate %}
                        {% include '@core/update-action-button.twig' with {
                            params: {action: 'delete', package: ext.deleteLink|split('delete=')|slice(1,1)|first},
                            buttonClass: 'yw-btn yw-btn--sm yw-btn--danger',
                            label: _t('AU_DELETE_EXT')
                        } only %}
                    {% else %}
                        <button disabled
                            class="yw-btn yw-btn--sm yw-btn--danger"
                            title="{{ extensionBlockedReason }}"
                            data-toggle="tooltip"
                            data-placement="bottom"
                        >
                            {{ _t('AU_DELETE_EXT') }}
                        </button>
                    {% endif %}
                {% endif %}
            </td>
        </tr>
    {% endfor %}
    </tbody>
</table>
