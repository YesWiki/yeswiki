{% if field.autocomplete is not empty %}
    <script>
        var autocompleteFieldnames = {
            postalCode: "{{ field.autocomplete|split(',')|first }}",
            town: "{{ field.autocomplete|split(',')[1:1]|first }}"
        }
    </script>
    {{ include_javascript('javascripts/inputs/map-autocomplete.js') }}
{% endif %}

{{ include_css('styles/vendor/leaflet/leaflet.css') }}
{{ include_javascript('javascripts/inputs/map-geolocation-helper.js') }}
{{ include_javascript('javascripts/vendor/leaflet/leaflet.min.js') }}
{{ include_javascript('javascripts/vendor/leaflet-providers/leaflet-providers.js') }}
{% if mapFieldData.hasGeometries %}
    {{ include_javascript('javascripts/vendor/leaflet-draw/leaflet.draw.js') }}
    {{ include_css('styles/vendor/leaflet-draw/leaflet.draw.css') }}
{% endif %}

{{ include_javascript('javascripts/inputs/map-leaflet.js', false, true) }}

<div class="yw-form-group geocode-input {% if field.required %}required{% endif %}" id="{{ field.name }}" name="{{ field.name }}" data-field-names="{{ field.autocompleteFieldNames|json_encode }}" data-map-field-data="{{ mapFieldData|json_encode|e('html_attr') }}">
    <label class="col-sm-3"></label>
    <div class="controls">
        {% if field.geolocate %}
            <a class="yw-btn yw-btn--primary btn-geolocate">
                {{ _t('BAZ_GEOLOCATE') }}
            </a>
        {% endif %}
        {% if 'marker' in mapFieldData.chosenGeometries %}
        <a class="yw-btn yw-btn--primary btn-geolocate-address">
            {{ _t('BAZ_VERIFIER_MON_ADRESSE') }}
        </a>
        {% endif %}
        <a class="yw-btn yw-btn--primary btn-move-to-address">
            {{ _t('BAZ_MOVE_TO_ADDRESS') }}
        </a>
        <input type="hidden" id="{{field.name}}_latitude" value="{{ latitude }}" class="yw-latitude-input" name="{{field.name}}[latitude]" />
        <input type="hidden" id="{{field.name}}_longitude" value="{{ longitude }}" class="yw-longitude-input" name="{{field.name}}[longitude]]" />
        <input type="hidden" id="{{field.name}}_geometries" value="{{ geometries ? geometries |json_encode : '' }}" class="yw-geometries-input" name="{{field.name}}[geometries]" />
        <div id="osmmapform" class="yw-geolocation-map" style="margin-top:5px; width:{{ config.baz_map_width }}; height:{{ config.baz_map_height }};"></div>
    </div>
</div>
