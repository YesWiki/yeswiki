{% embed "@core/layouts/input.twig" %}
    {% block input %}
        {{ include_css('styles/yw-entries.css') }}

        <div class="input-prepend input-group">
            <span class="add-on input-group-addon">
                <svg class="yw-icon icon-calendar" aria-hidden="true"><use href="src/assets/icons.svg#calendar"/></svg>
            </span>
            <input
                type="date"
                value="{{ day }}"
                id="{{ field.name }}"
                name="{{ field.name }}"
                class="yw-input bazar-date"
                {% if field.required %}required{% endif %}
            />
            <select class="yw-input select-allday" name="{{ field.name }}_allday">
                <option value="1" {% if not hasTime %} selected {% endif %}>{{  _t('BAZ_ALL_DAY') }}</option>
                <option value="0" {% if hasTime %} selected {% endif %}>{{ _t('BAZ_ENTER_HOUR') }}</option>
            </select>
        </div>
        <div class="select-time {% if not hasTime %}hide{% endif %} input-prepend input-group">
            <span class="add-on input-group-addon">
                <svg class="yw-icon icon-time" aria-hidden="true"><use href="src/assets/icons.svg#clock"/></svg>
            </span>
            <select class="yw-input select-hour" name="{{ field.name }}_hour">
                {% for i in range(low=0, high=23, step=1) %}
                    <option value="{{ '%02d'|format(i) }}" {% if( i == hour ) %} selected {% endif %}>{{ '%02d'|format(i) }}</option>
                {% endfor %}
            </select>
            <select class="yw-input select-minutes" name="{{ field.name }}_minutes">
                {% for i in range(low=0, high=55, step=5) %}
                    <option value="{{ '%02d'|format(i) }}" {% if( i == minute ) %} selected {% endif %}>{{ '%02d'|format(i) }}</option>
                {% endfor %}
            </select>
        </div>
    {% endblock input %}
{% endembed %}

{{ include("@core/inputs/_date_recurrent_part.twig") }}