{% extends "@core/layouts/input.twig" %}

{% block groupClass %}opening-hours{% endblock %}

{% macro interval(interval, days, removeLabels) %}
  <div class="opening-hours-interval" data-opening-hours-interval>
    <select multiple class="yw-input" title="{{ _t('BAZ_OPENING_HOURS_HELP_DAY') }}" aria-label="{{ _t('BAZ_OPENING_HOURS_HELP_DAY') }}">
      {% for code, name in days %}
        <option value="{{ code }}" {{ code in interval.days ? 'selected' : '' }}>{{ name }}</option>
      {% endfor %}
    </select>
    <div class="opening-hours-block-hours">
      <div class="opening-hours-hours">
        {% for hour in interval.hours %}
          {{ _self.hour(hour) }}
        {% endfor %}
      </div>
      <button type="button" class="btn btn-default btn-xs" data-opening-hours-add-hour title="{{ _t('BAZ_OPENING_HOURS_ADD_HOUR') }}" aria-label="{{ _t('BAZ_OPENING_HOURS_ADD_HOUR') }}">{{ icon('circle-plus') }}</button>
    </div>
    <button type="button" class="btn btn-danger" data-opening-hours-remove-day title="{{ _t('BAZ_OPENING_HOURS_REMOVE_DAY') }}" aria-label="{{ _t('BAZ_OPENING_HOURS_REMOVE_DAY') }}" style="margin-left: auto;">{{ icon('trash') }}</button>
  </div>
{% endmacro %}

{% macro hour(hour) %}
  <div class="opening-hours-hour" data-opening-hours-hour>
    <input type="time" class="yw-input" value="{{ hour.start }}" data-opening-hours-start aria-label="{{ _t('BAZ_OPENING_HOURS_START') }}">
    <input type="time" class="yw-input" value="{{ hour.end }}" data-opening-hours-end aria-label="{{ _t('BAZ_OPENING_HOURS_END') }}">
    <button type="button" class="btn btn-default btn-xs" data-opening-hours-remove-hour title="{{ _t('BAZ_OPENING_HOURS_REMOVE_HOUR') }}" aria-label="{{ _t('BAZ_OPENING_HOURS_REMOVE_HOUR') }}">{{ icon('trash') }}</button>
  </div>
{% endmacro %}

{% block input %}
  <div class="opening-hours-create" data-opening-hours-editor>
    <div data-opening-hours-intervals>
      {% for interval in intervals %}
        {{ _self.interval(interval, days) }}
      {% endfor %}
    </div>
    <template data-opening-hours-interval-template>{{ _self.interval({ days: [], hours: [{ start: '', end: '' }] }, days) }}</template>
    <template data-opening-hours-hour-template>{{ _self.hour({ start: '', end: '' }) }}</template>
    <button type="button" class="btn btn-info btn-block" data-opening-hours-add-day>
      {{ icon('circle-plus') }} {{ _t('BAZ_OPENING_HOURS_ADD_DAY') }}
    </button>
    <input type="hidden" name="{{ field.name }}" value="{{ opening_hours }}" data-opening-hours-value>
  </div>
{% endblock %}
