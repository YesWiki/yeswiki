{% extends "@core/layouts/input.twig" %}

{% set placeholder = field.placeholder|default(field.label)|striptags|trim %}

{% block groupClass %}
	{{ field.syntax }}
{% endblock %}

{% block label %}
	{% if field.required %}
		<span class="symbole_obligatoire"></span>
	{% endif %}
	{% if field.hint %}
		<span class="tooltip_aide" tabindex="0" role="img" aria-label="{{ field.hint|striptags }}" data-yw-tooltip="{{ field.hint|striptags }}">{{ icon('help-circle') }}</span>
	{% endif %}
	{{ field.label|raw }}
	{% if field.maxChars and (field.syntax == 'nohtml' or field.syntax == 'wiki-textarea') %}(<span class="charsRemaining">{{ field.maxChars }}</span>
		caractères restants)
	{% endif %}
{% endblock %}

{% block input %}
	{{ include_css('styles/yw-editor.css') }}

	<div id="{{ field.name ~ 'Container' }}">
		{% if field.syntax == 'wiki-textarea' %}
			{{ renderAction(
              'aceditor',
              { 
                name: field.name,
                value: value,
                rows: field.numRows,
                maxChars: field.maxChars,
                placeholder: placeholder,
                required: field.required,
                tempTag: tempTag
              }
            )|raw }}
        {% else %}
            <textarea
                id="{{ field.name }}"
                name="{{ field.name }}"
                class="yw-input {% if field.syntax == 'html' %}vditor-html{% else %}{{ field.syntax }}{% endif %}"
                {% if field.syntax == 'html' %}data-vditor-lang="{{ vditorLang }}"{% endif %}
                rows="{{ field.numRows }}"
                {% if field.size %} cols="{{ field.size }}" {% endif %}
                {% if field.maxChars %} maxlength="{{ field.maxChars }}" {% endif %}
                placeholder="{{ placeholder }}"
                {% if field.required %} required {% endif %}
            >
                {{- value -}}
            </textarea>
        {% endif %}
    </div>
{% endblock %}
