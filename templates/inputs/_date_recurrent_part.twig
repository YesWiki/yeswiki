{% if field.propertyname == 'bf_date_fin_evenement' and canRegisterMultipleEntries %}
  {% set p = field.propertyName %}
  {% set legacyParent = data is not iterable and data matches '/^\\{"recurrentParentId":"[^"]+"}$/' ? data|split('"')[3] : '' %}
  {% set rule = data is iterable ? data : {} %}
  {% set kind = rule.repetition|default('') in ['d', 'w', 'm', 'y'] and rule.isRecurrent|default('') == '1' ? rule.repetition : '' %}
  {% set step = rule.step|default(2) %}
  {% set custom = rule.repetition|default('') != '' and step > 1 %}
  {% set chosen = kind == '' ? '' : (step == 1 ? kind : 'x' ~ kind) %}
  {% set days = rule.days is defined and rule.days is iterable ? rule.days : ['mon'] %}
  {% set when = rule.whenInMonth|default('') %}
  {% set weekdays = { mon: 'BAZ_LUNDI', tue: 'BAZ_MARDI', wed: 'BAZ_MERCREDI', thu: 'BAZ_JEUDI', fri: 'BAZ_VENDREDI', sat: 'BAZ_SAMEDI', sun: 'BAZ_DIMANCHE' } %}
  {% set months = { jan: 'BAZ_JANVIER', feb: 'BAZ_FEVRIER', mar: 'BAZ_MARS', apr: 'BAZ_AVRIL', may: 'BAZ_MAI', jun: 'BAZ_JUIN', jul: 'BAZ_JUILLET', aug: 'BAZ_AOUT', sep: 'BAZ_SEPTEMBRE', oct: 'BAZ_OCTOBRE', nov: 'BAZ_NOVEMBRE', dec: 'BAZ_DECEMBRE' } %}
  {% set stepInput = '<input type="number" min="2" class="yw-input recurrence__step" name="' ~ p ~ '_data[other][step]" value="' ~ (step > 1 ? step : 2) ~ '" required>' %}

  {% embed "@core/layouts/input.twig" with {
    field: { name: field.name, label: _t('EVENT_RECURRENT'), propertyName: p, type: 'recur-date' }
  } %}
    {% block input %}
      {{ include_javascript('javascripts/services/recurrence-calculator.js') }}
      {{ include_javascript('javascripts/inputs/recurrent-event.js', false, true) }}

      <div class="recurrence" data-recurrence data-field="{{ p }}" data-limit-date="{{ rule.limitdate|default('') }}">
        <div class="input-group specific-for-recurrence">
          <span class="add-on input-group-addon" title="{{ _t('EVENTS_REPETITIONS') }}">{{ icon('arrow-forward-up') }}</span>
          <select class="yw-input select-allday" name="{{ p }}_data[other][repetition]" data-recurrence-repetition aria-label="{{ _t('EVENTS_REPETITIONS') }}">
            <option value="">{{ _t('EVENT_NO_REPETITION') }}</option>
            {% for code, unit in { d: 'DAYS', w: 'WEEKS', m: 'MONTHS', y: 'YEARS' } %}
              <option value="{{ code }}" {{ chosen == code ? 'selected' : '' }}>{{ _t('EVENT_EVERY_' ~ unit) }}</option>
              <option value="x{{ code }}" data-recurrence-custom {{ custom ? '' : 'hidden disabled' }} {{ chosen == 'x' ~ code ? 'selected' : '' }}>{{ _t('EVENT_EVERY_X_' ~ unit) }}</option>
            {% endfor %}
            <option value="removeCustom" data-recurrence-custom {{ custom ? '' : 'hidden disabled' }}>{{ _t('EVENT_REMOVE_CUSTOM') }}</option>
            <option value="activateCustom" data-recurrence-plain {{ custom ? 'hidden disabled' : '' }}>{{ _t('EVENT_ACTIVATE_CUSTOM') }}</option>
          </select>
        </div>

        <fieldset class="recurrence__rule" data-recurrence-rule {{ kind == '' ? 'disabled hidden' : '' }}>
          <input type="hidden" name="{{ p }}_data[isRecurrent]" value="1">
          <input type="hidden" name="{{ p }}_data[nbmax]" value="{{ rule.nbmax|default(600) }}" data-recurrence-nbmax>
          <input type="hidden" name="{{ p }}_data[repetition]" value="{{ kind }}" data-recurrence-kind>
          <input type="hidden" name="{{ p }}_data[step]" value="{{ step }}" data-recurrence-step>

          <div class="event-container-for-datepicker">
            <div class="input-prepend input-group specific-for-recurrence">
              <span class="add-on input-group-addon">{{ _t('EVENT_UP_TO_DATE') }}</span>
              <span class="add-on input-group-addon">{{ icon('calendar', 'icon-calendar') }}</span>
              <input type="date" value="{{ rule.limitdate|default('') }}" name="{{ p }}_data[limitdate]" class="yw-input bazar-date" data-recurrence-limit required aria-label="{{ _t('EVENT_UP_TO_DATE') }}">
            </div>
            <i class="limit-date-hint" data-recurrence-limit-hint hidden>{{ _t('EVENT_LIMIT_DATE_UPDATE_FORCED') }}</i>
          </div>

          <div class="input-prepend input-group specific-for-recurrence">
            <div class="yw-input for-selector-is-recurrent">
              {% for code in ['d', 'w', 'm', 'y'] %}
                <fieldset data-recurrence-when="x{{ code }}" {{ chosen == 'x' ~ code ? '' : 'disabled hidden' }}>
                  <span>{{ _t('EVENT_EVERY_X_' ~ { d: 'DAYS', w: 'WEEKS', m: 'MONTHS', y: 'YEARS' }[code])|replace({ X: stepInput })|raw }}</span>
                </fieldset>
              {% endfor %}

              <fieldset class="input-prepend input-group" data-recurrence-when="y" {{ kind == 'y' ? '' : 'disabled hidden' }}>
                <span class="add-on input-group-addon">{{ _t('EVENT_ON_MONTH') }}</span>
                <select class="yw-input" name="{{ p }}_data[month]" data-recurrence-month required aria-label="{{ _t('EVENT_ON_MONTH') }}">
                  {% for key, name in months %}
                    <option value="{{ key }}" {{ rule.month|default('') == key ? 'selected' : '' }}>{{ _t(name) }}</option>
                  {% endfor %}
                </select>
              </fieldset>

              <fieldset class="input-prepend input-group" data-recurrence-when="m y" {{ kind in ['m', 'y'] ? '' : 'disabled hidden' }}>
                <span class="add-on input-group-addon">{{ _t('EVENTS_WHEN_IN_MONTH') }}</span>
                <select class="yw-input" name="{{ p }}_data[whenInMonth]" data-recurrence-in-month required aria-label="{{ _t('EVENTS_WHEN_IN_MONTH') }}">
                  <option value="">{{ _t('BAZ_CHOISIR') }}</option>
                  {% for value, label in { nthOfMonth: 'EVENT_NTH_OF_MONTH', fisrtOfMonth: 'EVENT_FIRST_Y_OF_MONTH', secondOfMonth: 'EVENT_SECOND_Y_OF_MONTH', thirdOfMonth: 'EVENT_THIRD_Y_OF_MONTH', forthOfMonth: 'EVENT_FORTH_Y_OF_MONTH', lastOfMonth: 'EVENT_LAST_Y_OF_MONTH' } %}
                    <option value="{{ value }}" {{ when == value ? 'selected' : '' }}>{{ _t(label) }}</option>
                  {% endfor %}
                </select>
              </fieldset>

              <fieldset data-recurrence-when="w" {{ kind == 'w' ? '' : 'disabled hidden' }}>
                {% for key, name in weekdays %}
                  <label class="input-prepend input-group">
                    <input type="checkbox" class="element_checkbox" name="{{ p }}_data[other][days][{{ key }}]" value="{{ key }}" data-recurrence-day {{ key in days ? 'checked' : '' }}>
                    <span>{{ _t(name) }}</span>
                  </label>
                {% endfor %}
              </fieldset>

              <fieldset class="input-prepend input-group" data-recurrence-when="weekday" {{ kind in ['m', 'y'] and when != '' and when != 'nthOfMonth' ? '' : 'disabled hidden' }}>
                <select class="yw-input" name="{{ p }}_data[other][day]" data-recurrence-weekday required aria-label="{{ _t('BAZ_DAY') }}">
                  {% for key, name in weekdays %}
                    <option value="{{ key }}" {{ days|first == key ? 'selected' : '' }}>{{ _t(name) }}</option>
                  {% endfor %}
                </select>
              </fieldset>

              <fieldset class="input-prepend input-group" data-recurrence-when="nth" {{ kind in ['m', 'y'] and when == 'nthOfMonth' ? '' : 'disabled hidden' }}>
                <span class="add-on input-group-addon">{{ _t('BAZ_DAY') }}</span>
                <select name="{{ p }}_data[nth]" class="yw-input" data-recurrence-nth required aria-label="{{ _t('BAZ_DAY') }}">
                  <option value="">{{ _t('BAZ_CHOISIR') }}</option>
                  {% for day in 1..31 %}
                    {% set padded = '%02d'|format(day) %}
                    <option value="{{ padded }}" {{ rule.nth|default('') == padded ? 'selected' : '' }}>{{ padded }}</option>
                  {% endfor %}
                </select>
              </fieldset>

              <div data-recurrence-days></div>

              <div class="input-prepend input-group">
                <span class="add-on input-group-addon">{{ _t('EVENT_EXCEPT_LABEL') }}</span>
                <select class="yw-input" data-recurrence-except-choice aria-label="{{ _t('EVENT_EXCEPT_LABEL') }}">
                  <option value="">{{ _t('BAZ_CHOISIR') }}</option>
                </select>
              </div>
              <ul class="recurrence__except" data-recurrence-except>
                {% for date in rule.except is defined and rule.except is iterable ? rule.except : [] %}
                  <li data-recurrence-except-date="{{ date }}">
                    <span data-recurrence-except-label>{{ date }}</span>
                    <button type="button" class="btn btn-xs btn-danger btn-icon" data-recurrence-except-remove aria-label="{{ _t('BAZ_SUPPRIMER') }}">{{ icon('x') }}</button>
                    <input type="hidden" name="{{ p }}_data[except][]" value="{{ date }}">
                  </li>
                {% endfor %}
              </ul>
              <template data-recurrence-except-template>
                <li>
                  <span data-recurrence-except-label></span>
                  <button type="button" class="btn btn-xs btn-danger btn-icon" data-recurrence-except-remove aria-label="{{ _t('BAZ_SUPPRIMER') }}">{{ icon('x') }}</button>
                  <input type="hidden" name="{{ p }}_data[except][]" value="">
                </li>
              </template>
            </div>
          </div>
        </fieldset>

        {% if legacyParent %}
          <div class="input-prepend input-group specific-for-recurrence">
            <div class="alert alert-info">
              {{ _t('EVENT_IS_LINKED_TO_RECURRENT_EDIT', { link: '<a class="newtab" href="' ~ url({ tag: legacyParent }) ~ '">' ~ legacyParent|e ~ '</a>' })|raw }}
            </div>
          </div>
        {% endif %}
      </div>
    {% endblock input %}
  {% endembed %}
{% endif %}
