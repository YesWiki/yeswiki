{% extends "@core/layouts/input.twig" %}

{% block input %}
    <div class="input-group">
        <input

            type="{{ field.type }}"
            value="{{ value }}"
            id="{{ field.name }}"
            name="{{ field.name }}"
            class="yw-input input-xxlarge"
            {% if field.type == 'number' -%}
              {%- if field.maxChars != '' %}max="{{ field.maxChars }}"{% endif -%}
              {%- if field.size != '' %}min="{{ field.size }}"{% endif -%}
            {%- else -%}
              {%- if field.maxChars != '' %}maxlength="{{ field.maxChars }}"{% endif -%}
              {%- if field.size != '' %}size="{{ field.size }}"{% endif -%}
            {% endif %}
            {% if field.pattern %}pattern="{{ field.pattern }}"{% endif %}
              placeholder="{{ field.placeholder|default(field.label)|striptags|trim }}"
            {% if field.required %}required{% endif %}
        />
    </div>
{% endblock %}
