{% extends "@core/layouts/input.twig" %}

{% block input %}
    {{ include_css('styles/yw-entries.css') }}
    <div class="input-group file-or-url-input">
        {% if value %}
            {% if isUrl %}
                <span class="url-indicator"><svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#link"/></svg></span>
            {% endif %}
            <a href="{{ fileUrl }}" data-id="{{ field.name }}" target="_blank" {% if not isUrl %}download="{{ shortFileName }}"{% endif %}>{{ shortFileName }}</a>
            &nbsp;-&nbsp;
            {{ include_javascript('javascripts/inputs/file-picker-field.js', false, true) }}
            <button type="button"
                    class="yw-btn yw-btn--sm yw-file-picker-field__button"
                    data-yw-file-picker-field="{{ field.propertyName }}_url">
                <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#pencil"/></svg>
                {{ _t('BAZ_MODIFIER_FICHIER') }}
            </button>
            <input type="url" name="{{ field.propertyName }}_url" id="{{ field.propertyName }}_url" hidden />
             {% if isAllowedToDeleteFile %}
                <a class="yw-btn yw-btn--sm yw-btn--danger" href="{{ deleteUrl }}"
                   onClick="javascript:return confirm('{{ _t('BAZ_CONFIRMATION_SUPPRESSION_FICHIER')|e('js') }}');">
                    {{- _t('BAZ_SUPPRIMER') -}}
                </a>
             {% else %}
                <button class="yw-btn yw-btn--sm yw-btn--danger" disabled="disabled"
                    data-toggle="tooltip" data-placement="bottom" title="{{ _t('BAZ_DROIT_INSUFFISANT') }}">
                    <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#trash"/></svg>
                    {{ _t('BAZ_SUPPRIMER') }}
                </button>
            {% endif %}
            <br />
            <input
                type="hidden"
                name="{{ field.propertyName }}"
                value="{{ value }}"
            />
        {% else %}

            {{ include_javascript('javascripts/inputs/file-picker-field.js', false, true) }}
            <div class="file-or-url">
                <button type="button"
                        class="yw-btn yw-file-picker-field__button"
                        data-yw-file-picker-field="{{ field.propertyName }}_url">
                    <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#upload"/></svg>
                    {{ _t('ATTACH_FILE_PICKER_CHOOSE_OR_UPLOAD') }}
                </button>
                <strong data-yw-file-picker-chosen="{{ field.propertyName }}_url" hidden></strong>
                <label class="yw-form-label" for="{{ field.propertyName }}_url">{{ _t('BAZ_OR_URL') }}</label>
                <input
                    type="url"
                    id="{{ field.propertyName }}_url"
                    name="{{ field.propertyName }}_url"
                    class="yw-input"
                    placeholder="https://..."
                    {% if field.required %}required{% endif %}
                />
            </div>
        {% endif %}
    </div>
{% endblock %}
