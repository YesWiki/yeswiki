{% extends "@core/layouts/input.twig" %}

{% block input %}
    {{ include_css('styles/bazar/inputs/file.css') }}
    <div class="input-group file-or-url-input">
        {% if value %}
            {% if isUrl %}
                <span class="url-indicator"><svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#link"/></svg></span>
            {% endif %}
            <a href="{{ fileUrl }}" data-id="{{ field.name }}" target="_blank" {% if not isUrl %}download="{{ shortFileName }}"{% endif %}>{{ shortFileName }}</a>
            &nbsp;-&nbsp;
            <label class="yw-btn yw-btn--sm">
                <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#pencil"/></svg>
                {{ _t('BAZ_MODIFIER_FICHIER') }}
                {% set style = 'display:none;' %}
                {{ block('inputblock') }}
            </label>
             {% if isAllowedToDeleteFile %}
                <a class="yw-btn yw-btn--sm yw-btn--danger" href="{{ deleteUrl }}"
                   onClick="javascript:return confirm('{{ _t('BAZ_CONFIRMATION_SUPPRESSION_FICHIER') }}');">
                    {{- _t('BAZ_SUPPRIMER') -}}
                </a>
             {% else %}
                <button class="yw-btn yw-btn--sm yw-btn--danger" disabled="disabled"
                    data-toggle="tooltip" data-placement="bottom" title="{{ _t('BAZ_DROIT_INSUFFISANT') }}">
                    <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#trash"/></svg>
                    {{ _t('BAZ_SUPPRIMER') }}
                </button>
            {% endif %}
            <br />
            <input
                type="hidden"
                name="{{ field.propertyName }}"
                value="{{ value }}"
            />
        {% else %}
            <div class="file-url-tabs">
                <ul class="yw-nav" role="tablist">
                    <li role="presentation" class="active">
                        <a href="#{{ field.propertyName }}-upload" aria-controls="{{ field.propertyName }}-upload" role="tab" data-toggle="tab">
                            <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#upload"/></svg> {{ _t('BAZ_UPLOAD_FILE') }}
                        </a>
                    </li>
                    <li role="presentation">
                        <a href="#{{ field.propertyName }}-url" aria-controls="{{ field.propertyName }}-url" role="tab" data-toggle="tab">
                            <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#link"/></svg> {{ _t('BAZ_URL') }}
                        </a>
                    </li>
                </ul>
                <div class="yw-tabs__content">
                    <div role="tabpanel" class="yw-tabs__pane active" id="{{ field.propertyName }}-upload">
                        {% block inputblock %}
                        <input
                            type="file"
                            data-max-size="{{ maxSize }}"
                            id="{{ field.propertyName }}"
                            name="{{ field.propertyName }}"
                            {% if style %}style="{{ style }}"{% endif %}
                            class="yw-input yw-file-upload"
                            {% if field.authorizedExts is not empty %}accept="{{field.authorizedExts|join(',')}}"{% endif %}
                            {% if field.required %}required{% endif %}
                        />
                        {% endblock %}
                    </div>
                    <div role="tabpanel" class="yw-tabs__pane" id="{{ field.propertyName }}-url">
                        <input
                            type="url"
                            id="{{ field.propertyName }}_url"
                            name="{{ field.propertyName }}_url"
                            class="yw-input"
                            placeholder="https://..."
                        />
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
