{% extends "@core/layouts/input.twig" %}
{% block input %}
    {{ include_css("styles/yw-entries.css") }}
    {% if value %}
        <div class="bazar-entry-edit-image">
            {% if isUrl|default(false) %}<span class="url-indicator"><svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#link"/></svg></span>{% endif %}
            <output id="img-{{ field.propertyName }}">{{ image|raw }}</output>
            <div class="image-actions">
                {{ include_javascript('javascripts/inputs/file-picker-field.js', false, true) }}
                <button type="button"
                        class="yw-btn yw-btn--sm yw-file-picker-field__button"
                        data-yw-file-picker-field="{{ field.propertyName }}_url"
                    data-yw-file-picker-only="image">
                    <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#pencil"/></svg>
                    {{ _t("BAZ_MODIFIER_IMAGE") }}
                </button>
                <input type="url" name="{{ field.propertyName }}_url" id="{{ field.propertyName }}_url" hidden />
                {% if isAllowedToDeleteFile and not isDefaultImage %}
                    <a class="yw-btn yw-btn--sm yw-btn--danger"
                       href="{{ deleteUrl }}"
                       onclick="javascript:return confirm('{{ _t("BAZ_CONFIRMATION_SUPPRESSION_IMAGE")|e('js') }}');">
                        <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#trash"/></svg>
                        {{ _t("BAZ_SUPPRIMER_IMAGE") }}
                    </a>
                {% elseif not isDefaultImage %}
                    <button class="yw-btn yw-btn--sm yw-btn--danger"
                            disabled="disabled"
                            data-toggle="tooltip"
                            data-placement="bottom"
                            title="{{ _t("BAZ_DROIT_INSUFFISANT") }}">
                        <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#trash"/></svg>
                        {{ _t("BAZ_SUPPRIMER_IMAGE") }}
                    </button>
                {% endif %}
            </div>
        </div>
        <input type="hidden"
               id="oldimage_{{ field.propertyName }}"
               name="oldimage_{{ field.propertyName }}"
               value="{{ value }}" />
    {% else %}
        {# The rail the editors use, rather than a file box of this field's own: it lists
           the images this wiki already holds and uploads a new one into the same place,
           so a picture attached here is a file Content like any other. It hands back that
           file's address, which lands in the URL box below -- the same box, still there
           for an image hosted somewhere else. #}
        {{ include_javascript('javascripts/inputs/file-picker-field.js', false, true) }}
        <div class="file-or-url">
            <button type="button"
                    class="yw-btn yw-file-picker-field__button"
                    data-yw-file-picker-field="{{ field.propertyName }}_url"
                    data-yw-file-picker-only="image">
                <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#photo"/></svg>
                {{ _t("ATTACH_FILE_PICKER_CHOOSE_OR_UPLOAD") }}
            </button>
            <strong data-yw-file-picker-chosen="{{ field.propertyName }}_url" hidden></strong>
            <label class="yw-form-label" for="{{ field.propertyName }}_url">{{ _t("BAZ_OR_URL") }}</label>
            <input type="url"
                   id="{{ field.propertyName }}_url"
                   name="{{ field.propertyName }}_url"
                   class="yw-input image-url-input"
                   placeholder="https://..."
                   {% if field.required %}required{% endif %} />
            {# `<input id>` + `-preview`, which is what image-field.js looks for: this said
               `img-<name>-url-preview` and the input is `<name>_url`, so the two never met
               and the URL preview has never appeared #}
            <output id="{{ field.propertyName }}_url-preview"
                    class="image-url-preview"></output>
        </div>
    {% endif %}
{% endblock %}
