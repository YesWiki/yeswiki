{% extends "@core/layouts/input.twig" %}

{% block input %}
  {% set displayFilter = (displayFilterLimit and options|length > displayFilterLimit) %}
  {% if displayFilter %}
    <input type="text" class="filter-entries yw-input yw-filter-entries"
          value='' placeholder="{{ _t('BAZAR_FILTER') }}">
  {% endif %}
  <div class="bazar-radio-rows bazar-radio{{ displayVariant|default('') ? ' yw-choice--' ~ displayVariant : '' }}{{ field.required ? ' radio_required' : ''}}{{ displayFilter ? ' list-bazar-entries--scroll' : '' }}">
    {% for key, option in options %}
        {% block radioInput %}
          <div class="radio">
            <label>
              <input class="element_radio" type="radio" id="{{ field.propertyName ~ '_' ~ key }}" 
                     value="{{ key }}" name="{{ field.propertyName }}" 
                     {% if value == key %}checked data-default="checked"{% endif %} />
                <span>{{ option|raw }}</span>
            </label>
          </div>
        {% endblock %}
    {% endfor %}
  </div>
{% endblock %}
