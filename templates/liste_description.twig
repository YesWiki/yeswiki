<!-- SYNDICATION liste-description -->
{{ include_css('styles/yw-entries.css')}}
{% if title is not empty %}
<h2>{{ title }}</h2>
{% endif %}
{% for page in syndication.pages %}
<div class="feed-item with-desc">
  {% if showImage is not empty and page.image is not empty %}
  <img class="feed-img pull-left" src="{{ page.image }}" alt="" />
  {% endif %}
  <h3>
    {% if page.date is not empty %}
    <small class="date_rss">{{ page.date }}</small>
    {% endif %}
    <a class="lien_rss" href="{{ page.url }}" {% if ext == true %}target="_blank"{% endif %}>
      {{ page.title }}
    </a>
    {% if page.source is not empty %}
    <small>{{ _t('SYNDICATION_SOURCE') ~ ' : ' ~ page.source }}</small>
    {% endif %}
    {% if page.linkToEntry is not empty %}
    <a class="bazar-actions" href="{{ page.linkToEntry }}" title="{{ _t('BAZ_SEE_ENTRY') }}"><svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#eye"/></svg></a>
    <a class="bazar-actions" href="{{ page.linkToEntry ~ '/edit' }}" title="{{ _t('BAZ_MODIFIER_LA_FICHE') }}"><svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#edit"/></svg></a>
    <a class="bazar-actions text-danger" href="{{ page.linkToEntry ~ '/deletepage' }}" title="{{ _t('BAZ_SUPPRIMER_LA_FICHE') }}"><svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#trash"/></svg></a>
    {% endif %}
    {% if page.mappingInput is not empty %}
    <a class="bazar-actions" href="{{ url({ params: { mapping: page.mappingInput|e('url') }}) }}" title="{{ _t('SYNDICATION_COPY_IN_WIKI') }}"><svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#plus"/></svg></a>
    {% endif %}
  </h3>
  <div class="description_rss">{{ page.description|raw }}</div>
  <div class="clearfix"></div>
</div>
{% endfor %}
<!-- SYNDICATION liste-description end -->
