{# Cards. `columns` is interpolated into a CSS grid template, so a missing one has to
   default here -- an empty value emits `repeat(, minmax(0, 1fr))`, which the browser drops,
   leaving one column and no clue why (the same trap the Vue card documents). #}
{% import "@core/presentations/_item-fields.twig" as slot %}
{{ include_css('styles/presentations.css') }}

{% set columns = params.columns|default(3) %}
<div class="yw-items yw-items--card" style="--yw-item-columns: {{ columns }}">
  {% for item in items %}
    <article class="yw-item yw-item--card{{ item.image ? ' has-image' : '' }}">
      {{ slot.image(item, item.title) }}
      <div class="yw-item__body">
        {{ slot.badge(item) }}
        {{ slot.title(item) }}
        {{ slot.meta(item) }}
        {% if item.description %}<div class="yw-item__description">{{ item.description|raw }}</div>{% endif %}
      </div>
    </article>
  {% else %}
    <p class="yw-items__empty">{{ _t('BAZ_NO_RESULT') }}</p>
  {% endfor %}
</div>
