
{% import "@core/presentations/_item-fields.twig" as slot %}
{{ include_css('styles/yw-entries.css') }}

{% set columns = params.columns|default(3) %}

{% set imagefit = params.imagefit|default('cover') %}
<div class="yw-items yw-items--card" style="--yw-item-columns: {{ columns }}; --yw-item-image-fit: {{ imagefit == 'contain' ? 'contain' : 'cover' }}">
  {% for item in items %}
    <article class="yw-item yw-item--card{{ item.image ? ' has-image' : '' }}">
      {{ slot.image(item, item.title) }}
      <div class="yw-item__body">
        {{ slot.badge(item) }}
        {{ slot.title(item) }}
        {{ slot.meta(item) }}
        {% if item.description %}<div class="yw-item__description">{{ item.description|raw }}</div>{% endif %}
        {{ slot.cta(item) }}
      </div>
    </article>
  {% else %}
    <p class="yw-items__empty">{{ _t('BAZ_NO_RESULT') }}</p>
  {% endfor %}
</div>
