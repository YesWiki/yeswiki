
{% macro badge(item) %}
  {% if item.badge %}<span class="yw-item__badge">{{ item.badge }}</span>{% endif %}
{% endmacro %}

{% macro image(item, alt, width) %}
  {% if item.image %}
    {% set w = width|default(0) %}
    <img class="yw-item__image"
         src="{{ image_at(item.image, w, w > 0 ? (w * 2 / 3)|round : 0) }}"
         alt="{{ alt|default('') }}" loading="lazy" />
  {% endif %}
{% endmacro %}

{% macro title(item) %}
  {% if item.url %}
    <a class="yw-item__title" href="{{ item.url }}">{{ item.title }}</a>
  {% else %}
    <span class="yw-item__title">{{ item.title }}</span>
  {% endif %}
{% endmacro %}

{% macro cta(item) %}
  {% if item.ctaUrl %}
    <a class="yw-item__cta yw-btn yw-btn--sm yw-btn--primary" href="{{ item.ctaUrl }}">{{ item.ctaLabel }}</a>
  {% endif %}
{% endmacro %}

{% macro meta(item) %}
  {% if item.subtitle or item.date %}
    <div class="yw-item__meta">
      {% if item.subtitle %}<span class="yw-item__subtitle">{{ item.subtitle }}</span>{% endif %}
      {% if item.date %}<time class="yw-item__date" datetime="{{ item.date }}">{{ item.date|moment }}</time>{% endif %}
    </div>
  {% endif %}
{% endmacro %}
