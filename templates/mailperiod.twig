<div class="mail-period">
  {% for messageType, message in messages %}
    <div class="yw-alert yw-alert--{{ messageType }}">{{ message }}</div>
  {% endfor %}

  <label>{{ _t('CONTACT_PERIOD') }}</label>

  {% if user %}
    <form method="post" class="mail-period__choices" role="group">
      <input type="hidden" name="csrf-token" value="{{ csrfToken({id: 'main', refresh: false})|e('html_attr') }}">
      {% for config in periods %}
        <button type="submit" name="subscribe" value="{{ config.period }}" class="yw-btn yw-btn--sm{{ config.subscribed ? ' yw-btn--primary' : '' }}">
          {{ config.label }}
        </button>
      {% endfor %}
      {% if subscribed %}
        <button type="submit" name="unsubscribe" value="1" class="yw-btn yw-btn--sm yw-btn--danger">
          {{ _t('CONTACT_UNSUBSCRIBE') }}
        </button>
      {% endif %}
    </form>
  {% else %}
    <div class="mail-period__choices" role="group">
      {% for config in periods %}
        <a href="{{ url({ tag: 'user' }) }}" class="yw-btn yw-btn--sm">{{ config.label }}</a>
      {% endfor %}
    </div>
  {% endif %}
</div>
