{% if fiches|length > 0 %}
  <div class="entries-container">
    {% for fiche in fiches %}
       <div class="bazar-entry" {{ fiche.html_data|raw }}>
         {{ format('{{include class="clearfix" page="'~ fiche.tag ~'"}}')|raw }}
       </div>
    {% endfor %}
  </div> <!-- / entries-container -->
{% endif %}
