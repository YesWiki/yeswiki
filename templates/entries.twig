{% if entries|length > 0 %}
  <div class="entries-container">
    {% for entry in entries %}
       <div class="bazar-entry" {{ entry.html_data|raw }}>
         {{ format('{{include class="clearfix" page="'~ entry.tag ~'"}}')|raw }}
       </div>
    {% endfor %}
  </div> <!-- / entries-container -->
{% endif %}
