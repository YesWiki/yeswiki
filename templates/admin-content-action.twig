{# ============================================================
   AdminContent action – main shell template
   Loaded once; the inner table is swapped by HTMX.
============================================================ #}
{{ include_css("styles/yw-admin.css") }}
<div class="no-dblclick admin-content-wrapper" id="admin-content-wrapper">
    {# --------------------------------------------------------
       Flash / bulk-action result area
       -------------------------------------------------------- #}
    <div id="admin-bulk-result" aria-live="polite"></div>
    {# --------------------------------------------------------
       Filter bar  (values are included in every HTMX request)
       -------------------------------------------------------- #}
    <div class="admin-content-filter-bar">
        <form id="admin-content-filter-form" autocomplete="off">
            <div class="yw-form-group">
                <label for="acf-search">{{ _t("TEMPLATE_SEARCH") }}</label>
                {# the shared box in its inline form: same component as {{search}} and the
                   entry lists, sized for a filter bar rather than for a page that is about
                   searching. No button -- this bar filters as you type. #}
                {% include '@core/_searchbox.twig' with {
                name: 'search',
                id: 'acf-search',
                button: '',
                modifier: 'yw-searchbox--inline'
                } only %}
            </div>
            <div class="yw-form-group">
                <label for="acf-type">Type</label>
                <select id="acf-type" name="type" class="yw-input">
                    <option value="all">— {{ _t("GROUP_SELECTION") }} —</option>
                    <option value="pages">{{ _t("ADMIN_CONTENT_TYPE_PAGES") }}</option>
                    <option value="bazar">{{ _t("ADMIN_CONTENT_TYPE_ALL_FORMS") }}</option>
                    {# `forms` is id => label (FormManager::getAllLabels()) #}
                    {% for id, label in forms %}
                        <option value="{{ id }}">{{ _t("ADMIN_CONTENT_TYPE_FORM") |replace({'{name}': label}) }}</option>
                    {% endfor %}
                    <option value="lists">{{ _t("ADMIN_CONTENT_TYPE_LISTS") }}</option>
                    <option value="special">{{ _t("ADMIN_CONTENT_TYPE_SPECIAL_PAGES") }}</option>
                    <option value="comments">{{ _t("COMMENTS") }}</option>
                </select>
            </div>
            <div class="yw-form-group">
                <label for="acf-owner">{{ _t("TEMPLATE_OWNER") }}</label>
                <select id="acf-owner" name="owner" class="yw-input">
                    <option value="">— {{ _t("GROUP_SELECTION") }} —</option>
                    {% for owner in owners %}<option value="{{ owner|e("html_attr") }}">{{ owner|e }}</option>{% endfor %}
                </select>
            </div>
            <div class="yw-form-group">
                <label for="acf-acl">{{ _t("ADMIN_CONTENT_ACL_LABEL") }}</label>
                <select id="acf-acl" name="acl_filter" class="yw-input">
                    <option value="">— {{ _t("GROUP_SELECTION") }} —</option>
                    <optgroup label="{{ _t("ADMIN_CONTENT_ACL_READ_LABEL") }}">
                        <option value="read|*">{{ _t("ADMIN_CONTENT_ACL_READ_LABEL") }} : {{ _t("ACLS_EVERYBODY") }}</option>
                        <option value="read|+">{{ _t("ADMIN_CONTENT_ACL_READ_LABEL") }} : {{ _t("ACLS_AUTHENTIFICATED_USERS") }}</option>
                        <option value="read|%">{{ _t("ADMIN_CONTENT_ACL_READ_LABEL") }} : {{ _t("ACLS_OWNER") }}</option>
                        {% for group in groups %}
                            <option value="read|@{{ group }}">{{ _t("ADMIN_CONTENT_ACL_READ_LABEL") }} : @{{ group }}</option>
                        {% endfor %}
                    </optgroup>
                    <optgroup label="{{ _t("ADMIN_CONTENT_ACL_WRITE_LABEL") }}">
                        <option value="write|*">{{ _t("ADMIN_CONTENT_ACL_WRITE_LABEL") }} : {{ _t("ACLS_EVERYBODY") }}</option>
                        <option value="write|+">{{ _t("ADMIN_CONTENT_ACL_WRITE_LABEL") }} : {{ _t("ACLS_AUTHENTIFICATED_USERS") }}</option>
                        <option value="write|%">{{ _t("ADMIN_CONTENT_ACL_WRITE_LABEL") }} : {{ _t("ACLS_OWNER") }}</option>
                        {% for group in groups %}
                            <option value="write|@{{ group }}">{{ _t("ADMIN_CONTENT_ACL_WRITE_LABEL") }} : @{{ group }}</option>
                        {% endfor %}
                    </optgroup>
                    <optgroup label="{{ _t("ADMIN_CONTENT_ACL_COMMENT_LABEL") }}">
                        <option value="comment|*">{{ _t("ADMIN_CONTENT_ACL_COMMENT_LABEL") }} : {{ _t("ACLS_EVERYBODY") }}</option>
                        <option value="comment|+">{{ _t("ADMIN_CONTENT_ACL_COMMENT_LABEL") }} : {{ _t("ACLS_AUTHENTIFICATED_USERS") }}</option>
                        <option value="comment|%">{{ _t("ADMIN_CONTENT_ACL_COMMENT_LABEL") }} : {{ _t("ACLS_OWNER") }}</option>
                        <option value="comment|comments-closed">
                            {{ _t("ADMIN_CONTENT_ACL_COMMENT_LABEL") }} : {{ _t("ACLS_COMMENTS_CLOSED") }}
                        </option>
                        {% for group in groups %}
                            <option value="comment|@{{ group }}">{{ _t("ADMIN_CONTENT_ACL_COMMENT_LABEL") }} : @{{ group }}</option>
                        {% endfor %}
                    </optgroup>
                </select>
            </div>
            <div class="yw-form-group">
                <label for="acf-theme">{{ _t("ADMIN_CONTENT_THEME_THEME") }}</label>
                <select id="acf-theme" name="theme_filter" class="yw-input">
                    <option value="">— {{ _t("GROUP_SELECTION") }} —</option>
                    {% for key, tpl in templates %}<option value="{{ key|e("html_attr") }}">{{ (tpl.name ?? key)|e }}</option>{% endfor %}
                </select>
            </div>
            <div class="yw-form-group">
                <label for="acf-tag">{{ _t("ADMIN_CONTENT_KEYWORDS_LABEL") }}</label>
                <input id="acf-tag"
                       type="text"
                       name="tag_filter"
                       class="yw-input"
                       placeholder="{{ _t("ACLS_SELECT_PAGES_FILTER") }}">
            </div>
            <div class="yw-form-group">
                <label for="acf-perpage">{{ _t("ADMIN_CONTENT_PER_PAGE_LABEL") }}</label>
                <select id="acf-perpage" name="perpage" class="yw-input">
                    <option value="50" selected>50</option>
                    <option value="100">100</option>
                    <option value="150">150</option>
                    <option value="200">200</option>
                    <option value="500">500</option>
                </select>
            </div>
            {# Hidden state fields (updated by JS) #}
            <input type="hidden" id="acf-sort" name="sort" value="tag">
            <input type="hidden" id="acf-dir"  name="dir"  value="asc">
            <input type="hidden" id="acf-page" name="page" value="1">
            <div class="yw-form-group">
                <button type="button" id="acf-reset" class="yw-btn yw-btn--sm">
                    <svg class="yw-icon" aria-hidden="true">
                        <use href="src/assets/icons.svg#x" />
                    </svg>
                    {{ _t("YW_CANCEL") }}
                </button>
            </div>
        </form>
    </div>
    {# /.admin-content-filter-bar #}
    {# --------------------------------------------------------
       Table container – HTMX target
       -------------------------------------------------------- #}
    <div class="admin-content-table-wrap">
        <div id="table-spinner" class="htmx-indicator admin-content-spinner">
            <svg class="yw-icon yw-icon--spin yw-icon--2x yw-text-muted"
                 aria-hidden="true">
                <use href="src/assets/icons.svg#loader-2" />
            </svg>
        </div>
        <div id="admin-content-table-container"
             hx-get="{{ apiUrl }}"
             hx-trigger="refreshTable from:body"
             hx-include="#admin-content-filter-form"
             hx-indicator="#table-spinner"
             hx-swap="innerHTML"></div>
    </div>
    {# /.admin-content-table-wrap #}
    {# --------------------------------------------------------
       Bulk action sticky panel
       -------------------------------------------------------- #}
    <div class="admin-bulk-panel" id="admin-bulk-panel" aria-live="polite">
        <span class="bulk-count" id="bulk-count-label">0 {{ _t("PAGES") }}</span>
        {% if not isHibernated %}
            <button type="button"
                    class="yw-btn yw-btn--warning yw-btn--sm"
                    data-yw-modal-target="#modal-acls"
                    id="btn-bulk-acls"
                    onclick="adminContent.populateModal('acls')">
                <svg class="yw-icon" aria-hidden="true">
                    <use href="src/assets/icons.svg#lock" />
                </svg>
                {{ _t("ADMIN_CONTENT_ACL_LABEL") }}
            </button>
            <button type="button"
                    class="yw-btn yw-btn--info yw-btn--sm"
                    data-yw-modal-target="#modal-theme"
                    id="btn-bulk-theme"
                    onclick="adminContent.populateModal('theme')">
                <svg class="yw-icon" aria-hidden="true">
                    <use href="src/assets/icons.svg#brush" />
                </svg>
                {{ _t("ADMIN_CONTENT_BULK_THEME") }}
            </button>
        {% endif %}
        <button type="button"
                class="yw-btn yw-btn--danger yw-btn--sm"
                data-yw-modal-target="#modal-delete"
                id="btn-bulk-delete"
                onclick="adminContent.populateModal('delete')">
            <svg class="yw-icon" aria-hidden="true">
                <use href="src/assets/icons.svg#trash" />
            </svg>
            {{ _t("DELETE") }}
        </button>
        <button type="button"
                class="yw-btn yw-btn--sm"
                onclick="adminContent.clearSelection()">
            <svg class="yw-icon" aria-hidden="true">
                <use href="src/assets/icons.svg#circle-x" />
            </svg>
            {{ _t("YW_CANCEL") }}
        </button>
    </div>
    {# ============================================================
       MODALS
============================================================ #}
    {# ---- DELETE modal ---- #}
    <div class="yw-modal" id="modal-delete" tabindex="-1" role="dialog">
        <div class="yw-modal__dialog" role="document">
            <div class="yw-modal__content">
                <div class="yw-modal__header">
                    <button type="button" class="yw-close" data-yw-dismiss="modal">&times;</button>
                    <h4 class="yw-modal__title">
                        <svg class="yw-icon yw-text-danger" aria-hidden="true">
                            <use href="src/assets/icons.svg#trash" />
                        </svg>
                        {{ _t("DELETE") }}
                    </h4>
                </div>
                <form hx-post="{{ bulkApiUrl }}"
                      hx-target="#admin-bulk-result"
                      hx-swap="innerHTML"
                      id="form-delete">
                    <div class="yw-modal__body">
                        <div class="yw-alert yw-alert--danger">
                            <svg class="yw-icon" aria-hidden="true">
                                <use href="src/assets/icons.svg#alert-triangle" />
                            </svg>
                            <strong>{{ _t("ADMIN_CONTENT_IRREVERSIBLE_ACTION") }}</strong> —
                            {{ _t("ADMIN_CONTENT_DELETE_WARNING") }}
                        </div>
                        <p>
                            {{ _t("ADMIN_CONTENT_SELECTED_LABEL") }} <strong id="delete-count-label">0</strong> page(s)
                        </p>
                        <div id="delete-pages-list" class="yw-box"></div>
                        <input type="hidden" name="bulk_action" value="delete">
                        <input type="hidden"
                               name="csrf-token"
                               value="{{ csrfToken({"id": "main", "refresh": false}) |e('html_attr') }}">
                        <div id="delete-pages-inputs"></div>
                    </div>
                    <div class="yw-modal__footer">
                        <button type="button" class="yw-btn" data-yw-dismiss="modal">{{ _t("YW_CANCEL") }}</button>
                        <button type="submit" class="yw-btn yw-btn--danger">
                            <svg class="yw-icon" aria-hidden="true">
                                <use href="src/assets/icons.svg#trash" />
                            </svg>
                            {{ _t("DELETE") }}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    {# ---- ACLs modal ---- #}
    <div class="yw-modal" id="modal-acls" tabindex="-1" role="dialog">
        <div class="yw-modal__dialog yw-modal__dialog--lg" role="document">
            <div class="yw-modal__content">
                <div class="yw-modal__header">
                    <button type="button" class="yw-close" data-yw-dismiss="modal">&times;</button>
                    <h4 class="yw-modal__title">
                        <svg class="yw-icon yw-text-warning" aria-hidden="true">
                            <use href="src/assets/icons.svg#lock" />
                        </svg>
                        {{ _t("ADMIN_CONTENT_EDIT_ACL_TITLE") }}
                    </h4>
                </div>
                <form hx-post="{{ bulkApiUrl }}"
                      hx-target="#admin-bulk-result"
                      hx-swap="innerHTML"
                      id="form-acls">
                    <div class="yw-modal__body">
                        <p>
                            {{ _t("ADMIN_CONTENT_SELECTED_LABEL") }} <strong id="acls-count-label">0</strong> page(s)
                        </p>
                        <div id="acls-pages-inputs"></div>
                        <input type="hidden" name="bulk_action" value="change-acls">
                        <input type="hidden"
                               name="csrf-token"
                               value="{{ csrfToken({"id": "main", "refresh": false}) |e('html_attr') }}">
                        <div class="yw-form-group">
                            <label>{{ _t("ADMIN_CONTENT_ACL_MODE_LABEL") }}</label>
                            <div>
                                <label class="yw-radio-inline">
                                    <input type="radio" name="acl_mode" value="replace" checked>
                                    {{ _t("ACLS_REPLACE_SELECTED_PAGES") }}
                                </label>
                                <label class="yw-radio-inline">
                                    <input type="radio" name="acl_mode" value="append">
                                    {{ _t("ADMIN_CONTENT_ACL_MODE_APPEND") }}
                                </label>
                                <label class="yw-radio-inline">
                                    <input type="radio" name="acl_mode" value="default">
                                    {{ _t("ACLS_RESET_SELECTED_PAGES") }}
                                </label>
                            </div>
                        </div>
                        <div class="yw-alert yw-alert--info" style="font-size:12px;">{{ _t("ACLS_HELPER") |raw }}</div>
                        <div class="yw-form-row">
                            {% for role in ['read','write','comment'] %}
                                <div class="yw-form-group">
                                    <label>
                                        {% if role == 'read' %}
                                            {{ _t("YW_ACLS_READ") }}
                                        {% elseif role == 'write' %}
                                            {{ _t("YW_ACLS_WRITE") }}
                                        {% else %}
                                            {{ _t("YW_ACLS_COMMENT") }}
                                        {% endif %}
                                    </label>
                                    <select name="acl_{{ role }}" class="yw-input acl-select">
                                        <option value="">— {{ _t("ACLS_NO_CHANGE") }} —</option>
                                        {% if role == 'comment' %}
                                            <option value="comments-closed">{{ _t("ACLS_COMMENTS_CLOSED") }}</option>
                                        {% else %}
                                            <option value="*">{{ _t("ACLS_EVERYBODY") }}</option>
                                        {% endif %}
                                        <option value="+">{{ _t("ACLS_AUTHENTIFICATED_USERS") }}</option>
                                        <option value="%">{{ _t("ACLS_OWNER") }}</option>
                                        {% for group in groups %}<option value="@{{ group }}">@{{ group }}</option>{% endfor %}
                                    </select>
                                    <input type="text"
                                           name="acl_{{ role }}_custom"
                                           class="yw-input"
                                           style="margin-top:4px"
                                           placeholder="{{ _t("ACLS_LIST_OF_ACLS") }}">
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                    <div class="yw-modal__footer">
                        <button type="button" class="yw-btn" data-yw-dismiss="modal">{{ _t("YW_CANCEL") }}</button>
                        <button type="submit" class="yw-btn yw-btn--warning">
                            <svg class="yw-icon" aria-hidden="true">
                                <use href="src/assets/icons.svg#device-floppy" />
                            </svg>
                            {{ _t("ACLS_UPDATE") }}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    {# ---- Theme modal ---- #}
    <div class="yw-modal" id="modal-theme" tabindex="-1" role="dialog">
        <div class="yw-modal__dialog yw-modal__dialog--lg" role="document">
            <div class="yw-modal__content">
                <div class="yw-modal__header">
                    <button type="button" class="yw-close" data-yw-dismiss="modal">&times;</button>
                    <h4 class="yw-modal__title">
                        <svg class="yw-icon yw-text-info" aria-hidden="true">
                            <use href="src/assets/icons.svg#brush" />
                        </svg>
                        {{ _t("GERERTHEMES_MODIFY_THEME_FOR_SELECTED_PAGES") }}
                    </h4>
                </div>
                <form hx-post="{{ bulkApiUrl }}"
                      hx-target="#admin-bulk-result"
                      hx-swap="innerHTML"
                      id="form-theme">
                    <div class="yw-modal__body">
                        <p>
                            {{ _t("ADMIN_CONTENT_SELECTED_LABEL") }} <strong id="theme-count-label">0</strong> page(s)
                        </p>
                        <div id="theme-pages-inputs"></div>
                        <input type="hidden" name="bulk_action" value="change-theme">
                        <input type="hidden"
                               name="csrf-token"
                               value="{{ csrfToken({"id": "main", "refresh": false}) |e('html_attr') }}">
                        <div class="yw-form-group">
                            <label class="yw-checkbox-inline">
                                <input type="checkbox" name="reset_theme" value="1" id="chk-reset-theme">
                                {{ _t("GERERTHEMES_INIT_THEME_FOR_SELECTED_PAGES") }}
                            </label>
                        </div>
                        <div id="theme-fields">
                            <div class="yw-form-row">
                                <div class="yw-form-group">
                                    <label>{{ _t("ADMIN_CONTENT_THEME_THEME") }}</label>
                                    <select name="theme" id="theme-select" class="yw-input">
                                        <option value="">— {{ _t("ACLS_NO_CHANGE") }} —</option>
                                        {% for key, tpl in templates %}<option value="{{ key }}">{{ tpl.name ?? key }}</option>{% endfor %}
                                    </select>
                                </div>
                                <div class="yw-form-group">
                                    <label>{{ _t("ADMIN_CONTENT_THEME_SQUELETTE") }}</label>
                                    <select name="squelette" id="squelette-select" class="yw-input">
                                        <option value="">— {{ _t("ACLS_NO_CHANGE") }} —</option>
                                    </select>
                                </div>
                                <div class="yw-form-group">
                                    <label>{{ _t("ADMIN_CONTENT_THEME_STYLE") }}</label>
                                    <select name="style" id="style-select" class="yw-input">
                                        <option value="">— {{ _t("ACLS_NO_CHANGE") }} —</option>
                                    </select>
                                </div>
                                <div class="yw-form-group">
                                    <label>{{ _t("ADMIN_CONTENT_THEME_PRESET") }}</label>
                                    <select name="preset" id="preset-select" class="yw-input">
                                        <option value="">— {{ _t("ACLS_NO_CHANGE") }} —</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="yw-modal__footer">
                        <button type="button" class="yw-btn" data-yw-dismiss="modal">{{ _t("YW_CANCEL") }}</button>
                        <button type="submit" class="yw-btn yw-btn--info">
                            <svg class="yw-icon" aria-hidden="true">
                                <use href="src/assets/icons.svg#device-floppy" />
                            </svg>
                            {{ _t("ACLS_UPDATE") }}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{# /.admin-content-wrapper #}
<script>
(function () {
    'use strict';

    // -----------------------------------------------------------------------
    // Templates data (PHP → JS) for dynamic squelette/style/preset selects
    // -----------------------------------------------------------------------
    var TEMPLATES = {{ templates|json_encode|raw }};

    // Translated UI strings
    var I18N = {
        noChange:    '— {{ _t('ACLS_NO_CHANGE')|e('js') }} —',
        selectedFmt: '{{ _t('ADMIN_CONTENT_SELECTED_N_PAGES')|e('js') }}',
    };

    // -----------------------------------------------------------------------
    // State
    // -----------------------------------------------------------------------
    var selectedPages = new Set();   // page tags currently selected
    var lastCheckedIndex = -1;       // for shift+click range selection

    // -----------------------------------------------------------------------
    // Core object
    // -----------------------------------------------------------------------
    var adminContent = {

        // -- Selection management ------------------------------------------
        togglePage: function (tag, checked) {
            if (checked) {
                selectedPages.add(tag);
            } else {
                selectedPages.delete(tag);
            }
            adminContent.updateBulkPanel();
        },

        toggleCurrentPage: function (checked) {
            document.querySelectorAll('#admin-content-table-container .page-checkbox')
                .forEach(function (cb) {
                    cb.checked = checked;
                    adminContent.togglePage(cb.dataset.tag, checked);
                });
        },

        clearSelection: function () {
            selectedPages.clear();
            document.querySelectorAll('.page-checkbox').forEach(function (cb) {
                cb.checked = false;
            });
            var sa = document.getElementById('select-all-current');
            if (sa) sa.checked = false;
            adminContent.updateBulkPanel();
        },

        // Re-check boxes for already-selected pages after an HTMX swap
        restoreChecks: function () {
            document.querySelectorAll('#admin-content-table-container .page-checkbox')
                .forEach(function (cb) {
                    cb.checked = selectedPages.has(cb.dataset.tag);
                });
        },

        // -- Bulk panel UI --------------------------------------------------
        updateBulkPanel: function () {
            var panel = document.getElementById('admin-bulk-panel');
            var label = document.getElementById('bulk-count-label');
            var n     = selectedPages.size;
            label.textContent = I18N.selectedFmt.replace('%d', n);
            if (n > 0) {
                panel.classList.add('visible');
            } else {
                panel.classList.remove('visible');
            }
        },

        // -- Modal population -----------------------------------------------
        populateModal: function (type) {
            var pages  = Array.from(selectedPages);
            var inputs = '';
            pages.forEach(function (tag) {
                inputs += '<input type="hidden" name="pages[]" value="' + adminContent.esc(tag) + '">';
            });

            var countEl, listEl, inputEl;

            if (type === 'delete') {
                document.getElementById('delete-count-label').textContent = pages.length;
                document.getElementById('delete-pages-list').textContent  = pages.join(', ');
                document.getElementById('delete-pages-inputs').innerHTML   = inputs;

            } else if (type === 'acls') {
                document.getElementById('acls-count-label').textContent = pages.length;
                document.getElementById('acls-pages-inputs').innerHTML   = inputs;

            } else if (type === 'theme') {
                document.getElementById('theme-count-label').textContent = pages.length;
                document.getElementById('theme-pages-inputs').innerHTML   = inputs;
            }
        },

        // -- Sorting --------------------------------------------------------
        setSort: function (col) {
            var sortEl = document.getElementById('acf-sort');
            var dirEl  = document.getElementById('acf-dir');
            var cur    = sortEl.value;
            var curDir = dirEl.value;

            if (cur === col) {
                dirEl.value = curDir === 'asc' ? 'desc' : 'asc';
            } else {
                sortEl.value = col;
                dirEl.value  = 'asc';
            }
            // Reset to page 1
            document.getElementById('acf-page').value = 1;
            pushState();
            adminContent.loadTable();
        },

        // -- Pagination -----------------------------------------------------
        goToPage: function (p) {
            document.getElementById('acf-page').value = p;
            pushState();
            adminContent.loadTable();
        },

        // -- Load table via HTMX -------------------------------------------
        loadTable: function () {
            var params = new URLSearchParams(
                new FormData(document.getElementById('admin-content-filter-form'))
            );
            var apiBase = '{{ apiUrl }}';
            var sep = apiBase.indexOf('?') >= 0 ? '&' : '?';
            htmx.ajax('GET', apiBase + sep + params.toString(), {
                target:  '#admin-content-table-container',
                swap:    'innerHTML',
                indicator: '#table-spinner'
            });
        },

        // -- Escaping helper -----------------------------------------------
        esc: function (str) {
            return str
                .replace(/&/g, '&amp;')
                .replace(/"/g, '&quot;')
                .replace(/</g , '&lt;') .replace( />/g, '&gt;');
        },
    };

    // Make accessible globally (called from inline event attrs)
    window.adminContent = adminContent;

    // -----------------------------------------------------------------------
    // Debounce utility
    // -----------------------------------------------------------------------
    function debounce(fn, ms) {
        var t;
        return function () {
            clearTimeout(t);
            t = setTimeout(fn, ms);
        };
    }

    // -----------------------------------------------------------------------
    // URL sync helpers
    // -----------------------------------------------------------------------
    var DEFAULTS = { search: '', type: 'all', owner: '', tag_filter: '', acl_filter: '', theme_filter: '', perpage: '50', sort: 'tag', dir: 'asc', page: '1' };

    // The YesWiki page tag is always the first query segment (e.g. "?GererSite&…").
    // Extract it once so we can preserve it when rewriting the query string.
    var PAGE_TAG_SEGMENT = (function () {
        var raw = location.search.slice(1); // drop leading '?'
        var first = raw.split('&')[0];
        // It's the page tag if it contains no '=' or its value is empty
        return (first && first.indexOf('=') === -1) ? first : '';
    }());

    function pushState() {
        var params = new URLSearchParams();
        var data   = new FormData(filterForm);
        data.forEach(function (val, key) {
            if (val !== '' && val !== DEFAULTS[key]) {
                params.set(key, val);
            }
        });
        var qs = params.toString();
        var url = '?' + PAGE_TAG_SEGMENT + (qs ? ('&' + qs) : '');
        history.replaceState(null, '', url);
    }

    function restoreFromUrl() {
        var params = new URLSearchParams(location.search);
        ['search', 'type', 'owner', 'tag_filter', 'acl_filter', 'theme_filter', 'perpage'].forEach(function (name) {
            var el = filterForm.querySelector('[name="' + name + '"]');
            if (el && params.has(name)) el.value = params.get(name);
        });
        ['sort', 'dir', 'page'].forEach(function (name) {
            var el = document.getElementById('acf-' + name);
            if (el && params.has(name)) el.value = params.get(name);
        });
    }

    // -----------------------------------------------------------------------
    // Filter form events
    // -----------------------------------------------------------------------
    var filterForm = document.getElementById('admin-content-filter-form');
    var debouncedLoad = debounce(function () {
        document.getElementById('acf-page').value = 1;
        pushState();
        adminContent.loadTable();
    }, 350);

    filterForm.addEventListener('input',  function (e) {
        if (e.target.type === 'search' || e.target.type === 'text') {
            debouncedLoad();
        }
    });
    filterForm.addEventListener('change', function (e) {
        if (e.target.tagName === 'SELECT') {
            document.getElementById('acf-page').value = 1;
            pushState();
            adminContent.loadTable();
        }
    });

    document.getElementById('acf-reset').addEventListener('click', function () {
        filterForm.reset();
        document.getElementById('acf-sort').value = 'tag';
        document.getElementById('acf-dir').value  = 'asc';
        document.getElementById('acf-page').value = '1';
        pushState();
        adminContent.loadTable();
    });

    // Restore filter state from URL, then fire initial table load.
    // ticket 16: ywInitEach, not DOMContentLoaded -- internal links load through htmx and
    // DOMContentLoaded fires once per document, so this never ran on a page reached by a
    // navigation and the table stayed empty.
    ywInitEach('#admin-content-table-container', function () {
        restoreFromUrl();
        pushState();
        adminContent.loadTable();
    });

    // -----------------------------------------------------------------------
    // HTMX: restore checkbox state after table swap
    // -----------------------------------------------------------------------
    document.body.addEventListener('htmx:afterSwap', function (e) {
        if (e.detail.target.id === 'admin-content-table-container') {
            adminContent.restoreChecks();
            lastCheckedIndex = -1;
        }
    });

    // -----------------------------------------------------------------------
    // Row click → toggle checkbox (with shift+click range support)
    // Clicks on <a> links pass through normally.
    // Clicks on the label prevent the browser's built-in toggle so we
    // handle it ourselves (avoiding the focus-scroll side-effect).
    // -----------------------------------------------------------------------
    var tableContainer = document.getElementById('admin-content-table-container');

    tableContainer.addEventListener('click', function (e) {
        // Let links work normally
        if (e.target.closest('a')) return;

        // Only act on body rows that have a page-checkbox
        var row = e.target.closest('tbody tr');
        if (!row) return;
        var cb = row.querySelector('input.page-checkbox');
        if (!cb) return;

        // Prevent browser's built-in label→input toggle (we do it manually)
        // This also prevents the focus-scroll side-effect
        if (e.target.closest('label')) e.preventDefault();

        var all = Array.from(tableContainer.querySelectorAll('.page-checkbox'));
        var idx = all.indexOf(cb);

        if (e.shiftKey && lastCheckedIndex >= 0 && idx !== lastCheckedIndex) {
            var newState = !cb.checked;
            var from = Math.min(idx, lastCheckedIndex);
            var to   = Math.max(idx, lastCheckedIndex);
            for (var i = from; i <= to; i++) {
                all[i].checked = newState;
                adminContent.togglePage(all[i].dataset.tag, newState);
            }
        } else {
            cb.checked = !cb.checked;
            adminContent.togglePage(cb.dataset.tag, cb.checked);
        }

        cb.focus({ preventScroll: true });
        lastCheckedIndex = idx;
    });

    // -----------------------------------------------------------------------
    // After bulk form submission: close the modal that triggered it
    // -----------------------------------------------------------------------
    ['form-delete','form-acls','form-theme'].forEach(function (id) {
        var form = document.getElementById(id);
        if (!form) return;
        form.addEventListener('htmx:afterRequest', function (e) {
            if (e.detail.successful) {
                var modal = form.closest('.yw-modal');
                if (modal) modal.classList.remove('yw-modal--open');
                adminContent.clearSelection();
            }
        });
    });

    // Theme modal: populate squelette / style / preset when theme changes
    var themeSelect = document.getElementById('theme-select');
    if (themeSelect) {
        themeSelect.addEventListener('change', function () {
            adminContent.updateThemeOptions(this.value);
        });
    }

    adminContent.updateThemeOptions = function (themeKey) {
        var sqEl  = document.getElementById('squelette-select');
        var stEl  = document.getElementById('style-select');
        var prEl  = document.getElementById('preset-select');
        var tpl   = TEMPLATES[themeKey] || {};
        var blank = '<option value="">' + adminContent.esc(I18N.noChange) + '</option>';

        [sqEl, stEl, prEl].forEach(function (el) { el.innerHTML = blank; });

        var squelettes = tpl.squelette || {};
        Object.keys(squelettes).forEach(function (filename) {
            sqEl.innerHTML += '<option value="' + adminContent.esc(filename) + '">' + adminContent.esc(squelettes[filename]) + '</option>';
        });
        var styles = tpl.style || {};
        Object.keys(styles).forEach(function (filename) {
            stEl.innerHTML += '<option value="' + adminContent.esc(filename) + '">' + adminContent.esc(styles[filename]) + '</option>';
        });
        Object.keys(tpl.presets || {}).forEach(function (filename) {
            prEl.innerHTML += '<option value="' + adminContent.esc(filename) + '">' + adminContent.esc(filename) + '</option>';
        });
    };

    // Toggle reset mode: disable all selects when reset is checked
    var chkReset = document.getElementById('chk-reset-theme');
    if (chkReset) {
        chkReset.addEventListener('change', function () {
            var disabled = this.checked;
            ['theme-select', 'squelette-select', 'style-select', 'preset-select'].forEach(function (id) {
                var el = document.getElementById(id);
                if (el) el.disabled = disabled;
            });
        });
    }

    // -----------------------------------------------------------------------
    // ACLs modal: custom text input overrides the select
    // -----------------------------------------------------------------------
    document.querySelectorAll('.acl-select').forEach(function (sel) {
        var customInput = sel.nextElementSibling;
        sel.addEventListener('change', function () {
            if (this.value) {
                customInput.value = '';
            }
        });
        customInput.addEventListener('input', function () {
            if (this.value) {
                sel.value = '';
            }
        });
    });
    // Before submitting acls form, copy custom values to the select name
    document.getElementById('form-acls').addEventListener('htmx:configRequest', function (e) {
        ['read','write','comment'].forEach(function (r) {
            var sel  = document.querySelector('#form-acls [name="acl_' + r + '"]');
            var cust = document.querySelector('#form-acls [name="acl_' + r + '_custom"]');
            if (cust && cust.value.trim()) {
                // rename the select so only the custom value gets submitted
                sel.disabled = true;
                var hidden = document.createElement('input');
                hidden.type  = 'hidden';
                hidden.name  = 'acl_' + r;
                hidden.value = cust.value.trim();
                cust.parentNode.appendChild(hidden);
            }
        });
    });

}());
</script>
