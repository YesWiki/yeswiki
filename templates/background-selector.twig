<h3>{{ _t('TEMPLATE_BG_IMAGE') }}</h3>
<div id="bgCarousel" class="carousel" data-interval="5000" data-pause="true">
    <!-- Carousel items -->
    <div class="carousel-inner">
        {% for row in backgrounds|batch(8) %}

          <div class="item{{ ((favoriteBackgroundImage is empty and loop.first)
            or (favoriteBackgroundImage is not empty and favoriteBackgroundImage in row|map(b => b.file))) ? ' active' : ''}}">
            {% for background in row %}
                {% set choosen = background.file is same as favoriteBackgroundImage %}
                {% if background.kind == 'cover' %}
                    <img loading="lazy" class="bgimg{{ choosen ? ' choosen' : ''}}" src="{{ background.path }}" width="100" height="75"
                      data-yw-background-file="{{ background.file }}" data-yw-background-kind="cover" />
                {% else %}
                    <div class="mozaicimg{{ choosen ? ' choosen' : ''}}" style="background:url({{ background.path }}) repeat top left;"
                      data-yw-background-file="{{ background.file }}" data-yw-background-kind="tile"></div>
                {% endif %}
            {% endfor %}
          </div>
        {% endfor %}
    </div>
    <!-- Carousel nav -->
    <a class="carousel-control left" href="#bgCarousel" data-slide="prev">&lsaquo;</a>
    <a class="carousel-control right" href="#bgCarousel" data-slide="next">&rsaquo;</a>
</div>