{% if arguments.saveButton %}
    {% set action = config['preview_before_save'] ? 'preview' : saveValue %}
    <div class="btn-group">
        <button type="submit"
                name="submit"
                value="{{ action }}"
                class="aceditor-btn-save yw-btn yw-btn--primary">{{ _t("ACEDITOR_SAVE") }}</button>
    </div>
{% endif %}

<div class="btn-group format-menu yw-dropdown">
    <a class="yw-btn" href="#" data-yw-dropdown-toggle>
        {{ _t("ACEDITOR_FORMAT") }}
        <span class="yw-dropdown__caret"></span>
    </a>
    <div class="yw-dropdown__menu yw-format-menu" data-yw-format-menu></div>
</div>

<div class="aceditor-inline-tools" data-yw-inline-tools></div>

<div class="btn-group pages">
    <a title="{{ _t('ACEDITOR_LINK') }}" class="yw-btn aceditor-btn aceditor-btn-link">{{ icon('link') }}</a>
</div>

{{ include("@core/file-picker-button.twig") }}

<div class="btn-group actions-builder-button">
    <button type="button" class="yw-btn aceditor-btn open-actions-builder-btn">
        <svg class="yw-icon" aria-hidden="true">
            <use href="src/assets/icons.svg#layout-grid" />
        </svg>
        <span>{{ _t("ACEDITOR_ACTIONS") }}</span>
    </button>
</div>

<div class="btn-group">
    <a class="yw-btn aceditor-btn aceditor-btn-help"
       data-remote="true"
       href="{{ url({"tag": "ReglesDeFormatage"}) }}"
       title="{{ _t("ACEDITOR_HELP") }}">
        <svg class="yw-icon" aria-hidden="true">
            <use href="src/assets/icons.svg#help-circle" />
        </svg>
    </a>
</div>

<div class="btn-group aceditor-switch-editor">
    <button type="button" class="yw-btn aceditor-btn aceditor-btn-switch-editor"
            title="{{ _t("SWITCH_TO_VISUAL_EDITOR") }}">
        {{ icon('eye') }}
        <span>{{ _t("SWITCH_TO_VISUAL_EDITOR_SHORT") }}</span>
    </button>
</div>
