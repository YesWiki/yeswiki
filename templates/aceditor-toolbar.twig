{# Save Button #}
{% if arguments.saveButton %}
    {% set action = config['preview_before_save'] ? 'preview' : saveValue %}
    <div class="btn-group">
        <button type="submit"
                name="submit"
                value="{{ action }}"
                class="aceditor-btn-save yw-btn yw-btn--primary">{{ _t("ACEDITOR_SAVE") }}</button>
    </div>
{% endif %}
{# Text formatting #}
<div class="btn-group format-menu yw-dropdown">
    <a class="yw-btn" href="#" data-yw-dropdown-toggle>
        {{ _t("ACEDITOR_FORMAT") }}
        <span class="yw-dropdown__caret"></span>
    </a>
    <ul class="yw-dropdown__menu">
        <li>{{ _self.button('title1', '') }}</li>
        <li>{{ _self.button('title2', '') }}</li>
        <li>{{ _self.button('title3', '') }}</li>
        <li>{{ _self.button('title4', '') }}</li>
        <li class="yw-dropdown__divider"></li>
        <li>{{ _self.button('center', '') }}</li>
        <li>{{ _self.button('lead', '') }}</li>
        <li>{{ _self.button('highlight', '') }}</li>
        <li>{{ _self.button('code', '') }}</li>
        <li>{{ _self.button('inline_code', '') }}</li>
        <li>{{ _self.button('comment', '') }}</li>
        <li class="yw-dropdown__divider"></li>
        {# Markup syntax, so the toolbar is where they live rather than the components
           palette -- ADR-0017. Beside `comment` and `highlight`, which are the same kind of
           thing and have always been here. #}
        <li>{{ _self.calloutButton('info') }}</li>
        <li>{{ _self.calloutButton('success') }}</li>
        <li>{{ _self.calloutButton('warning') }}</li>
        <li>{{ _self.calloutButton('danger') }}</li>
    </ul>
</div>
<div class="btn-group format-buttons">
    {{ _self.button("bold") }}
    {{ _self.button("italic") }}
    {{ _self.button("underline") }}
    {{ _self.button("strike") }}
</div>
<div class="btn-group more-styles">
    {{ _self.button("list") }}
    {{ _self.button("line") }}
</div>
<div class="btn-group pages">{{ _self.button("link") }}</div>
{# Upload file #}
{{ include("@core/file-picker-button.twig") }}
{# Actions builder. One button, not a menu: choosing what to insert happens in the rail's
   palette, where every component is visible at once and searchable, rather than in a
   dropdown that only listed the groups. This button only ADDS -- editing a component
   already written is done by putting the cursor in it, see javascripts/aceditor.js. #}
<div class="btn-group actions-builder-button">
    <button type="button" class="yw-btn aceditor-btn open-actions-builder-btn">
        <svg class="yw-icon" aria-hidden="true">
            <use href="src/assets/icons.svg#layout-grid" />
        </svg>
        <span>{{ _t("ACEDITOR_ACTIONS") }}</span>
    </button>
</div>
{# Help #}
<div class="btn-group">
    <a class="yw-btn aceditor-btn aceditor-btn-help"
       data-remote="true"
       href="{{ url({"tag": "ReglesDeFormatage"}) }}"
       title="{{ _t("ACEDITOR_HELP") }}">
        <svg class="yw-icon" aria-hidden="true">
            <use href="src/assets/icons.svg#help-circle" />
        </svg>
    </a>
</div>
{# PROTOTYPE: leave for the editor that shows the page rather than its source. Last, and
   floated to the far end of the bar: it is not one of the things you do to what you are
   writing. See javascripts/editor-switch.js. #}
<div class="btn-group aceditor-switch-editor">
    <button type="button" class="yw-btn aceditor-btn aceditor-btn-switch-editor"
            title="{{ _t("SWITCH_TO_VISUAL_EDITOR") }}">
        <svg class="yw-icon" aria-hidden="true">
            <use href="src/assets/icons.svg#arrows-horizontal" />
        </svg>
    </button>
</div>
{% macro button(name, btnClass = 'yw-btn') %}
    {% set DELIMITERS = {
        "TITLE1": {
            "yeswiki": [
                "# ",
                ""
            ],
            "html": [
                "<h1>",
                "</h1>"
            ]
        },
        "TITLE2": {
            "yeswiki": [
                "## ",
                ""
            ],
            "html": [
                "<h2>",
                "</h2>"
            ]
        },
        "TITLE3": {
            "yeswiki": [
                "### ",
                ""
            ],
            "html": [
                "<h3>",
                "</h3>"
            ]
        },
        "TITLE4": {
            "yeswiki": [
                "#### ",
                ""
            ],
            "html": [
                "<h4>",
                "</h4>"
            ]
        },
        "CENTER": {
            "yeswiki": [
                "<center>",
                "</center>"
            ],
            "html": [
                "<center>",
                "</center>"
            ]
        },
        "LEAD": {
            "yeswiki": [
                "<div class=\"lead\">",
                "</div>"
            ],
            "html": [
                "<div class=\"lead\">",
                "</div>"
            ]
        },
        "HIGHLIGHT": {
            "yeswiki": [
                "{{ section bgcolor=\"var(--yw-primary)\" class=\"\" pattern=\"border-solid\" }}",
                "{{ end elem=\"section\" }}"
            ],
            "html": [
                "<div class=\"well\">",
                "</div>"
            ]
        },
        "CODE": {
            "yeswiki": [
                "```",
                "```"
            ],
            "html": [
                "<pre>",
                "</pre>"
            ]
        },
        "INLINE_CODE": {
            "yeswiki": [
                "`",
                "`"
            ],
            "html": [
                "<code>",
                "</code>"
            ]
        },
        "COMMENT": {
            "yeswiki": [
                "{#",
                "#}"
            ]
        },
        "BOLD": {
            "yeswiki": [
                "**",
                "**"
            ],
            "icon": "bold"
        },
        "ITALIC": {
            "yeswiki": [
                "*",
                "*"
            ],
            "icon": "italic"
        },
        "UNDERLINE": {
            "yeswiki": [
                "<u>",
                "</u>"
            ],
            "icon": "underline"
        },
        "STRIKE": {
            "yeswiki": [
                "~~",
                "~~"
            ],
            "icon": "strikethrough"
        },
        "LIST": {
            "yeswiki": [
                "- ",
                ""
            ],
            "icon": "list"
        },
        "LINE": {
            "yeswiki": [
                "\n------\n",
                ""
            ],
            "icon": "minus"
        },
        "LINK": {
            "icon": "link"
        },
        "NEWPAGE": {
            "icon": "square-plus"
        }
    } %}
        {% set syntax = DELIMITERS[name|upper] %}
        {% set label = _t('ACEDITOR_' ~ name|upper) %}
        <a title="{{ label }}"
           class="{{ btnClass }} aceditor-btn aceditor-btn-{{ name }}"
           data-lft="{{ syntax.yeswiki|first }}"
           data-rgt="{{ syntax.yeswiki|last }}">
            {% if syntax.icon %}
                {{ icon(syntax.icon) }}
            {% else %}
                {{ (syntax.html|first ~ label ~ syntax.html|last)|raw }}
            {% endif %}
        </a>
    {% endmacro %}

{# A callout is not a pair of delimiters wrapped around a selection: pressing one while the
   cursor is already inside a callout must CHANGE it rather than nest a second one in the
   first, the way a heading level does. So it carries its type and javascripts/aceditor.js
   does the rest -- see AceWrapper.applyCallout(). #}
{% macro calloutButton(type) %}
    <a href="#" class="yw-btn aceditor-btn aceditor-btn-callout"
       data-callout="{{ type }}"
       title="{{ _t('ALERT_' ~ type|upper) }}">{{ _t('ALERT_' ~ type|upper) }}</a>
{% endmacro %}
