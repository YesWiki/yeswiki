<!-- FORM SIGN UP -->
<h2>{{ _t('USER_SIGN_UP') }}</h2>
<form action="{{ url({tag:''}) }}" method="post" class="">
  <input type="hidden" name="usersettings_action" value="signup" />
  {% if error is not empty %}
    {% if error matches '/<div[^>]*class\="alert.*/' %}
      {{ error|raw }}
    {% else %}
      <div class="alert alert-danger">{{ error }}</div>          
    {% endif %}
  {% endif %}
  <div class="yw-form-group">
  <label class="yw-form-label">{{ _t('USER_USERNAME') }}
    <span class='form-help fa fa-question-circle'
      title="{{ _t('USERNAME_MUST_BE_WIKINAME') }}"
      data-tooltip="tooltip">
    </span>
  </label>
  <div class="controls">
    <input class="yw-input" name="name" size="40" value="{{ name }}" 
      pattern="{{ regexUserName | raw}}"/>{# pattern for valid user name #}
  </div>
</div>
<div class="yw-form-group">
  <label class="yw-form-label">{{ _t('USER_EMAIL_ADDRESS') }}</label>
  <div class="controls">
    <input class="yw-input" name="email" size="40" value="{{ email }}" 
      pattern="[!#-'*+/-9=?A-Za-z^-~-]+(?:\.[!#-'*+/-9=?A-Z^-~-]+)*@(?:[!#-'*+/-9=?A-Z^-~-]+\.[!#-'*+/-9=?A-Z^-~-]+)*"/>
    {# pattern inspired from RFC 5322  #}
  </div>
</div>
<div class="yw-form-group">
  <label class="yw-form-label">{{ _t('USER_PASSWORD') }}</label>
  <div class="controls">
    <input class="yw-input" type="password" name="password" size="40"/>
  </div>
</div>
<div class="yw-form-group">
  <label class="yw-form-label">{{ _t('USER_PASSWORD_CONFIRMATION') }}</label>
  <div class="controls">
    <input class="yw-input" type="password" name="confpassword" size="40" />
  </div>
</div>
{{ captcha|raw }}
<div class="yw-form-group">
  <div class="controls">
    <input class="btn btn-block btn-primary" type="submit" value="{{ _t('USER_NEW_ACCOUNT')|e('html_attr') }}" size="40" />
  </div>
</div>
</form>

<hr>

<button class="btn btn-block btn-default" onclick="document.querySelector('a[href=\'#LoginModal\']').click()">
  {{ _t('LOGIN_LOGIN') }}
</button>
