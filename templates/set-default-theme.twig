<p>{{ _t('SETDEFAULTTHEME_HNIT') }}</p>
<form method='post' class=''>
  <input class='hide' name='action' value='setTemplate'>
  {{ include('@core/theme-selector.twig',{sizeClass:'col-lg-4'}) }}
  <div class='yw-form-group'>
    <div class="controls">
      <input
        type='submit' 
        class="btn btn-primary" 
        value="{{ _t('TEMPLATE_APPLY') }}"
        {% if isHibernated %}disabled data-toggle="tooltip" data-placement="bottom" title="{{ _t('WIKI_IN_HIBERNATION') }}"{% endif %}
        />
    </div>
  </div>
</form>