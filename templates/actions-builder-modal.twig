<div class="yw-modal" id="actions-builder-modal" tabindex="-1" role="dialog">
  <div class="yw-modal__dialog yw-modal__dialog--lg">
    <div class="yw-modal__content" id="actions-builder-app">
      <div class="yw-modal__header">
        <h2 class="yw-modal__title" v-text="actionGroup ? actionGroup.label : ''"></h2>
        <button type="button" class="yw-close" data-yw-dismiss="modal" aria-label="close">&times;</button>
      </div>

      <!-- Modal Body -->
      <div class="yw-modal__body">
        <!-- Choose form (only for bazar actions) -->
        <div v-if="needFormField" class="yw-form-group">
          <label class="yw-form-label">{{ _t('ACTION_BUILDER_CHOOSE_FORM') }}</label>
          <select :value="getSelectedFormId()" required class="yw-input" @change="setSelectedFormId" ref="formSelection">
            <option v-for="(name, id) in formIds" :value="id" v-text="name"></option>
          </select>
          <span v-if="isBazarListeAction" class="text-muted">{{ _t('ACTION_BUILDER_SEVERAL_FORMS_HINT')|raw }}</span>
        </div>

        <!-- Choose Action -->
        <div class="yw-form-group" v-show="Object.keys(this.actions).length > 1">
          <label class="yw-form-label" v-text="isBazarListeAction ? '{{ _t('ACTION_BUILDER_CHOOSE_TEMPLATE') }}' : '{{ _t('ACTION_BUILDER_CHOOSE_ACTION') }}'"></label>
          <select v-model="selectedActionId" required class="yw-input">
            <template v-for="(action, actionId) in actions">
              <option v-if="action && action.label" :key="actionId" :value="actionId" v-html="action.label"></option>
            </template>
          </select>
        </div>

        <!-- Action Configuration -->
        <div v-if="selectedAction && (!needFormField || selectedForms)" class="action-parameters-container">

          <div v-if="selectedAction.hint" class="alert alert-info" v-html="selectedAction.hint"></div>

          <!-- Iframe Preview -->
          <preview-action :wiki-code="wikiCodeForIframe" :height="actionGroup ? actionGroup.previewHeight : null"></preview-action>

          <div class="panels-config-container">
            <div v-for="panel in configPanels" class="config-panel" :class="panel.params.class" 
                 :style="{width: panel.params.width || (configPanels.length == 1 ? '50%' : '33%')}" v-show="checkVisibility(panel.params)">
              <h3 v-text="panel.params.title || '{{ _t('ACTION_BUILDER_PARAMETERS') }}'"></h3>
              <div class="config-panel-content">
                <template v-for="(config, propName) in panel.params.properties" :key="propName">
                  <div v-html="config.intro" v-show="checkVisibility(config)"></div>
                  <component :is="componentIdFrom(config)" :ref="refFrom(config)"
                             :value="values[propName]" v-on:input="updateValue(propName, $event)"
                             v-show="checkVisibility(config)"
                             :name="propName" :values="values"
                             :config="config" :selected-forms="selectedForms">
                  </component>
                </template>
              </div>
            </div>
          </div>

          <!-- Advanced Params Checkbox -->
          <input-checkbox v-if="isSomeAdvancedParams" :value="displayAdvancedParams" @input="displayAdvancedParams = $event"
                          :config="{label: '{{ _t('ACTION_BUILDER_ADVANCED_PARAMETERS') }}'}"
                          class="advanced-params">
          </input-checkbox>

          <div class="col-md-12 result-container">
            <h3>{{ _t('ACTION_BUILDER_WIKI_CODE_TITLE') }}</h3>
            <wiki-code-input :action-params="actionParams" :is-editing="isEditingExistingAction"
                             :editor="editor" :wiki-code="wikiCode"></wiki-code-input>
          </div>
        </div>
      </div>

      <div class="yw-modal__footer">
        <button type="button" class="yw-btn yw-btn--block" data-yw-dismiss="modal">Close</button>
      </div>

    </div>
  </div>
</div>

{{ include_css('styles/vendor/leaflet/leaflet.css') }}
{{ include_javascript('javascripts/vendor/leaflet/leaflet.min.js') }}

{{ include_javascript(config.debug ? 'javascripts/vendor/vue/vue.js' : 'javascripts/vendor/vue/vue.min.js') }}

{{ include_javascript('javascripts/vendor/vue-select/vue-select.min.js') }}
{{ include_css('styles/vendor/vue-select/vue-select.css') }}

{{ include_javascript('javascripts/actions-builder.js', false, true) }}
{{ include_css('styles/actions/actions-builder.css') }}
