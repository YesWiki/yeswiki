<form class="{{ class }}" method="get" action="{{ url }}">
	<div class="btn-group">	
		<div class="input-append">
			<input type="text" class="input-small search-query" placeholder="{{ _t('TEMPLATE_SEARCH_PLACEHOLDER') }}" value="{{ phrase }}" title="{{ _t('TEMPLATE_SEARCH_INPUT_TITLE') }}" accesskey="C" tabindex="1" name="phrase" />
			<button type="submit" class="btn btn-default search-btn{{ btnclass }}"><i class="fa fa-search {{ iconclass }}"></i>&nbsp;</button>
		</div>
	</div>
	<input type="hidden" value="RechercheTexte" name="wiki" />
</form>
