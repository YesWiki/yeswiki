{% extends "@core/account/guest-layout.twig" %}

{# The action titles itself ("reset your password"), which is more specific than anything
   this screen would put above it -- but unlike the signup form it offers no way back, so
   the link stays. #}
{% block dashboard_content %}
  {{ renderAction('lostpassword')|raw }}
  <p class="yw-account__aside">
    <a href="{{ url({ tag: 'user' }) }}">{{ _t('ACCOUNT_BACK_TO_LOGIN') }}</a>
  </p>
{% endblock %}
