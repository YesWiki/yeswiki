{% extends "@core/dashboard/layout.twig" %}

{# What you wrote, and what you changed -- two questions close enough to answer on one
   screen: `{{mypages}}` is what you own, `{{mychanges}}` is where you have been. #}
{% block dashboard_content %}
  <h1>{{ _t('ACCOUNT_PAGES') }}</h1>

  <section class="yw-account__section">
    <h2>{{ _t('ACCOUNT_PAGES_OWNED') }}</h2>
    {{ renderAction('mypages')|raw }}
  </section>

  <section class="yw-account__section">
    <h2>{{ _t('ACCOUNT_PAGES_CHANGES') }}</h2>
    {{ renderAction('mychanges')|raw }}
  </section>
{% endblock %}
