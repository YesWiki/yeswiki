{{ include_css('styles/yw-entries.css') }}
<div class="yw-search" id="yw-search">
    {% set htmxTarget = {
        'hx-get': apiUrl,
        'hx-target': '#yw-search-results',
        'hx-include': '#yw-search-form',
        'hx-indicator': '#yw-search-spinner'
    } %}
    {% set hidden = [{ name: 'limit', value: limit }] %}
    {% if tags is defined and tags is not empty %}{% set hidden = hidden|merge([{ name: 'tags', value: tags }]) %}{% endif %}
    {% if not showFilters %}{% set hidden = hidden|merge([{ name: 'type', value: type }, { name: 'facets', value: '0' }]) %}{% endif %}

    {{ include('@core/_list_toolbar.twig', {
        id: 'yw-search-form',
        inputId: 'yw-search-phrase',
        action: url({ tag: 'search' }),
        formAttrs: { onsubmit: 'return false;' },
        hidden: hidden,
        searchName: 'q',
        keywords: phrase,
        autofocus: autofocus,
        spinnerId: 'yw-search-spinner',
        sort: sort,
        sortDefaultLabel: _t('SORT_RELEVANCE'),
        display: display,
        switcher: switcher,
        facets: '<div id="yw-search-facets" class="yw-list-toolbar__facets"></div>',
        exports: '<div id="yw-search-export" class="yw-list-toolbar__export"></div>',
        inputAttrs: htmxTarget|merge({ 'hx-trigger': 'input changed delay:300ms, search' }),
        controlAttrs: htmxTarget|merge({ 'hx-trigger': 'change' }),
        buttonAttrs: htmxTarget,
    }) }}

    <div class="yw-search-body">
        <div id="yw-search-results"
             class="yw-search-results-container"
             aria-live="polite"
             hx-get="{{ apiUrl }}"
             hx-include="#yw-search-form"
             hx-vals='{{ { type: type, form: form|default('') }|json_encode|e('html_attr') }}'
             hx-indicator="#yw-search-spinner"
             hx-disinherit="*"
             hx-trigger="load, revealed">
        </div>
    </div>
</div>
