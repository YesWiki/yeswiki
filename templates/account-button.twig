{% if class is empty %}
    {% block main %}
        {% set label = connected ? _t('LOGIN_CONNECTED_AS') ~ ' ' ~ user : _t('LOGIN_LOGIN') %}
        <a class="navbar-btn account-link {{ not nobtn ? 'yw-btn ' ~ btnclass : '' }}"
           href="{{ connected ? url({"tag": "user"}) : accounturl }}"
           title="{{ label }}"
           aria-label="{{ label }}">
            {%- if connected -%}
                {% include '@core/_avatar.twig' with { avatar: avatar } only %}
            {%- else -%}
                {{ icon("user") }}
            {%- endif -%}
        </a>
    {% endblock %}
{% else %}
    <div class="{{ class }}">{{ block("main") }}</div>
{% endif %}
