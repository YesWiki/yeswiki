
<div class="{{ class }}">
    {% if linkedit is defined %}
        <nav class="yw-page-actions" aria-label="{{ _t("TEMPLATE_EDIT_THIS_PAGE") }}">
            <a title="{{ _t("TEMPLATE_EDIT_THIS_PAGE") ~ ' ' ~ page }}"
               href="{{ linkedit }}"
               class="yw-btn yw-page-actions__edit link-edit">
                {{ icon('pencil') }}
                <span>{{ _t("TEMPLATE_EDIT_THIS_PAGE") }}</span>
            </a>
            <div class="yw-page-actions__more">
                {% if userIsAdmin %}
                    <a title="{{ _t("TEMPLATE_DUPLICATE_PAGE") ~ ' ' ~ page }}"
                       href="{{ linkduplicate }}"
                       class="yw-btn yw-btn--sm link-duplicate">
                        {{ icon('copy') }}
                        <span>{{ _t("TEMPLATE_DUPLICATE") }}</span>
                    </a>
                {% endif %}
                <a title="{{ _t("TEMPLATE_SEE_SHARING_OPTIONS") ~ ' ' ~ page }}"
                   href="{{ linkshare }}"
                   class="yw-btn yw-btn--sm link-share modalbox">
                    {{ icon('share') }}
                    <span>{{ _t("TEMPLATE_SHARE") }}</span>
                </a>
                {% if currentuser is not empty %}
                    {{ include_javascript("javascripts/favorites.js") }}
                    <a href="#"
                       title="{{ (isUserFavorite) ? _t("FAVORITES_REMOVE") : _t('FAVORITES_ADD') }}"
                       data-resource="{{ page }}"
                       data-user="{{ currentuser }}"
                       class="yw-btn yw-btn--sm favorites{{ (isUserFavorite) ? ' user-favorite' : '' }}">
                        {{ (isUserFavorite) ? icon("star-filled") : icon('star') }}
                        <span>{{ (isUserFavorite) ? _t("FAVORITES_REMOVE") : _t('FAVORITES_ADD') }}</span>
                    </a>
                {% endif %}
                {% if linkdeletepage is defined %}
                    <a href="{{ linkdeletepage }}"
                       title="{{ _t("TEMPLATE_DELETE_PAGE") ~ ' ' ~ page }}"
                       class="yw-btn yw-btn--sm yw-btn--danger link-deletepage modalbox">
                        {{ icon('trash') }}
                        <span>{{ _t("TEMPLATE_DELETE") }}</span>
                    </a>
                {% endif %}
            </div>
        </nav>
    {% endif %}

    <div class="yw-page-info">
        <div class="yw-page-info__facts">

            {% set showAuthor = userIsAdmin and author is not empty %}
            {% if showAuthor or linkedit is defined or linkacls is defined or linkclosecomments is defined or linkopencomments is defined %}
                <div class="yw-page-info__line">

                    {% if linkedit is defined %}
                        <a class="link-edit"
                           href="{{ linkedit }}"
                           title="{{ _t("TEMPLATE_EDIT_THIS_PAGE") ~ ' ' ~ page }}">
                            {{ icon('pencil') }}
                            <span>{{ _t("TEMPLATE_EDIT") }}</span>
                        </a>
                    {% endif %}
                    {% if userIsAdmin and linkduplicate is defined %}
                        <a class="link-duplicate"
                           href="{{ linkduplicate }}"
                           title="{{ _t("TEMPLATE_DUPLICATE_PAGE") ~ ' ' ~ page }}">
                            {{ icon('copy') }}
                            <span>{{ _t("TEMPLATE_DUPLICATE") }}</span>
                        </a>
                    {% endif %}

                    {% if linkdeletepage is defined %}
                        <a class="link-deletepage yw-page-info__danger modalbox"
                           href="{{ linkdeletepage }}"
                           title="{{ _t("TEMPLATE_DELETE_PAGE") ~ ' ' ~ page }}">
                            {{ icon('trash') }}
                            <span>{{ _t("TEMPLATE_DELETE") }}</span>
                        </a>
                    {% endif %}
                    {% if showAuthor %}
                        <span class="yw-page-info__author">
                            {{ _t("BAZ_ECRITE") }} {{ author }}{% if contentLabel is not empty %} <span class="yw-page-info__type">({{ contentLabel }})</span>{% endif %}
                        </span>
                    {% endif %}
                    {% if linkacls is defined %}
                        <a class="link-acls{{ linkacls|slice(-4) == 'acls' ? ' modalbox': '' }}"
                           href="{{ linkacls }}"
                           title="{{ _t("TEMPLATE_CLICK_TO_CHANGE_PERMISSIONS") ~ ' ' ~ page }}">
                            {{ icon('lock-open') }}
                            <span>{{ owner ?? '' }}</span>
                        </a>
                    {% endif %}
                    {% if linkclosecomments is defined %}
                        <a class="link-comments"
                           href="{{ linkclosecomments }}"
                           title="{{ _t("TEMPLATE_CLICK_TO_CLOSE_COMMENTS") }}">
                            {{ icon('message-circle-off') }}
                            <span>{{ _t("TEMPLATE_CLOSE_COMMENTS") }}</span>
                        </a>
                    {% endif %}
                    {% if linkopencomments is defined %}
                        <div class="dropup">
                            <a href="#"
                               class="link-comments dropdown-toggle"
                               id="opencommentsdropup"
                               data-toggle="dropdown"
                               aria-haspopup="true"
                               aria-expanded="false">
                                {{ icon('message-circle') }}
                                <span>{{ _t("TEMPLATE_OPEN_COMMENTS") }}</span>
                                <span class="caret"></span>
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="opencommentsdropup">
                                <li>
                                    <a href="{{ linkopencomments ~ '&list=' ~ ('+')|e("url") }}">{{ _t("TEMPLATE_FOR_CONNECTED_PEOPLE") }}</a>
                                </li>
                                {% for g in wikigroups %}
                                    <li>
                                        <a href="{{ linkopencomments ~ '&list=' ~ g }}">{{ _t("TEMPLATE_FOR_MEMBERS_OF_GROUP") }} {{ g }}</a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}
                </div>
            {% endif %}
            {% if createdAt is not empty or updatedAt is not empty or time is defined %}
                <div class="yw-page-info__line">
                    {% if createdAt is not empty %}
                        <span class="date_creation">{{ _t("BAZ_DATE_CREATION")|capitalize }} {{ createdAt }}</span>
                    {% endif %}

                    {% if time is defined %}
                        <a title="{{ _t("TEMPLATE_CLICK_TO_SEE_REVISIONS") ~ ' ' ~ page }}"
                           href="{{ linkrevisions }}"
                           class="link-revisions">
                            {{ icon('history') }}
                            <span>{{ _t("TEMPLATE_LAST_UPDATE") }} {{ updatedAt is not empty ? updatedAt : time }}</span>
                        </a>
                    {% elseif updatedAt is not empty %}
                        <span class="date_mise_a_jour">{{ _t("BAZ_DATE_MAJ")|capitalize }} {{ updatedAt }}</span>
                    {% endif %}
                </div>
            {% endif %}
        </div>

        {% if linkedit is not defined %}
        <div class="yw-page-info__actions">
            <a title="{{ _t("TEMPLATE_SEE_SHARING_OPTIONS") ~ ' ' ~ page }}"
               href="{{ linkshare }}"
               class="link-share modalbox">
                {{ icon('share') }}
                <span>{{ _t("TEMPLATE_SHARE") }}</span>
            </a>
            {% if currentuser is not empty %}
                {{ include_javascript("javascripts/favorites.js") }}
                <a href="#"
                   title="{{ (isUserFavorite) ? _t("FAVORITES_REMOVE") : _t('FAVORITES_ADD') }}"
                   data-resource="{{ page }}"
                   data-user="{{ currentuser }}"
                   data-toggle="tooltip"
                   data-placement="top"
                   class="btn-icon favorites{{ (isUserFavorite) ? ' user-favorite' : '' }}">
                    {{ (isUserFavorite) ? icon("star-filled") : icon('star') }}
                    <span class="sr-only sr-only-focusable">{{ (isUserFavorite) ? _t("FAVORITES_REMOVE") : _t('FAVORITES_ADD') }}</span>
                </a>
            {% endif %}
        </div>
        {% endif %}
    </div>
</div>
