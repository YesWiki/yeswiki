

{% if errors is not empty %}
<div class="yw-alert yw-alert--warning" role="alert">
    <button type="button" class="yw-close" data-yw-dismiss="alert">&times;</button>
    <strong><svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#alert-triangle"/></svg> {{ _t('ADMIN_CONTENT_BULK_RESULT_PARTIAL_FAILURE') }}</strong>
    {% if success is not empty %}
     — {{ _t('ADMIN_CONTENT_BULK_RESULT_PARTIAL_UPDATED')|replace({'{success}': success|length, '{errors}': errors|length}) }}
    {% else %}
     — {{ _t('ADMIN_CONTENT_BULK_RESULT_ERRORS')|replace({'{errors}': errors|length}) }}
    {% endif %}
    <ul style="margin-top:6px;margin-bottom:0;padding-left:18px;">
        {% for e in errors %}
        <li>{{ e }}</li>
        {% endfor %}
    </ul>
</div>
{% endif %}

{% if success is not empty %}
<div class="yw-alert yw-alert--success" role="alert">
    <button type="button" class="yw-close" data-yw-dismiss="alert">&times;</button>
    <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#circle-check"/></svg>
    {% if action == 'delete' %}
        {{ _t('ADMIN_CONTENT_BULK_RESULT_DELETED')|replace({'{success}': success|length}) }}
    {% elseif action == 'change-acls' %}
        {{ _t('ADMIN_CONTENT_BULK_RESULT_ACLS')|replace({'{success}': success|length}) }}
    {% elseif action == 'change-theme' %}
        {{ _t('ADMIN_CONTENT_BULK_RESULT_THEME')|replace({'{success}': success|length}) }}
    {% else %}
        {{ _t('ADMIN_CONTENT_BULK_RESULT_UPDATED')|replace({'{success}': success|length}) }}
    {% endif %}
</div>
{% endif %}
