{# `{{login template="dropdown.twig"}}`: the form, folded into a dropdown. It extends the
   form rather than the default, which is now the account button and has none of the blocks
   overridden below. #}
{% extends "@core/login-form.twig" %}

{% block connected %}
    <button data-toggle="dropdown" class="btn btn-default dropdown-toggle {{ btnclass }}"><svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#user"/></svg> {{ user }} <span class="caret"></span></button>
    <ul class="dropdown-menu">
        {{ block('loginActions') }}
    </ul>
{% endblock %}

{% block formClass %}login-form-dropdown{% endblock %}
{% block formTitle %}<h4 class="text-center">{{ _t('LOGIN_LOGIN') }}</h4>{% endblock %}

{% block wikiNameInputGroup %}
    <div class="yw-form-group">
        <input id="inputWikiName" class="yw-input" type="text" name="name" value="{{user ? user|e('html_attr') : '' }}" required required placeholder="{{ _t('LOGIN_WIKINAME') }}"/>
    </div>
{% endblock %}
{% block passwordInputGroup %}
    <div class="yw-form-group">
        <input id="inputPassword" class="yw-input" name="password" type="password" required placeholder="{{ _t('LOGIN_PASSWORD') }}"/>
    </div>
{% endblock %}

{% block notConnected %}
    <button data-toggle="dropdown" class="btn btn-default dropdown-toggle {{ btnclass }}"><svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#user"/></svg> {{ _t('LOGIN_LOGIN') }} <span class="caret"></span></button>
    <div class="dropdown-menu">
        {{ block('form') }}
    </div>
{% endblock %}