
{% extends "@core/login-form.twig" %}

{% block connected %}
    <div class="yw-dropdown">
        <button type="button" class="yw-btn {{ btnclass }}" data-yw-dropdown-toggle aria-haspopup="true" aria-expanded="false">{{ icon('user') }} {{ user }} <span class="yw-dropdown__caret"></span></button>
        <ul class="yw-dropdown__menu">
            {{ block('loginActions') }}
        </ul>
    </div>
{% endblock %}

{% block formClass %}login-form-dropdown{% endblock %}
{% block formTitle %}<h4 class="text-center">{{ _t('LOGIN_LOGIN') }}</h4>{% endblock %}

{% block wikiNameInputGroup %}
    <div class="yw-form-group">
        <input id="inputWikiName" class="yw-input" type="text" name="name" value="{{user ? user|e('html_attr') : '' }}" required required placeholder="{{ _t('LOGIN_WIKINAME') }}"/>
    </div>
{% endblock %}
{% block passwordInputGroup %}
    <div class="yw-form-group">
        <input id="inputPassword" class="yw-input" name="password" type="password" required placeholder="{{ _t('LOGIN_PASSWORD') }}"/>
    </div>
{% endblock %}

{% block notConnected %}
    <div class="yw-dropdown">
        <button type="button" class="yw-btn {{ btnclass }}" data-yw-dropdown-toggle aria-haspopup="true" aria-expanded="false">{{ icon('user') }} {{ _t('LOGIN_LOGIN') }} <span class="yw-dropdown__caret"></span></button>
        <div class="yw-dropdown__menu">
            {{ block('form') }}
        </div>
    </div>
{% endblock %}