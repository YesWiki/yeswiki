<ul class="grid-elements">
{% for tag, element in elements %}
	<li class="page-element gradient-grid-box {{ element.tagnames }}">
		<a href="{{ url({tag: tag}) }}" target="_blank" rel="noopener noreferrer">
			<h3 class="page-title">{{ element.title|raw }}</h3>
    		<div class="page-image-container">{{ element.image|raw }}</div>
    	</a>
    </li> <!-- /.page-element -->
{% endfor %}
</ul>

<style>
.grid-elements { position:relative; }
.grid-elements, .grid-elements * {	 
	-moz-box-sizing: border-box; 
	-webkit-box-sizing: border-box; 
	box-sizing: border-box; 
}

.gradient-grid-box {
    width:280px;
	display: inline-block;
	margin: 0 15px 15px 0; 
	padding: 8px; 
	border: 2px solid #FAFAFA; 
	box-shadow: 0 1px 2px rgba(34, 25, 25, 0.4); 
	background: #FEFEFE; background-image: linear-gradient(45deg, #FFF, #F9F9F9);
	-webkit-transition: all 0.2s ease-out;
       -moz-transition: all 0.2s ease-out;
         -o-transition: all 0.2s ease-out;
            transition: all 0.2s ease-out;
}
.gradient-grid-box:hover { 
  cursor: pointer;
  -webkit-box-shadow: 0px 0px 10px rgba(34, 25, 25, 0.6);
  -moz-box-shadow: 0px 0px 10px rgba(34, 25, 25, 0.6);
  box-shadow: 0px 0px 10px rgba(34, 25, 25, 0.6);
}

.page-title {  
  font-size: 16px;
  line-height: 20px;
  margin: 0 0 7px;
}
.page-image-container {text-align: center;}
</style>
