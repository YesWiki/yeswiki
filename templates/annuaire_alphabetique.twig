{% if fiches|length > 0 %}

<div id="lettres_init" class="text-center">
  <!-- Alphabet cliquable pour aller sur les ancres des différentes lettres -->
  {% for letter in 'abcdefghijklmnopqrstuvwxyz'|split('') %}
  <a href="#lettre_{{ letter }}"> {{ letter }} </a>
  {% endfor %}
</div>

<p class="wrapper_nombre_membres">
  <span class="nombre_membres">{{ fiches|length }} {{ _t('BAZ_MEMBERS') }}</span>
</p>

<div class="annuaire-fiches-container">

{% set curChar = '' %}
{% for fiche in fiches %}
  {% set titre = fiche.bf_titre|trim %}
  {% set firstChar = removeAccents(titre)|slice(0, 1)|lower %}
  {% if curChar is empty or firstChar != curChar %}
    <div class="clearfix"></div>
    <div class='letter-title' id='lettre_{{ firstChar }}'>
      <span>{{ firstChar }}</span>
    </div>
    {% set curChar = firstChar %}
  {% endif %}
{{ pager_links|raw }}
  <a class="nom bazar-entry modalbox" {{ fiche.html_data|raw }}
    href="{{ fiche.url|raw }}{{ fiche['external-data'] is defined
        ? '/iframe" data-iframe="1" title="' ~ fiche.bf_titre|striptags
        : '' }}">
    {{ titre|raw }}
  </a>
{% endfor %}
</div>

<div class="clearfix"></div>

<style>
  .nom {
    display:block;
  }
  @media (min-width: 700px) {
    .nom {
      float: left;
      width: 49%;
      margin-right: 1%;
    }
  }
  .wrapper_nombre_membres {
    background: none repeat scroll 0 0 #fafafa;
    margin-top: 4px;
    text-align: center;
    font-style:italic;
  }
  #lettres_init a {
    text-transform:uppercase;
    display: inline-block;
    margin: 0 8px;
  }
  .letter-title {
    font-weight: bold;
    margin-top: 2rem;
    text-transform: uppercase;
  }

</style>
{% endif %}
{{ pager_links|raw }}
