

{% if arguments.saveButton %}
  <button type="submit" name="submit" hidden
          value="{{ config['preview_before_save'] ? 'preview' : saveValue }}"
          class="vditor-wiki-save">{{ _t("ACEDITOR_SAVE") }}</button>
{% endif %}

<textarea id="{{ arguments.name }}" name="{{ arguments.name }}"
          {% if arguments.maxChars %}maxlength="{{ arguments.maxChars }}"{% endif %}
          rows="{{ arguments.rows }}"
          placeholder="{{ arguments.placeholder }}"
          data-vditor-lang="{{ vditorLang }}"
          {% if arguments.required is not empty %}required{% endif %}
          class="vditor-wiki">
  {{- arguments.value|raw -}}
</textarea>

<script>
  // read by the actions builder, which is the same Vue app the ACeditor opens
  var actionsBuilderData = {{ actionsBuilderData|json_encode|raw }};
  var pageTags = {{ pageTags|json_encode|raw }}
</script>

{{ include_javascript(config.debug ? 'javascripts/vendor/vue/vue.js' : 'javascripts/vendor/vue/vue.min.js') }}
{{ include_javascript('javascripts/vendor/vue-select/vue-select.min.js') }}
{{ include_css('styles/vendor/vue-select/vue-select.css') }}

{{ include_javascript('javascripts/vendor/vditor/index.min.js') }}

{{ include_javascript('javascripts/vditor-wiki.js', false, true) }}
{{ include_css('styles/vendor/vditor/index.css') }}

{{ include_css('styles/yw-editor.css') }}
