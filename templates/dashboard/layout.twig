{# The shell every dashboard and admin route renders inside: a left rail of routes, and
   whatever the route put in `dashboard_content` beside it.

   One shell, not one per section, because the sidebar IS the navigation between these
   routes -- a page that rendered its own would drift from the others the first time a
   route was added. Routes are named here once, in `sections` below, and each route tells
   the shell which one it is via `current`.

   Admin entries are declared like any other and filtered on `is_admin`: the routes
   themselves are gated by `acl: ['@admins']`, so this is presentation, not enforcement.
   `scope` says which errand a section belongs to: your account is one thing and the wiki's
   administration is another, so /user lists the account screens and nothing else while the
   dashboard lists the wiki. Both `shell_scope` and `is_admin` come from the DashboardShell
   trait -- derived from the route being rendered, which is why no screen can show one
   section's entries while claiming to be in the other.

   Administration is what is *in* the wiki -- its content, its words, its people. System is
   the wiki itself: the config file, the code, the backups, the bulk in and out, and the
   mess to clean up. Two errands, so two lists rather than one long one.

   The permissions have no entry at all: they render on the Content screen, being
   permissions *over content*. The lists sit with the forms whose fields choose from them,
   and are public like those forms -- what a list says is already visible in every field
   that uses it, and who may change one is ListController's to answer. #}
{% set sections = [
  {
    label: _t('DASHBOARD_SECTION_ACCOUNT'),
    scope: 'account',
    items: [
      { route: 'user',           icon: 'user',          label: _t('ACCOUNT_TITLE') },
      { route: 'user/pages',     icon: 'file',          label: _t('ACCOUNT_PAGES') },
      { route: 'user/entries',   icon: 'list-details',  label: _t('ACCOUNT_ENTRIES') },
      { route: 'user/reactions', icon: 'thumb-up',      label: _t('ACCOUNT_REACTIONS') },
      { route: 'user/logout',    icon: 'logout',        label: _t('LOGIN_LOGOUT') }
    ]
  },
  {
    label: _t('DASHBOARD_SECTION_PUBLIC'),
    scope: 'wiki',
    admin: false,
    items: [
      { route: 'dashboard/activity', icon: 'history',   label: _t('DASHBOARD_ACTIVITY') },
      { route: 'dashboard/forms',    icon: 'briefcase', label: _t('DASHBOARD_FORMS') },
      { route: 'dashboard/lists',    icon: 'list',      label: _t('DASHBOARD_ADMIN_LISTS') },
      { route: 'dashboard/export',   icon: 'download',  label: _t('DASHBOARD_EXPORT') },
      { route: 'doc',                icon: 'help',      label: _t('DASHBOARD_DOC') },
      { route: 'api',                icon: 'code',      label: _t('DASHBOARD_API') }
    ]
  },
  {
    label: _t('DASHBOARD_SECTION_ADMIN'),
    scope: 'wiki',
    admin: true,
    items: [
      { route: 'admin/content',       icon: 'file',        label: _t('DASHBOARD_ADMIN_CONTENT') },
      { route: 'admin/keywords',      icon: 'tags',        label: _t('DASHBOARD_ADMIN_KEYWORDS') },
      { route: 'admin/special-pages', icon: 'layout-grid', label: _t('DASHBOARD_ADMIN_SPECIAL_PAGES') },
      { route: 'admin/appearance',    icon: 'brush',       label: _t('DASHBOARD_ADMIN_APPEARANCE') },
      { route: 'admin/users',         icon: 'user',        label: _t('DASHBOARD_ADMIN_USERS') },
      { route: 'admin/groups',        icon: 'users',       label: _t('DASHBOARD_ADMIN_GROUPS') },
      { route: 'admin/reactions',     icon: 'thumb-up',    label: _t('DASHBOARD_ADMIN_REACTIONS') }
    ]
  },
  {
    label: _t('DASHBOARD_SECTION_SYSTEM'),
    scope: 'wiki',
    admin: true,
    items: [
      { route: 'admin/config',   icon: 'settings', label: _t('DASHBOARD_ADMIN_CONFIG') },
      { route: 'admin/updates',  icon: 'refresh',  label: _t('DASHBOARD_ADMIN_UPDATES') },
      { route: 'admin/backups',  icon: 'database', label: _t('DASHBOARD_ADMIN_BACKUPS') },
      { route: 'admin/imports',  icon: 'upload',   label: _t('DASHBOARD_ADMIN_IMPORTS') },
      { route: 'admin/spam',     icon: 'trash',    label: _t('DASHBOARD_ADMIN_SPAM') }
    ]
  }
] %}

<div class="yw-dashboard">
  <nav class="yw-dashboard__sidebar" aria-label="{{ _t('DASHBOARD_TITLE') }}">
    {% for section in sections %}
      {% if section.scope == shell_scope and (not section.admin or is_admin) %}
        <h2 class="yw-dashboard__section">{{ section.label }}</h2>
        <ul class="yw-dashboard__nav">
          {% for item in section.items %}
            <li>
              <a class="yw-dashboard__link{{ item.route == current ? ' yw-dashboard__link--current' : '' }}"
                 href="{{ url({ tag: item.route }) }}"
                 {{ item.route == current ? 'aria-current="page"' : '' }}>
                {{ icon(item.icon) }}
                <span>{{ item.label }}</span>
              </a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    {% endfor %}
  </nav>

  <div class="yw-dashboard__canvas page">
    {% block dashboard_content %}{% endblock %}
  </div>
</div>

{{ include_css('styles/dashboard.css') }}
