
{% set thumbwidth = params.thumbwidth|default('') is empty ? 155 : params.thumbwidth %}
{% set thumbheight = params.thumbheight|default('') is empty ? 115 : params.thumbheight %}
{% set thumbresize = params.thumbresize|default('') is empty ? 'fit' : params.thumbresize %}
{% set thumbmargin = params.thumbmargin|default('') is empty ? '1' : params.thumbmargin %}
{% set bigwidth = params.bigwidth|default('') is empty ? 1600 : params.bigwidth %}
{% set bigheight = params.bigheight|default('') is empty ? 1200 : params.bigheight %}
{% set bigresize = params.bigresize|default('') is empty ? 'fit' : params.bigresize %}
{% if entries|length > 0 %}

{% set galleryId = params.listindex %}
{{ pager_links|raw }}
<ul id='gallery{{ galleryId }}' class="pbgallery">
{% for entry in entries %}
    {% if entry.imagebf_image is defined and entry.imagebf_image != '' %}
    <li class="bazar-entry" {{ entry.html_data|raw }}>
        <a class="pbgalery-link modalbox" title="{{ entry.title }}"
            href="{{ resizedImage(entry.imagebf_image, bigwidth, bigheight, bigresize, '_') }}">
            <img loading="lazy" alt="" data-pb-captionLink="{{ entry.title }}[{{ url({tag: entry.tag, handler: 'iframe'}) }}]" src="{{ resizedImage(entry.imagebf_image, thumbwidth, thumbheight, thumbresize, '_') }}">
        </a>
    </li>
    {% endif %}
{% endfor %}
</ul>
{{ pager_links|raw }}

{{ include_css('styles/yw-entries.css') }}
<style>
.pbgallery {margin:0;padding:0;}
#gallery{{ galleryId }} li {margin: {{ thumbmargin }}px}
</style>

{% endif %}
{{ pager_links|raw }}
