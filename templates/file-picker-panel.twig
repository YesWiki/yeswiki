

{{ include_css('styles/yw-editor.css') }}
<aside class="yw-designer__sidebar file-picker-panel" id="YesWikiFilePickerPanel" hidden>
  <div class="yw-rail__header">
    <h2 class="yw-rail__title">{{ _t('UPLOAD_FILE') }}</h2>
    <button type="button" class="yw-close" data-yw-file-picker-close aria-label="close">&times;</button>
  </div>
  <div class="file-picker-panel__body">

        <button type="button" class="yw-btn file-picker-upload-open" data-yw-file-picker-upload-open>
          <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#upload"/></svg>
          {{ _t('ATTACH_FILE_PICKER_UPLOAD_NEW') }}
        </button>

        <input type="file" name="upFile" hidden data-yw-file-picker-input
               aria-hidden="true" tabindex="-1">

        <p class="file-picker-upload-busy" hidden>{{ _t('ATTACH_FILE_PICKER_UPLOADING') }}</p>
        <div class="file-picker-upload-error yw-text-danger" hidden></div>

        <button type="button" class="yw-btn file-picker-back" data-yw-file-picker-back hidden>
          <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#arrow-left"/></svg>
          {{ _t('GO_BACK') }}
        </button>

        <div data-yw-file-picker-pane="existing">
          <div class="file-picker-filters">
            <div class="file-picker-search">
              <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#filter"/></svg>
              <input type="text" name="search" class="yw-input" autocomplete="off"
                placeholder="{{ _t('ATTACH_FILE_PICKER_SEARCH_PLACEHOLDER') }}">
            </div>

            <select name="extension" class="yw-input file-picker-extensions" data-yw-file-picker-extensions>
              <option value="">{{ _t('ATTACH_FILE_PICKER_ALL_EXTENSIONS') }}</option>
            </select>
          </div>

          <div class="file-picker-families" data-yw-file-picker-families></div>
          <ul class="file-picker-results" data-yw-file-picker-results></ul>
          <p class="file-picker-empty" data-yw-file-picker-empty hidden>{{ _t('ATTACH_FILE_PICKER_NO_RESULT') }}</p>
        </div>

        <div class="file-picker-selected" hidden>
          <span class="file-picker-selected__preview" data-yw-file-picker-selected-preview></span>
          <span class="file-picker-selected__label">
            <strong>{{ _t('ATTACH_FILE_PICKER_SELECTED') }}</strong>
            <span data-yw-file-picker-selected-name></span>
          </span>
        </div>

        <form role="form" class="file-picker-options" hidden>
          <div class="yw-form-group file-option">
            <label>{{ _t('DOWNLOAD_LINK_TEXT') }}</label>
            <input type="text" name="attach_link_text" value="" class="yw-input">
          </div>

          <div class="yw-form-group pdf-option" data-yw-file-picker-wiki-only>
            <label>{{ _t('ATTACH_ACTION_DISPLAY_PDF_TEXT') }}</label>
            <div>
              <label class="yw-radio-inline">
                <input type="radio" name="attach_action_display_pdf" value="0" checked>
                {{ _t('ATTACH_ACTION_DISPLAY_PDF_LINK_TEXT') }}
              </label>
              <label class="yw-radio-inline">
                <input type="radio" name="attach_action_display_pdf" value="1">
                {{ _t('ATTACH_ACTION_DISPLAY_PDF_INCLUDED_TEXT') }}
              </label>
            </div>
          </div>

          <div class="yw-form-group image-option" data-yw-file-picker-wiki-only>
            <label>{{ _t('IMAGE_ALIGN') }}</label>
            <div>
              <label class="yw-radio-inline">
                <input type="radio" checked value="" name="attach_align"> {{ _t('NONE') }}
              </label>
              <label class="yw-radio-inline">
                <input type="radio" value="left" name="attach_align"> {{ _t('LEFT') }}
              </label>
              <label class="yw-radio-inline">
                <input type="radio" value="center" name="attach_align"> {{ _t('CENTER') }}
              </label>
              <label class="yw-radio-inline">
                <input type="radio" value="right" name="attach_align"> {{ _t('RIGHT') }}
              </label>
            </div>
          </div>

          <div class="yw-form-group image-option" data-yw-file-picker-wiki-only>
            <label>{{ _t('IMAGE_SIZE') }}</label>
            <div>
              <label class="yw-radio-inline">
                <input type="radio" value="small" name="attach_imagesize">
                {{ _t('THUMBNAIL') }}&nbsp;({{ config['image-small-width'] }}x{{ config['image-small-height'] }})
              </label>
              <label class="yw-radio-inline">
                <input type="radio" value="medium" name="attach_imagesize">
                {{ _t('MEDIUM') }}&nbsp;({{ config['image-medium-width'] }}x{{ config['image-medium-height'] }})
              </label>
              <label class="yw-radio-inline">
                <input type="radio" value="big" name="attach_imagesize">
                {{ _t('BIG') }}&nbsp;({{ config['image-big-width'] }}x{{ config['image-big-height'] }})
              </label>
              <label class="yw-radio-inline">
                <input type="radio" checked value="original" name="attach_imagesize">
                {{ _t('ORIGINAL_SIZE') }}
              </label>
            </div>
          </div>

          <div class="yw-form-group">
            <label title="{{ _t('ALT_INFOS') }}">{{ _t('ALTERNATIVE_TEXT') }}</label>
            <input type="text" name="attach_alt" value="" class="yw-input">
          </div>

          <a href="#avanced-settings" class="yw-btn yw-collapse-toggle" data-yw-file-picker-wiki-only data-yw-collapse-toggle="#file-picker-advanced-settings" aria-expanded="false">
            {{ _t('ADVANCED_PARAMETERS') }}
            <span class="yw-collapse-toggle__caret"></span>
          </a>
          <div id="file-picker-advanced-settings" class="yw-collapse" data-yw-file-picker-wiki-only>
            <hr>
            <div class="yw-form-group">
              <label for="file_picker_attach_link">{{ _t('ASSOCIATED_LINK') }}</label>
              <input type="text" id="file_picker_attach_link" name="attach_link" value="" class="yw-input">
            </div>

            <div class="yw-form-group">
              <label>{{ _t('GRAPHICAL_EFFECTS') }}</label>
              <div>
                <label class="yw-checkbox-inline">
                  <input type="checkbox" name="attach_css_class" value="whiteborder"> {{ _t('WHITE_BORDER') }}
                </label>
                <label class="yw-checkbox-inline">
                  <input type="checkbox" name="attach_css_class" value="lightshadow"> {{ _t('DROP_SHADOW') }}
                </label>
                <label class="yw-checkbox-inline">
                  <input type="checkbox" name="attach_css_class" value="zoom"> {{ _t('ZOOM_HOVER') }}
                </label>
              </div>
            </div>

            <div class="yw-form-group">
              <label>{{ _t('ATTACH_ACTION_FULLIMAGELINK_TEXT') }}</label>
              <div>
                <label class="yw-radio-inline">
                  <input type="radio" name="attach_nofullimagelink" value="0"> {{ _t('YES') }}
                </label>
                <label class="yw-radio-inline">
                  <input type="radio" name="attach_nofullimagelink" value="1" checked> {{ _t('NO') }}
                </label>
              </div>
            </div>

            <div class="yw-form-group image-option">
              <label for="file_picker_attach_caption">{{ _t('CAPTION') }}</label>
              <input type="text" id="file_picker_attach_caption" name="attach_caption" value="" class="yw-input">
            </div>
          </div>
        </form>
  </div>

  <div class="yw-rail__footer">
    <button type="button" class="yw-btn yw-btn--primary yw-btn--block btn-insert-upload" disabled>{{ _t('INSERT') }}</button>
  </div>
</aside>
