{% if forms|length > 0 %}
  <table id="add-entry-table" class="bazar-table table table-condensed table-striped">
    <thead>
      <tr>
        <th>{{ _t('BAZ_FORMULAIRE') }}</th>
        <th style="width:220px;">{{ _t('BAZ_ACTIONS') }}</th>
      </tr>
    </thead>
    <tbody>
      {% for form in forms %}
        <tr>
          <td>
            <strong>{{ form.label }}</strong>
            {% if form.description %}<br />{{ form.description }}{% endif %}
          </td>
          <td>
            <a class="btn btn-mini btn-xs btn-primary" href="{{ url({ params: { view: 'saisir', action: 'saisir_fiche', id: form.id }}) }}">
              <svg class="yw-icon icon-plus" aria-hidden="true"><use href="src/assets/icons.svg#plus"/></svg>
              {{ _t('BAZ_SAISIR_UNE_NOUVELLE_FICHE') }}
            </a>
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% else %}
  <div class="yw-alert yw-alert--info">{{ _t('BAZ_NO_FORMS_FOUND')  }}</div>
{% endif %}
