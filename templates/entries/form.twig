{{ include_javascript('javascripts/bazar.js', true, true) }}
{{ error|raw }}
<h3 class="titre_type_fiche">{{ _t('BAZ_TITRE_SAISIE_FICHE') }}&nbsp;{{ form.label }}</h3>
<form action="" method="post" name="formulaire" id="formulaire" enctype="multipart/form-data" {% if not showConditions %}novalidate{% endif %}>
  {% if showConditions %}
    {{ form.condition|raw }}
    <div class="checkbox">
      <label>
        <input type="checkbox" required name="accept_condition" value="1">
        <span>{{ _t('BAZ_ACCEPTE_CONDITIONS') }}</span>
      </label>
    </div>
  {% else %}
    {% if form.condition is not empty %}
      <input type="hidden" required name="accept_condition" value="1">
    {% endif %}
    {% for renderedInput in renderedInputs %}
      {{ renderedInput|raw }}
    {% endfor %}
  {% endif %}
  {{ captchaField|raw }}
  <div class="form-actions yw-form-group">
    <div class="col-sm-9 col-sm-offset-3">
      <button type="submit" class="yw-btn yw-btn--primary">{{ _t('BAZ_VALIDER') }}</button>
      <a class="btn btn-xs btn-default" onclick="javascript:history.back()">{{ _t('BAZ_ANNULER') }}</a>
    </div>
  </div>
  <input name="antispam" value="0" type="hidden">
  <input name="form_id" value="{{ form.id }}" type="hidden">
  {% if entryId %}
    <input name="tag" value="{{ entryId }}" type="hidden">
  {% endif %}
  {% if passwordForEditing %}
    <input name="password_for_editing" value="{{ passwordForEditing }}" type="hidden">
  {% endif %}
  {% if incomingUrl %}
    <input name="incomingurl" value="{{ incomingUrl }}" type="hidden">
  {% endif %}
</form>

{# Include modals for aceditors #}
{{ include('@core/aceditor-modals.twig') }}
