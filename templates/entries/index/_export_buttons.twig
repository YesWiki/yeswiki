{% set vIDsParameter = params.id ?? params.id ?? null %}
{% set vIDsString = vIDsParameter is iterable ? ( vIDsParameter is not empty ? vIDsParameter | join(',') : "") : vIDsParameter %}
{% set vIDsObject = ( vIDsString is defined ? { id : vIDsString } : {}) %}
{% set vBase64EncodedIDs = b64 (vIDsString) | url_encode %}
{% set vQueryParameter = params.query ?? params.queries ?? null %}
{% set vQueryString = ( vQueryParameter is defined
    ?	(
    vQueryParameter is iterable
    ?	(
    vQueryParameter is not empty
    ?
    vQueryParameter
    | map(p => p.name ~ p.operator ~ (p.values|join(",")))
    | filter(v => v is not empty)
    | join('|')
    : ''
    )
    : vQueryParameter | trim
    )
    :	''
) %}
{%
set vQueryObject = vQueryString != '' ? { query : (vQueryString | url_encode) } : {}
%}
{%
set vKeywords =	(
params.keywords is defined
? { keywords : params.keywords }
: {}
)
%}
{%
set vSearchFields =	(
params.searchfields is defined
? { searchfields : params.searchfields | join(",") }
: {}
)
%}
{%
set vCorrespondance =	(
params.fieldmapping is defined
? { fieldmapping : params.fieldmapping }
: {}
)
%}
{%
set vOrder =	(
params.order is defined
? { order : params.order }
: {}
)
%}
{%
set vField =	(
params.field is defined
? { field : params.field }
: {}
)
%}
{%
set vPeriod =	(
params.period is defined
? { period : params.period }
: {}
)
%}
{%
set vDateFilter =	(
params.datefilter is defined
? { datefilter : params.datefilter }
: {}
)
%}
{%
set vNb =	(
params.nb is defined
? { nb : params.nb }
: {}
)
%}
{%
set vPeriod =	(
params.period is defined
? { period : params.period }
: {}
)
%}
{%
set vFacet = (
facet is iterable and facet is not empty
? { facet : facet|map((values, name) => name ~ '=' ~ (values is iterable ? values|join(',') : values))|join('|') }
: {}
)
%}
{%
set vGenericParams = {}
| merge (vQueryObject)
| merge (vKeywords)
| merge (vFacet)
| merge (vSearchFields)
| merge (vCorrespondance)
| merge (vDateFilter)
| merge (vNb)
| merge (vPeriod)
%}
{% set vRSSParams = {} | merge (vGenericParams) | merge (vIDsObject) %}
{% set vCSVParams = {} | merge (vGenericParams) | merge (vOrder) | merge (vField) %}
{% set vJSONParams = {} | merge (vGenericParams) | merge (vOrder) | merge (vField) %}

{% set vRSSHRef = url({ tag: 'api/entries/rss', params: vRSSParams }) %}
{% set vCSSHRef = url ({ tag: 'api', handler: 'forms/' ~ 'b64_' ~ vBase64EncodedIDs ~ '/entries/csv', params: vCSVParams }) %}
{% set vJSONHRef = url ({ tag: 'api', handler: 'forms/' ~ 'b64_' ~ vBase64EncodedIDs ~ '/entries', params: vJSONParams }) %}
<div class="export-links pull-right">
    <a class="btn btn-default btn-mini btn-xs"
       data-toggle="tooltip"
       data-placement="bottom"
       title="{{ _t("BAZ_RSS")  }}"
       target="_blank"
       href="{{ vRSSHRef }}"
       data-href="{{ vRSSHRef }}"><svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#rss"/></svg></a>
    <a class="btn btn-default btn-mini btn-xs"
       data-toggle="tooltip"
       data-placement="bottom"
       title="{{ _t("BAZ_CSV")  }}"
       target="_blank"
       href="{{ vCSSHRef }}"
       data-href="{{ vCSSHRef }}">CSV</a>
    <a class="btn btn-default btn-mini btn-xs"
       data-toggle="tooltip"
       data-placement="bottom"
       title="{{ _t("BAZ_JSON")  }}"
       target="_blank"
       href="{{ vJSONHRef }}"
       data-href="{{ vJSONHRef }}">JSON</a>
</div>
