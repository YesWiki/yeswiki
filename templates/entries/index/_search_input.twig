<div id="bazar-search-{{ listId }}">
    <form action=""
          method="get"
          name="search-form"
          id="search-form"
          class="">
        {% set handler = url({tag:pageTag})|slice(url({tag:pageTag,handler:' '})|length-1) %}
        <input type="hidden"
               name="wiki"
               value="{{ pageTag ~ (handler ? '/' ~ handler : '') }}">
        <input type="hidden" name="view" value="consulter">
        <input type="hidden" name="action" value="recherche">
        <div class="bazar-search yw-form-group">
            <div class="input-group input-prepend input-append">
                <span class="add-on input-group-addon"><svg class="yw-icon icon-search" aria-hidden="true"><use href="src/assets/icons.svg#loupe"/></svg></span>
                <input type="text"
                       value="{{ params.keywords }}"
                       name="keywords"
                       placeholder="{{ _t("BAZ_MOT_CLE") }}"
                       class="search-input yw-input input-lg">
                {% if forms|length > 1 %}
                    <span class="input-group-btn search-filter"
                          style="width:auto;
                                 max-width:240px">
                        <select onchange="javascript:this.form.submit();"
                                class="yw-input input-lg"
                                name="selectedID">
                            <option value="">{{ _t("BAZ_TOUS_TYPES_FICHES") }}</option>
                            {% for form in forms %}
                                <option value="{{ form.id }}"
                                        {% if form.id == selectedID %}selected{% endif %}>
                                    {{ form.label }}
                                </option>
                            {% endfor %}
                        </select>
                    </span>
                {% else %}
                    <input type="hidden" name="id" value="{{ formId }}">
                {% endif %}
                {% if params.query %}
                    <input type="hidden"
                           name="query"
                           value="{{ params.query is iterable ? params.query|map(p => p.name ~ p.operator ~ p.value) |join(', ') : params.query }}">
                {% endif %}
                <input type="hidden" name="facet" value="{{ facet }}">
                <span class="input-group-btn search-button-container">
                    <input value="{{ _t("BAZ_RECHERCHER") }}"
                           class="btn btn-primary"
                           type="submit" />
                </span>
            </div>
        </div>
    </form>
</div>
