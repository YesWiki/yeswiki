
<div id="bazar-search-{{ listId }}">
    <form action=""
          method="get"
          name="search-form"
          id="search-form"
          class="bazar-search yw-form-group">
        {% set handler = url({tag:pageTag})|slice(url({tag:pageTag,handler:' '})|length-1) %}
        <input type="hidden"
               name="wiki"
               value="{{ pageTag ~ (handler ? '/' ~ handler : '') }}">
        <input type="hidden" name="view" value="consulter">
        <input type="hidden" name="action" value="recherche">

        {% include '@core/_searchbox.twig' with {
            name: 'keywords',
            value: params.keywords,
            placeholder: _t('BAZ_MOT_CLE'),
            button: _t('BAZ_RECHERCHER')
        } only %}

        {% if forms|length > 1 %}

            <div class="yw-searchbox-aside">
                <label class="sr-only" for="bazar-search-form-{{ listId }}">{{ _t('BAZ_TOUS_TYPES_FICHES') }}</label>
                <select onchange="javascript:this.form.submit();"
                        id="bazar-search-form-{{ listId }}"
                        class="yw-input"
                        name="selectedID">
                    <option value="">{{ _t("BAZ_TOUS_TYPES_FICHES") }}</option>
                    {% for form in forms %}
                        <option value="{{ form.id }}"
                                {% if form.id == selectedID %}selected{% endif %}>
                            {{ form.label }}
                        </option>
                    {% endfor %}
                </select>
            </div>
        {% else %}
            <input type="hidden" name="id" value="{{ formId }}">
        {% endif %}

        {% if params.query %}
            <input type="hidden"
                   name="query"
                   value="{{ params.query is iterable ? params.query|map(p => p.name ~ p.operator ~ p.value) |join(', ') : params.query }}">
        {% endif %}
        <input type="hidden" name="facet" value="{{ facet is iterable ? facet|map((values, name) => name ~ '=' ~ (values is iterable ? values|join(',') : values))|join('|') : facet }}">
    </form>
</div>
