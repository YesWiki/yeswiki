
<div class="checkbox">
  <label>
    <input class="filter-checkbox" type="checkbox" id="{{ listId }}_{{ filterNode.id }}"
           name="facet[{{ filterNode.name }}][]"
           value="{{ filterNode.value }}" {{ filterNode.checked }}>
    <span>
      {{ filterNode.label|raw }} <span class="nb-wrapper">(<span class="nb">{{ filterNode.count }}</span>)</span>
    </span>
  </label>
</div>
