<div class="yw-alert yw-alert--info">
<h4>{{ _t('SUPPORT_YESWIKI') }}</h4>
{{ _t('SUPPORT_YESWIKI_DESC') }},
<strong>{{ _t('SUPPORT_US')}}</strong> !!!<br /><br />
<a class="btn btn-primary" href="https://www.helloasso.com/associations/yeswiki/formulaires/1/widget"><svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#heart"/></svg> {{_t('DONATE')}}</a> <a href="https://yeswiki.net/?SoutenirYesWiki">{{_t('LEARN_MORE')}}</a>
</div>
{# Upgrade messages result #}
<ul class="list-group span4">
{% for message in messages %}
    {% set label = "danger" %}
    {% if message.status == "ok" %}
        {% set label = "success" %}
    {% endif %}
    <li class="list-group-item">
        <span class="pull-right label label-{{ label }}">{{ message.status }}</span>
        {{ message.text | replace({'\\n': "\n"}) | nl2br }}
    </li>
{% endfor %}
</ul>

{# Go Back #}
<br/>
<a class="btn btn-sm btn-secondary-1" href="{{ url({}) }}">
    <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#arrow-left"/></svg>
    {{ _t('GO_BACK') }}
</a>
