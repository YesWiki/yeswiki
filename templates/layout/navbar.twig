
<div class="yw-topnav topnavpage links-container">
  <ul class="yw-nav">
    {% for entry in entries %}
      {% if entry.children is not empty %}
        <li class="yw-dropdown">

          <a{{ entry.active ? ' class="active-link"' : '' }} data-yw-dropdown-toggle
             href="{{ entry.href ?: '#' }}">{{ entry.label }}<b class="yw-dropdown__caret"></b></a>
          <ul class="yw-dropdown__menu">
            {% for child in entry.children %}
              <li><a{{ child.active ? ' class="active-link"' : '' }} href="{{ child.href }}">{{ child.label }}</a></li>
            {% endfor %}
          </ul>
        </li>
      {% else %}
        <li><a{{ entry.active ? ' class="active-link"' : '' }} href="{{ entry.href }}">{{ entry.label }}</a></li>
      {% endif %}
    {% endfor %}
  </ul>
</div>
