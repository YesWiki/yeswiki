{# The wiki's navbar: what `PageMenuHaut` used to hold (ticket 30).

   The classes are the ones the theme already styles, and they are written here rather than
   produced by transforming somebody's markup. That transformation still exists for ordinary
   included pages (IncludeAction walks the DOM with XPath to turn a nested <ul> into a
   dropdown) -- it exists *because* the source was a page body. From a list of entries the
   markup is simply known.

   `current` is the page being rendered: the entry pointing at it gets `active-link`, which
   is what the include action used to add by string-replacing its own output. #}
<div class="yw-topnav topnavpage links-container">
  <ul class="yw-nav">
    {% for entry in entries %}
      {% if entry.children is not empty %}
        <li class="yw-dropdown">
          {# an entry with children may still be a link of its own; when it is not, the label
             is the trigger and goes nowhere -- hence href="#" #}
          <a{{ entry.active ? ' class="active-link"' : '' }} data-yw-dropdown-toggle
             href="{{ entry.href ?: '#' }}">{{ entry.label }}<b class="yw-dropdown__caret"></b></a>
          <ul class="yw-dropdown__menu">
            {% for child in entry.children %}
              <li><a{{ child.active ? ' class="active-link"' : '' }} href="{{ child.href }}">{{ child.label }}</a></li>
            {% endfor %}
          </ul>
        </li>
      {% else %}
        <li><a{{ entry.active ? ' class="active-link"' : '' }} href="{{ entry.href }}">{{ entry.label }}</a></li>
      {% endif %}
    {% endfor %}
  </ul>
</div>
