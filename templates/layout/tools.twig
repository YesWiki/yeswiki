
<div class="yw-topnav-tools">

  <div class="yw-topnav-tools__menu">
    <div class="yw-topnav-tools__panel">

      <div class="yw-switcher" role="group" aria-label="{{ _t('SCHEME_TOGGLE') }}">
        {% for scheme, option in {
          'system': { glyph: 'device-desktop', label: _t('SCHEME_SYSTEM') },
          'light': { glyph: 'sun', label: _t('SCHEME_LIGHT') },
          'dark': { glyph: 'moon', label: _t('SCHEME_DARK') },
        } %}
          <button type="button" class="yw-switcher__option" data-yw-scheme-set="{{ scheme }}"
                  title="{{ option.label }}" aria-pressed="false">
            {{ icon(option.glyph) }}
            <span class="yw-switcher__label">{{ option.label }}</span>
          </button>
        {% endfor %}
      </div>
    </div>

    <span class="yw-topnav-tools__current" data-yw-scheme aria-hidden="true"
          data-label-system="{{ _t('SCHEME_SYSTEM') }}"
          data-label-light="{{ _t('SCHEME_LIGHT') }}"
          data-label-dark="{{ _t('SCHEME_DARK') }}">
      {{ icon('device-desktop') }}
    </span>
  </div>

  {% if languages|length > 1 %}
    <div class="yw-topnav-tools__menu">
      <div class="yw-topnav-tools__panel">
        <div class="yw-switcher" role="group" aria-label="{{ _t('LANGUAGE_CHOOSE') }}">
          {% for language in languages %}

            <a class="yw-switcher__option{{ language.current ? ' yw-switcher__option--on' : '' }}"
               href="{{ language.href }}" hreflang="{{ language.code }}" lang="{{ language.code }}"
               title="{{ language.label }}"{{ language.current ? ' aria-current="true"' : '' }}>
              <span class="yw-switcher__code">{{ language.code }}</span>
              <span class="yw-switcher__label">{{ language.label }}</span>
            </a>
          {% endfor %}
        </div>
      </div>

      <span class="yw-topnav-tools__current" aria-hidden="true" title="{{ _t('LANGUAGE_CHOOSE') }}">
        <span class="yw-switcher__code">{{ language|upper }}</span>
      </span>
    </div>
  {% endif %}
</div>
