
<div class="yw-topnav-fast-access pull-right">
  {% for entry in entries %}

    <a class="yw-btn" href="{{ entry.href }}"{% if entry.label %} title="{{ entry.label }}"{% endif %}>
      {%- if entry.glyph %}{{ entry.glyph|raw }}{% else %}{{ entry.label }}{% endif -%}
    </a>
  {% endfor %}
  {% if account %}{{ action('login')|raw }}{% endif %}

  {{ editChrome|default('')|raw }}
</div>
