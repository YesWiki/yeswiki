{% set htmx = {
    'hx-get': url({tag: 'api/search'}),
    'hx-target': '#yw-search-results',
    'hx-include': '#yw-search-form',
    'hx-indicator': '#yw-search-spinner',
    'hx-trigger': 'change'
} %}
{% macro attrs(map) %}{% for k, v in map %}{{ k }}="{{ v }}" {% endfor %}{% endmacro %}

<div id="yw-search-facets" class="yw-list-toolbar__facets" hx-swap-oob="true">
  {% if tags is defined and tags is not empty %}
    <p class="yw-search-filter">
      {{ _t('SEARCH_FILTERED_BY_KEYWORD') }}
      {% for keyword in tags %}<span class="yw-tag">{{ keyword|trim }}</span>{% endfor %}
      <a class="yw-search-filter__clear" href="{{ url({tag: 'search', params: phrase is empty ? {} : {q: phrase}}) }}">{{ _t('SEARCH_CLEAR_KEYWORD') }}</a>
    </p>
  {% endif %}
  {% if facets|length > 1 %}
    {% set allCount = 0 %}
    {% for count in facets %}{% set allCount = allCount + count %}{% endfor %}
    <ul class="yw-facets">
      <li class="yw-facet">
        <input type="radio" name="type" value="" id="yw-facet-all" {{ type is empty ? 'checked' : '' }} {{ _self.attrs(htmx) }} />
        <label class="yw-facet__label" for="yw-facet-all">
          {{ _t('SEARCH_TYPE_ALL') }}
          <span class="yw-facet__count">{{ allCount }}{{ capped ? '+' : '' }}</span>
        </label>
      </li>
      {% for facetType, count in facets %}
        <li class="yw-facet{{ facetType == 'entry' and forms|length > 0 ? ' yw-facet--group' : '' }}">
          <input type="radio" name="type" value="{{ facetType }}" id="yw-facet-{{ facetType }}" {{ type == facetType and form is empty ? 'checked' : '' }} {{ _self.attrs(htmx) }} />
          <label class="yw-facet__label{{ type == facetType and form is not empty ? ' yw-facet__label--narrowed' : '' }}" for="yw-facet-{{ facetType }}">
            {{ _t('SEARCH_TYPE_' ~ facetType|upper) }}
            <span class="yw-facet__count">{{ count }}</span>
          </label>
          {% if facetType == 'entry' and forms|length > 0 %}
            <ul class="yw-facet__menu" aria-label="{{ _t('SEARCH_NARROW_TO_FORM') }}">
              {% for oneForm in forms %}
                <li>
                  <input type="radio" name="form" value="{{ oneForm.id }}" id="yw-facet-form-{{ oneForm.id }}" {{ form == oneForm.id ? 'checked' : '' }} {{ _self.attrs(htmx) }} />
                  <label class="yw-facet__label" for="yw-facet-form-{{ oneForm.id }}">
                    {{ oneForm.label }}
                    <span class="yw-facet__count">{{ oneForm.count }}</span>
                  </label>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</div>

<div id="yw-search-export" class="yw-list-toolbar__export" hx-swap-oob="true">
  {{ include('@core/_export_menu.twig', { exports: exports, id: 'yw-search-export-menu' }) }}
</div>

{% if found == 0 %}
  <p class="yw-search-empty">{{ _t('NO_SEARCH_RESULT') }}.</p>
{% else %}
  <div class="yw-search-results">{{ rendered|raw }}</div>

  {% if pages > 1 %}
    <nav class="yw-search-pagination" aria-label="{{ _t('SEARCH_PAGINATION') }}">
      {% if page > 1 %}
        <button type="button" class="yw-btn yw-btn--sm" {{ _self.attrs(htmx|merge({'hx-trigger': 'click'})) }} hx-vals='{"page": {{ page - 1 }}}'>{{ _t('PREVIOUS') }}</button>
      {% endif %}
      <span class="yw-search-page">{{ _t('SEARCH_PAGE_N_OF_M', {page: page, pages: pages}) }}</span>
      {% if page < pages %}
        <button type="button" class="yw-btn yw-btn--sm" {{ _self.attrs(htmx|merge({'hx-trigger': 'click'})) }} hx-vals='{"page": {{ page + 1 }}}'>{{ _t('NEXT') }}</button>
      {% endif %}
    </nav>
  {% endif %}
{% endif %}
