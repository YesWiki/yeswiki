<ul id="fmtab{{ tag }}" class="yw-nav">
  <li {% if not trash %} class="active"{% endif %}>
    <a
      href="{{ url({tag:tag,handler:method}) ~ '#fmtab' ~ tag }}"
      title="{{ _t('ATTACH_FILE_MANAGEMENT') }}">
      <svg class="yw-icon icon-file" aria-hidden="true"><use href="src/assets/icons.svg#file"/></svg>&nbsp;{{ _t('ATTACH_FILE_MANAGEMENT') }}
    </a>
  </li>
	<li {% if trash %} class="active"{% endif %}>
    <a
      href="{{ url({tag:tag,handler:method,params:{do:'trash'}}) ~ '#fmtab' ~ tag }}"
      title="{{ _t('ATTACH_TRASH') }}">
      <svg class="yw-icon icon-trash" aria-hidden="true"><use href="src/assets/icons.svg#trash"/></svg>&nbsp;{{ _t('ATTACH_TRASH') }}</a>
    </li>
</ul>
{% if files is empty %}
  <div class="yw-alert yw-alert--info">
    {{ _t('ATTACH_NO_ATTACHED_FILES')|replace({'{tag}':format(tag)|raw})|raw }}
  </div>
{% else %}
  <table class="fmtable yw-table" data-yw-datatable>
    <thead>
      <tr>
        <td class="fmfilename">{{ _t('ATTACH_FILENAME') }}</td>
        <td class="fmfilesize">{{ _t('ATTACH_SIZE') }}</td>
        <td class="fmfiledate">{{ _t('ATTACH_DATE_OF_MODIFICATION') }}</td>
        {% if trash %}<td class="fmfiletrashdate">{{ _t('ATTACH_DELETION') }}</td>{% endif %}
        <td class="fmfileactions">&nbsp;</td>
      </tr>
    </thead>
    <tbody>
      {% for file in files %}
        <tr class="{{ (loop.index % 2) == 1 ?"tableFMCol1" : "tableFMCol2"}}"> 
          <td class="fmfilename">
            <a
              class="filenamelink"
              href="{{ url({tag:tag,handler:"download",params:{file:file.realname}}) }}"
              title="{{ _t('ATTACH_REAL_FILENAME')|replace({'{file}':file.realname}) ~
                (
                  trash
                  ? _t('ATTACH_DELETED_ON')|replace({'{date}':file.parsedTrashDate})
                  : ''
                )
              }}"
            >
              {% if file.name|length < 26 %}{{ file.name }}{% else %}{{ file.name|slice(0,25) }}&hellip;{% endif %}.{{ file.ext }}
            </a>
          </td>
          <td class="fmfilesize">{{ file.readableSize }}</td>
          <td class="fmfiledate">{{ file.parsedDateUpload }}</td>
          {% if trash %}<td class="fmfiletrashdate">{{ file.parsedTrashDate }}</td>{% endif %}
          <td class="fmfileactions">
            {% if trash %}

              <form method="post" action="{{ url({tag:tag,handler:method}) }}" style="display: inline">
                <input type="hidden" name="csrf-token" value="{{ csrfToken({id:'main',refresh:false})|e('html_attr') }}">
                <input type="hidden" name="do" value="restore">
                <input type="hidden" name="file" value="{{ file.realname }}">
                <button type="submit" class="yw-btn yw-btn--sm yw-btn--primary" title="{{ _t('ATTACH_RESTORE') }}">
                  <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#arrow-forward-up"/></svg>&nbsp;{{ _t('ATTACH_RESTORE') }}
                </button>
              </form>
            {% endif %}

            <form method="post" action="{{ url({tag:tag,handler:method}) }}" style="display: inline">
              <input type="hidden" name="csrf-token" value="{{ csrfToken({id:'main',refresh:false})|e('html_attr') }}">
              <input type="hidden" name="do" value="{{ trash ? 'erase' : 'del' }}">
              <input type="hidden" name="file" value="{{ file.realname }}">
              <button type="submit" class="yw-btn yw-btn--sm yw-btn--danger btn-icon" title="{{ _t('DELETE') }}">
                {{ trash ? icon('x') : icon('trash') }}
              </button>
            </form>
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
  {% if trash %}
    <div class="yw-alert yw-alert--danger">
      <form method="post" action="{{ url({tag:tag,handler:method}) }}" class="pull-right">
        <input type="hidden" name="csrf-token" value="{{ csrfToken({id:'main',refresh:false})|e('html_attr') }}">
        <input type="hidden" name="do" value="emptytrash">
        <button type="submit" class="yw-btn yw-btn--danger">
          <svg class="yw-icon icon-remove icon-white" aria-hidden="true"><use href="src/assets/icons.svg#x"/></svg>&nbsp;{{ _t('ATTACH_EMPTY_TRASH') }}
        </button>
      </form>
      <strong>{{ _t('CAUTION') }} :</strong> {{ _t('ATTACH_EMPTY_TRASH_NOTICE') }}
      <div class="clearfix"></div>
    </div>
  {% endif %}
{% endif %}
