<div class="yw-container debug yw-debug-report">
    <h4>Query log</h4>
    <p>
        <strong>{{ totalTime|round(4) }} s total time</strong>
        <br />
        <strong>{{ sqlTime|round(4) }} s total SQL time</strong> ({{ sqlShare|round(2) }}% of total time)
        <br />
        <strong>{{ queryCount }} quer{{ queryCount == 1 ? 'y' : 'ies' }}</strong>
    </p>
    {% if queries %}
        <ol class="yw-debug-report__queries">
            {% for query in queries %}
                <li>
                    <code>{{ query.query }}</code> <em>({{ query.time|round(4) }} s)</em>
                </li>
            {% endfor %}
        </ol>
    {% endif %}
</div>
