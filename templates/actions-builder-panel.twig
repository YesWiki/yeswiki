{# The component rail beside an editor: the palette and each component's settings come from the server, actions-builder.js moves the tag they write into the editor. #}
<aside class="yw-designer__sidebar actions-builder-panel" id="actions-builder-panel" hidden data-yw-unsaved-ignore
       data-ab-palette-url="{{ url({ tag: 'api/actions-builder/palette' }) }}"
       data-ab-settings-url="{{ url({ tag: 'api/actions-builder/settings' }) }}"
       data-ab-palette-title="{{ _t('ACTION_BUILDER_PALETTE_TITLE') }}">
  <div class="yw-rail__header">
    <h2 class="yw-rail__title" data-ab-title>{{ _t('ACTION_BUILDER_PALETTE_TITLE') }}</h2>
    <button type="button" class="yw-close" data-ab-close aria-label="{{ _t('ACTION_BUILDER_CLOSE') }}">&times;</button>
  </div>
  <div class="actions-builder-panel__body" data-ab-palette></div>
  <div class="actions-builder-panel__body" data-ab-settings-host hidden></div>
</aside>

{{ include_css('styles/vendor/leaflet/leaflet.css') }}
{{ include_javascript('javascripts/vendor/leaflet/leaflet.min.js') }}
{{ include_css('styles/yw-editor.css') }}
