{% if pages|length > 0 %}
    <table class="yw-table" data-yw-datatable style="table-layout:fixed;word-wrap: break-word;">
		    <thead>
		        <tr>
		            <th>{{ _t('TEMPLATE_PAGE') }}</th>
		            <th style="width:220px;">{{ _t('TEMPLATE_LAST_MODIFIED') }}</th>
		            <th style="width:200px;">{{ _t('TEMPLATE_OWNER') }}</th>
		            <th style="width:140px;">{{ _t('TEMPLATE_ACTIONS') }}</th>
		        </tr>
		    </thead>
		    <tbody>
		    {% for page in pages %}
		        <tr>
		            <td>{{ format('[[' ~ page.tag ~ ' ' ~ page.tag ~ ']]')|raw }}</td>
		            <td>{{ page.time|date('d-m-Y H:i:s') }}</td>
		            <td>{{ format('[[' ~ page.owner ~ ' ' ~ page.owner ~ ']]')|raw }}</td>
		            <td>
		            {% if hasAccess('write', page.tag) %}
		                <a class="yw-btn yw-btn--sm" href="{{ url({tag: page.tag, handler: 'edit'}) }}">
            					  <svg class="yw-icon icon-pencil" aria-hidden="true"><use href="src/assets/icons.svg#pencil"/></svg> {{ _t('TEMPLATE_MODIFY') }}
            				</a>
		            {% endif %}
		            {% if userIsAdmin() or userIsOwner() %}
		                <a class="yw-btn yw-btn--sm yw-btn--danger" href="{{ url({tag: page.tag, handler: 'deletepage'}) }}"  onclick="javascript:return confirm('{{ _t('TEMPLATE_CONFIRM_DELETE_PAGE')|e('js') }} ?');">
            					  <svg class="yw-icon icon-trash icon-white" aria-hidden="true"><use href="src/assets/icons.svg#trash"/></svg>
            				</a>
		            {% endif %}
		            </td>
		        </tr>
		    {% endfor %}
		    </tbody>
    </table>
{% endif %}
