{# ============================================================
   AdminContent – HTMX table partial
   Returned by GET /api/admin/pages and swapped into
   #admin-content-table-container.
   Variables: pages, currentPage, totalPages, total,
              perpage, sort, dir, search, type, ownerFilter,
              tagFilter, apiUrl
   ============================================================ #}

{% macro aclText(list) %}
    {%- set map = {
        '*' : 'ACLS_EVERYBODY',
        '+' : 'ACLS_AUTHENTIFICATED_USERS',
        '%' : 'ACLS_OWNER',
        'comments-closed': 'ACLS_COMMENTS_CLOSED'
    } -%}
    {%- for line in list|split("\n") -%}
        {%- set t = line|trim -%}
        {%- if t is not empty -%}
            {{- t in map|keys ? _t(map[t]) : t -}}
        {%- endif -%}
    {%- endfor -%}
{% endmacro %}

{# Helper macro: sortable column header link #}
{% macro sortHeader(label, col, currentSort, currentDir, apiUrl) %}
    {%- set nextDir = (currentSort == col and currentDir == 'asc') ? 'desc' : 'asc' -%}
    {%- set isActive = (currentSort == col) -%}
    <a class="sort-link" href="#"
       onclick="event.preventDefault(); adminContent.setSort('{{ col }}'); return false;">
        {{ label }}
        <span class="sort-icon{% if isActive %} active{% endif %}">
            {%- if isActive -%}
                {%- if currentDir == 'asc' -%}<i class="fa fa-sort-up"></i>
                {%- else -%}<i class="fa fa-sort-down"></i>
                {%- endif -%}
            {%- else -%}
                <i class="fa fa-sort text-muted"></i>
            {%- endif -%}
        </span>
    </a>
{% endmacro %}

{# -----------------------------------------------------------------------
   Summary bar
   ----------------------------------------------------------------------- #}
{% set offset = (currentPage - 1) * perpage %}
{% set rangeEnd = (offset + perpage < total) ? (offset + perpage) : total %}

<div class="admin-content-pager" style="margin-bottom:6px;">
    <small class="text-muted">
        {% if total > 0 %}
            {{ offset + 1 }}–{{ rangeEnd }} sur {{ total }} page(s)
        {% else %}
            Aucune page trouvée.
        {% endif %}
    </small>
    <div>
        {# Pagination top – compact #}
        {{ _self.pagerLinks(currentPage, totalPages) }}
    </div>
</div>

{# -----------------------------------------------------------------------
   Table
   ----------------------------------------------------------------------- #}
<div style="margin-bottom:0;">
<table class="table table-striped table-condensed table-hover" style="margin-bottom:4px;">
    <thead>
        <tr>
            <th class="col-cb">
                <label class="check-all-container" for="select-all-current">
                    <input type="checkbox" id="select-all-current" title="Select all on this page"
                           onchange="adminContent.toggleCurrentPage(this.checked)">
                    <span></span>
                </label>
            </th>
            <th>{{ _self.sortHeader(_t('ACLS_PAGE'), 'tag', sort, dir, apiUrl) }}</th>
            <th>Type</th>
            <th>{{ _self.sortHeader(_t('LAST_CHANGE')|capitalize, 'time', sort, dir, apiUrl) }}</th>
            <th>Droits d'accès</th>
            <th>Mots clés</th>
        </tr>
    </thead>
    <tbody>
    {% if pages is empty %}
        <tr>
            <td colspan="6" class="text-center text-muted" style="padding:32px 0;">
                <i class="fa fa-search"></i> Aucune page ne correspond aux filtres sélectionnés.
            </td>
        </tr>
    {% else %}
        {% for page in pages %}
        <tr>
            <td class="col-cb">
                {% set cbId = "admin-content-cb-" ~ page.tag|e('html_attr') %}
                <label for="{{ cbId }}">
                    <input type="checkbox"
                           id="{{ cbId }}"
                           class="page-checkbox"
                           data-tag="{{ page.tag|e('html_attr') }}"
                           value="{{ page.tag|e('html_attr') }}"
                           onchange="adminContent.togglePage('{{ page.tag|e('js') }}', this.checked)">
                    <span></span>
                </label>
            </td>
            <td>
                <a href="{{ url({tag: page.tag}) }}" title="{{ page.tag }}">
                    {{ page.tag }}
                </a>
            </td>
            <td style="font-size:12px;white-space:nowrap;">
                {%- if page.comment_on is not empty -%}
                    Commentaire
                {%- elseif page.page_type == 'fiche_bazar' -%}
                    {{- forms[page.form_id].bn_label_nature ?? ('Bazar #' ~ page.form_id) -}}
                {%- elseif page.page_type == 'liste' -%}
                    Liste
                {%- else -%}
                    Page
                {%- endif -%}
            </td>
            <td style="white-space:nowrap;font-size:12px;">
                {{ page.time|slice(0, 16) }}
                {% if page.last_editor %}
                <br><small class="text-muted">{{ page.last_editor }}</small>
                {% endif %}
            </td>
            <td style="font-size:12px;vertical-align:middle;">
                <div><strong>{{ _t('TEMPLATE_OWNER') }}: {{ page.owner ? page.owner|e : 'pas de propriétaire' }}</strong></div>
                <div title="{{ _t('ACLS_READ') }}"><i class="fa fa-eye text-muted"></i> {{ _self.aclText(page.acl_read) }}</div>
                <div title="{{ _t('ACLS_WRITE') }}"><i class="fa fa-pencil-alt text-muted"></i> {{ _self.aclText(page.acl_write) }}</div>
                <div title="{{ _t('COMMENTS') }}"><i class="fa fa-comment text-muted"></i> {{ _self.aclText(page.acl_comment) }}</div>
            </td>
            <td style="font-size:11px;">
                {% for tag in page.tags %}
                    <span class="tag-pill">{{ tag }}</span>
                {% endfor %}
            </td>
        </tr>
        {% endfor %}
    {% endif %}
    </tbody>
</table>
</div>

{# -----------------------------------------------------------------------
   Pagination bottom
   ----------------------------------------------------------------------- #}
{% if totalPages > 1 %}
<div class="admin-content-pager">
    <small class="text-muted">
        Page {{ currentPage }} / {{ totalPages }} — {{ total }} page(s) au total
    </small>
    {{ _self.pagerLinks(currentPage, totalPages) }}
</div>
{% endif %}

{# -----------------------------------------------------------------------
   Pagination macro (reused top + bottom)
   ----------------------------------------------------------------------- #}
{% macro pagerLinks(currentPage, totalPages) %}
{% if totalPages > 1 %}
<ul class="pagination pagination-sm" style="margin:0;">

    {# Previous #}
    <li class="{{ currentPage <= 1 ? 'disabled' : '' }}">
        <a href="#"
           {% if currentPage > 1 %}onclick="event.preventDefault(); adminContent.goToPage({{ currentPage - 1 }})"{% else %}tabindex="-1"{% endif %}>
            &laquo;
        </a>
    </li>

    {# Page numbers: show window around current page #}
    {% set windowSize = 4 %}
    {% set start = (currentPage - windowSize > 1) ? (currentPage - windowSize) : 1 %}
    {% set end   = (currentPage + windowSize < totalPages) ? (currentPage + windowSize) : totalPages %}

    {% if start > 1 %}
        <li>
            <a href="#" onclick="event.preventDefault(); adminContent.goToPage(1)">1</a>
        </li>
        {% if start > 2 %}
        <li class="disabled"><a href="#">…</a></li>
        {% endif %}
    {% endif %}

    {% for p in start..end %}
    <li class="{{ p == currentPage ? 'active' : '' }}">
        <a href="#"
           onclick="event.preventDefault(); {% if p != currentPage %}adminContent.goToPage({{ p }}){% endif %}">
            {{ p }}
        </a>
    </li>
    {% endfor %}

    {% if end < totalPages %}
        {% if end < totalPages - 1 %}
        <li class="disabled"><a href="#">…</a></li>
        {% endif %}
        <li>
            <a href="#" onclick="event.preventDefault(); adminContent.goToPage({{ totalPages }})">{{ totalPages }}</a>
        </li>
    {% endif %}

    {# Next #}
    <li class="{{ currentPage >= totalPages ? 'disabled' : '' }}">
        <a href="#"
           {% if currentPage < totalPages %}onclick="event.preventDefault(); adminContent.goToPage({{ currentPage + 1 }})"{% else %}tabindex="-1"{% endif %}>
            &raquo;
        </a>
    </li>
</ul>
{% endif %}
{% endmacro %}
