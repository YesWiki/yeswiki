{% include '@core/core.twig' %}

{% set sections = [
	{ label: 'Thèmes', exts: themes, one: 'AU_ONE_THEME_UPDATE', several: 'AU_SEVERAL_THEMES_UPDATE', options: {} },
	{ label: 'Tools (extensions)', exts: tools, one: 'AU_ONE_TOOL_UPDATE', several: 'AU_SEVERAL_TOOLS_UPDATE', options: { showSwitch: true, forbidden: forbiddenExtensions } }
] %}

<div class="yw-accordion yw-updates">
	{% for section in sections %}
		{% set nbMaj = 0 %}
		{% for ext in section.exts %}
			{% if ext.updateAvailable and ext.installed and ext.name not in forbiddenExtensions %}
				{% set nbMaj = nbMaj + 1 %}
			{% endif %}
		{% endfor %}
		<details class="yw-accordion__item" name="updates">
			<summary class="yw-accordion__summary">
				<span>{{ section.label }}</span>
				{% if nbMaj > 0 %}
					<span class="badge yw-updates__count">{{ nbMaj > 1 ? _t(section.several)|replace({'{nbMaj}': nbMaj}) : _t(section.one) }}</span>
				{% endif %}
			</summary>
			<div class="yw-accordion__body">
				{% set exts = section.exts %}
				{% include '@core/exts.twig' with section.options %}
			</div>
		</details>
	{% endfor %}
</div>
