{% include '@core/core.twig' %}

<p>&nbsp;</p>

<div class="yw-accordion" id="accordion_update">

	{% set nbMaj = 0 %}
	{% set exts = themes %}
	{% for ext in exts %}
		{% if ext.updateAvailable and ext.installed %}
			{% set nbMaj = nbMaj + 1 %}
		{% endif %}
	{% endfor %}
	{% if nbMaj > 0 %}
		<div class="yw-panel yw-panel--warning">
	{% else %}
		<div class="yw-panel">
	{% endif %}
		<details class="yw-accordion__item" name="updates">
		<summary class="yw-accordion__summary" id="headingThemes">
			<h2 class="yw-panel__title">Thèmes
				{% if nbMaj > 0 %}
					{% set alert = '' %}
					{% if nbMaj > 1 %}
						{% set alert = _t('AU_SEVERAL_THEMES_UPDATE')|replace({'{nbMaj}':nbMaj}) %}
					{% else %}
						{% set alert = _t('AU_ONE_THEME_UPDATE') %}
					{% endif %}
					<span class="alert-msg" style="float: right;">{{alert}}</span>
				{% endif %}
			</h2>
		</summary>
		<div class="yw-accordion__body" id="collapseThemes">
			{% set exts = themes %}
			{% include '@core/exts.twig' %}
		</div>
		</details>
	</div>

	{% set nbMaj = 0 %}
	{% set exts = tools %}
	{% for ext in exts %}
		{% if ext.updateAvailable and ext.installed %}
			{% set nbMaj = nbMaj + 1 %}
		{% endif %}
	{% endfor %}
	{% if nbMaj > 0 %}
		<div class="yw-panel yw-panel--warning">
	{% else %}
		<div class="yw-panel">
	{% endif %}
		<details class="yw-accordion__item" name="updates">
		<summary class="yw-accordion__summary" id="headingTools">
			<h2 class="yw-panel__title">Tools (extensions)
				{% if nbMaj > 0 %}
					{% set alert = '' %}
					{% if nbMaj > 1 %}
						{% set alert = _t('AU_SEVERAL_TOOLS_UPDATE')|replace({'{nbMaj}':nbMaj}) %}
					{% else %}
						{% set alert = _t('AU_ONE_TOOL_UPDATE') %}
					{% endif %}
					<span style="float: right;">{{alert}}</span>
				{% endif %}
			</h2>
		</summary>
		<div class="yw-accordion__body" id="collapseTools">
			{% set exts = tools %}
			{% include '@core/exts.twig' %}
		</div>
		</details>
	</div>
</div>
