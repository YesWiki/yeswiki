<!-- SYNDICATION accordeon start -->
{{ include_css('styles/actions/syndication.css')}}
{% if title is not empty %}
<h2>{{ title }}</h2>
{% endif %}
<div class="bazar-list panel-group accordion-group no-dblclick {{ class }}" id="accordion{{ urlHash }}">
{% set i = 0 %}
{% for page in syndication.pages %}
  {% set i = i + 1 %}
  <div class="bazar-entry panel panel-default collapsed">
    <button class="panel-heading collapsed"
       data-target="#collapse{{ urlHash }}_{{ i }}"
       data-toggle="collapse">
      <h4 class="panel-title">
        {% if page.date is not empty %}
        <small class="date_rss">{{ page.date }}</small>
        {% endif %}
        {% if showImage is not empty and page.image is not empty %}
        <img class="feed-img" src="{{ page.image }}" alt="" />
        {% endif %}
        {{ page.title }}
        {% if page.source is not empty %}
        <small>{{ _t('SYNDICATION_SOURCE') ~ ' : ' ~ page.source }}</small>
        {% endif %}
        {% if page.linkToEntry is not empty %}
          <a class="bazar-actions" onclick="event.stopPropagation();" href="{{ page.linkToEntry }}" title="{{ _t('BAZ_SEE_ENTRY') }}"><i class="fa fa-eye"></i></a>
          <a class="bazar-actions" onclick="event.stopPropagation();" href="{{ page.linkToEntry ~ '/edit' }}" title="{{ _t('BAZ_MODIFIER_LA_FICHE') }}"><i class="fas fa-edit"></i></a>
          <a class="bazar-actions text-danger" onclick="event.stopPropagation();" href="{{ page.linkToEntry ~ '/deletepage' }}" title="{{ _t('BAZ_SUPPRIMER_LA_FICHE') }}"><i class="fa fa-trash"></i></a>
        {% endif %}
        {% if page.mappingInput is not empty %}
          <a class="bazar-actions" onclick="event.stopPropagation();" href="{{ url({ params: { mapping: page.mappingInput|e('url') }}) }}" title="{{ _t('SYNDICATION_COPY_IN_WIKI') }}"><i class="fa fa-plus"></i></a>
        {% endif %}
      </h4>
    </button>
    <div id="collapse{{ urlHash }}_{{ i }}" class="panel-collapse collapse">
      <div class="panel-body">
        <div class="feed-description">
          {{ page.description|raw }}
        </div>
        <a class="btn btn-default" href="{{ page.url }}" {% if ext == true %}target="_blank"{% endif %}>
          {{ _t('SYNDICATION_SEE_ALL_CONTENT') }}
        </a>
      </div>
    </div>
  </div>
{% endfor %}
</div>
<!-- SYNDICATION accordeon end -->
