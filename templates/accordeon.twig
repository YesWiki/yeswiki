<!-- SYNDICATION accordeon start -->
{{ include_css('styles/yw-entries.css')}}
{% if title is not empty %}
<h2>{{ title }}</h2>
{% endif %}
{# the wiki's one accordion -- see templates/_accordion-item.twig #}
<div class="yw-accordion bazar-list no-dblclick {{ class }}" id="accordion{{ urlHash }}">
{% for page in syndication.pages %}
  {% set summary %}
        {% if page.date is not empty %}
        <small class="date_rss">{{ page.date }}</small>
        {% endif %}
        {% if showImage is not empty and page.image is not empty %}
        <img class="feed-img" src="{{ page.image }}" alt="" />
        {% endif %}
        {{ page.title }}
        {% if page.source is not empty %}
        <small>{{ _t('SYNDICATION_SOURCE') ~ ' : ' ~ page.source }}</small>
        {% endif %}
        {% if page.linkToEntry is not empty %}
          <a class="bazar-actions" onclick="event.stopPropagation();" href="{{ page.linkToEntry }}" title="{{ _t('BAZ_SEE_ENTRY') }}"><svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#eye"/></svg></a>
          <a class="bazar-actions" onclick="event.stopPropagation();" href="{{ page.linkToEntry ~ '/edit' }}" title="{{ _t('BAZ_MODIFIER_LA_FICHE') }}"><svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#edit"/></svg></a>
          <a class="bazar-actions text-danger" onclick="event.stopPropagation();" href="{{ page.linkToEntry ~ '/deletepage' }}" title="{{ _t('BAZ_SUPPRIMER_LA_FICHE') }}"><svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#trash"/></svg></a>
        {% endif %}
        {% if page.mappingInput is not empty %}
          <a class="bazar-actions" onclick="event.stopPropagation();" href="{{ url({ params: { mapping: page.mappingInput|e('url') }}) }}" title="{{ _t('SYNDICATION_COPY_IN_WIKI') }}"><svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#plus"/></svg></a>
        {% endif %}
  {% endset %}
  {% set body %}
        <div class="feed-description">
          {{ page.description|raw }}
        </div>
        <a class="btn btn-default" href="{{ page.url }}" {% if ext == true %}target="_blank"{% endif %}>
          {{ _t('SYNDICATION_SEE_ALL_CONTENT') }}
        </a>
  {% endset %}
  {% include '@core/_accordion-item.twig' with {
      class: 'bazar-entry',
      summary: summary,
      body: body
  } only %}
{% endfor %}
</div>
<!-- SYNDICATION accordeon end -->
