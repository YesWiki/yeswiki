<div class="bulle_microblog {{ class }}">
	<a class="lien_titre_accordeon" href="{{ lien }}">{{ nompage|raw }}</a>
	<div class="date_microblog">{{ date|raw }}</div>
	{# a caller-passed `user` string is printed; without one, `user` resolves to the
	   global user object (Twig merges globals into the context), which the historical
	   PHP template rendered as '' -- detect it by its `name` property #}
	<div class="auteur_microblog">de {{ user.name is defined ? '' : user|raw }}</div>
	<div class="accordeon_cache">
		<div class="billet_microblog">{{ billet|raw }}</div>
		<div class="commentaires_microblog">{{ commentaire|raw }}</div>		
		<div class="edition_billet_microblog">{{ edition|raw }}</div>	
	</div>
	<span class="spacer_microblog"></span>
</div>
