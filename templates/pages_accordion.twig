{% if elements|length > 0 %}
{# the historical nb_accordion counter never actually incremented (post-increment
   self-assignment), so the id was always accordion1 — kept as-is #}
{# the wiki's one accordion -- see templates/_accordion-item.twig #}
<div class="yw-accordion no-dblclick" id="accordion1">
{% for tag, element in elements %}
  {% set body %}
        {{ format('{{include page="' ~ tag ~ '"}}')|raw }}
        <div class="footer-buttons">
          <a href="{{ url({tag: tag}) }}" class="btn btn-primary"><i class="icon-eye-open icon-white"></i>&nbsp;{{ _t('TEMPLATE_VIEW_PAGE') }}</a>
          <div class="pull-right">
            {% if hasAccess('write') %}
            <a href="{{ url({tag: tag, handler: 'edit'}) }}" class="btn btn-default"><i class="icon-pencil"></i></a>
            {% endif %}
            {% if userIsAdmin() or userIsOwner() %}
            <a href="{{ url({tag: tag, handler: 'deletepage', params: {incomingurl: absoluteUrl()}}) }}" class="btn btn-danger modalbox"><i class="icon-trash icon-white"></i></a>
            {% endif %}
          </div>
          <div class="clearfix"></div>
        </div> <!-- /.footer-buttons -->
  {% endset %}
  {% include '@core/_accordion-item.twig' with {
      summary: element.title,
      body: body
  } only %}
{% endfor %}
</div>
{% endif %}
