<div class="aceditor-container" data-name="{{ arguments.name }}">
  <div class="scroll-container-toolbar">
    <div class="btn-toolbar aceditor-toolbar">
      {{ include('@core/aceditor-toolbar.twig') }}
    </div>
  </div>

  <div class="ace-container ace-editor-container">
    <pre class="ace-body"></pre>
  </div>

  {# No edit button of any kind: a rail opens on whatever the cursor moves into, be it a
     component or a link -- see javascripts/aceditor.js #}
  <textarea id="{{ arguments.name }}" name="{{ arguments.name }}" maxlength="{{ arguments.maxChars }}" rows="{{ arguments.rows }}" placeholder="{{ arguments.placeholder }}" {% if arguments.required is not empty %}required{% endif %}
            class="aceditor-textarea">
    {{- arguments.value|raw -}}
  </textarea>

</div>

<script>
  // Send data to javascript
  var actionsBuilderData = {{ actionsBuilderData|json_encode|raw }};
  var pageTags = {{ pageTags|json_encode|raw }}
</script>

{{ include_javascript(config.debug ? 'javascripts/vendor/vue/vue.js' : 'javascripts/vendor/vue/vue.min.js') }}
{{ include_javascript('javascripts/vendor/vue-select/vue-select.min.js') }}
{{ include_css('styles/vendor/vue-select/vue-select.css') }}

{{ include_javascript('javascripts/aceditor.js', false, true) }}
{{ include_css('styles/yw-editor.css') }}
