<form class="form-yeswiki-install" action="{{ baseUrl }}?PagePrincipale&installAction=install" method="post">

  {% if backupFound %}
    <div class="well">
      <h2>{{ _t('BACKUP_DB_FOUND') }}</h2>
      <div class="radio">
        <label>
          <input type="radio" name="contentSQL" value="{{ backupSqlFile }}" {% if contentSQL == backupSqlFile %}checked{% endif %}>
          <span>{{ _t('USE_BACKUP_DB') }}</span>
        </label>
      </div>
      <div class="radio">
        <label>
          <input type="radio" name="contentSQL" value="default" {% if contentSQL != backupSqlFile %}checked{% endif %}>
          <span>{{ _t('USE_DEFAULT_DB') }}</span>
        </label>
      </div>
    </div>
  {% else %}
    <input type="hidden" name="contentSQL" value="default" />
  {% endif %}

  <div class="row">
    <div class="col-md-4">
      <h3>{{ _t('GENERAL_CONFIGURATION') }}</h3>

      <details class="yw-accordion__item">
        <summary class="yw-accordion__summary">{{ _t('MORE_INFOS') }}</summary>
        <div class="yw-accordion__body accordion-inner">
              <dl>
                <dt>{{ _t('DEFAULT_LANGUAGE') }}</dt>
                <dd>{{ _t('DEFAULT_LANGUAGE_INFOS') }}</dd>
              </dl>
              <dl>
                <dt>{{ _t('YOUR_WEBSITE_NAME') }}</dt>
                <dd>{{ _t('YOUR_WEBSITE_NAME_INFOS') }}</dd>
              </dl>
              <dl>
                <dt>{{ _t('DESCRIPTION') }}</dt>
                <dd>{{ _t('DESCRIPTION_INFOS') }}</dd>
              </dl>
              <dl>
                <dt>{{ _t('KEYWORDS') }}</dt>
                <dd>{{ _t('KEYWORDS_INFOS') }}</dd>
              </dl>
              <dl>
                <dt>{{ _t('HOMEPAGE') }}</dt>
                <dd>{{ _t('HOMEPAGE_INFOS') }}</dd>
              </dl>
        </div>
      </details>

      <div class="yw-form-group">
        <label class="yw-form-label">{{ _t('DEFAULT_LANGUAGE') }}</label>
        <div class="col-sm-9">
          <select required autocomplete="off" class="yw-input" name="config[default_language]"
            {%- if env.default_language is defined %} disabled title="{{ _t('VARIABLE_ENV_NOT_MODIFIABLE') }}"
            {%- else %} onchange="const f = this.closest('.form-yeswiki-install'); f.action = '{{ baseUrl }}?installAction=default&lang=' + this.value; f.submit();"
            {%- endif %}>

            {% for lang in installedLanguages %}
              <option value="{{ lang }}" {% if lang == locale %}selected="selected"{% endif %}>{{ attribute(languagesList, lang).nativeName|capitalize }}</option>
            {% endfor %}
          </select>
        </div>
      </div>

      <div class="yw-form-group">
        <label class="yw-form-label">{{ _t('OTHER_LANGUAGES') }}</label>
        <div class="col-sm-9">
          <p class="help-block">{{ _t('OTHER_LANGUAGES_INFOS') }}</p>

          {% set mainLanguage = config.default_language|default(locale) %}
          {% for lang in installedLanguages|filter(lang => lang != mainLanguage) %}
            <label class="yw-checkbox-inline">
              <input type="checkbox" name="config[other_languages][]" value="{{ lang }}"
                {%- if lang in config.other_languages|default([]) %} checked{% endif %}>
              {{ attribute(languagesList, lang).nativeName|capitalize }}
            </label>
          {% endfor %}
        </div>
      </div>

      <div class="yw-form-group">
        <label class="yw-form-label">{{ _t('YOUR_WEBSITE_NAME') }}</label>
        <div class="col-sm-9">
          <input type="text" required class="yw-input" name="config[yeswiki_name]" {% if env.yeswiki_name is defined %}disabled title="{{ _t('VARIABLE_ENV_NOT_MODIFIABLE') }}" {% endif %}value="{{ config.yeswiki_name }}" />
        </div>
      </div>

      <div class="yw-form-group">
        <label class="yw-form-label">{{ _t('DESCRIPTION') }}</label>
        <div class="col-sm-9">
          <input type="text" class="yw-input" name="config[meta_description]" {% if env.meta_description is defined %}disabled title="{{ _t('VARIABLE_ENV_NOT_MODIFIABLE') }}" {% endif %}value="{{ config.meta_description }}" />
        </div>
      </div>

      <div class="yw-form-group">
        <label class="yw-form-label">{{ _t('KEYWORDS') }}</label>
        <div class="col-sm-9">
          <input type="text" class="yw-input" name="config[meta_keywords]" {% if env.meta_keywords is defined %}disabled title="{{ _t('VARIABLE_ENV_NOT_MODIFIABLE') }}" {% endif %}value="{{ config.meta_keywords }}" />
        </div>
      </div>

      <div class="yw-form-group">
        <label class="yw-form-label">{{ _t('HOMEPAGE') }}</label>
        <div class="col-sm-9">
          <input type="text" required class="yw-input" name="config[root_page]" {% if env.root_page is defined %}disabled title="{{ _t('VARIABLE_ENV_NOT_MODIFIABLE') }}" {% endif %}value="{{ config.root_page }}" pattern="{{ pattern }}" />
          <p class="help-block">{{ _t('MUST_BE_WIKINAME') }}</p>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <h3>{{ _t('DATABASE_CONFIGURATION') }}</h3>

      <details class="yw-accordion__item">
        <summary class="yw-accordion__summary">{{ _t('MORE_INFOS') }}</summary>
        <div class="yw-accordion__body accordion-inner">
              <dl>
                <dt>{{ _t('DATABASE_DRIVER') }}</dt>
                <dd>{{ _t('DATABASE_DRIVER_INFOS') }}</dd>
              </dl>
              <dl class="db-server-info">
                <dt>{{ _t('DATABASE_SERVER') }}</dt>
                <dd>{{ _t('DATABASE_SERVER_INFOS') }}</dd>
              </dl>
              <dl>
                <dt>{{ _t('DATABASE_NAME') }}</dt>
                <dd>{{ _t('DATABASE_NAME_INFOS') }}</dd>
              </dl>
              <dl class="db-server-info">
                <dt>{{ _t('DATABASE_USERNAME') }}</dt>
                <dd>{{ _t('DATABASE_USERNAME_INFOS') }}</dd>
              </dl>
              <dl>
                <dt>{{ _t('TABLE_PREFIX') }}</dt>
                <dd>{{ _t('TABLE_PREFIX_INFOS') }}</dd>
              </dl>
        </div>
      </details>

      <div class="yw-form-group">
        <label class="yw-form-label">{{ _t('DATABASE_DRIVER') }}</label>
        <div class="col-sm-9">
          <select class="yw-input" name="config[db_driver]" id="db_driver_select" {% if env.db_driver is defined %}disabled title="{{ _t('VARIABLE_ENV_NOT_MODIFIABLE') }}"{% endif %}>
            {% for driver, label in availableDrivers %}
              <option value="{{ driver }}" {% if driver == config.db_driver %}selected{% endif %}>{{ label }}</option>
            {% endfor %}
          </select>
          {% if availableDrivers is empty %}
            <p class="text-danger">{{ _t('NO_DATABASE_DRIVER_AVAILABLE') }}</p>
          {% elseif availableDrivers|length < 3 %}
            <p class="help-block text-muted">{{ _t('INSTALL_MORE_DB_DRIVERS') }}</p>
          {% endif %}
        </div>
      </div>

      <div class="yw-form-group db-server-field">
        <label class="yw-form-label">{{ _t('DATABASE_SERVER') }}</label>
        <div class="col-sm-9">
          <input type="text" class="yw-input" name="config[db_host]" id="db_host" {% if env.db_host is defined %}disabled title="{{ _t('VARIABLE_ENV_NOT_MODIFIABLE') }}" {% endif %}value="{{ config.db_host }}" />
        </div>
      </div>

      <div class="yw-form-group db-server-field">
        <label class="yw-form-label">{{ _t('DATABASE_NAME') }}</label>
        <div class="col-sm-9">
          <input type="text" class="yw-input" name="config[db_database]" id="db_database" {% if env.db_database is defined %}disabled title="{{ _t('VARIABLE_ENV_NOT_MODIFIABLE') }}" {% endif %}value="{{ config.db_database }}" />
        </div>
      </div>

      <div class="yw-form-group db-server-field">
        <label class="yw-form-label">{{ _t('DATABASE_USERNAME') }}</label>
        <div class="col-sm-9">
          <input type="text" class="yw-input" name="config[db_user]" id="db_user" {% if env.db_user is defined %}disabled title="{{ _t('VARIABLE_ENV_NOT_MODIFIABLE') }}" {% endif %}value="{{ config.db_user }}" />
        </div>
      </div>

      <div class="yw-form-group db-server-field">
        <label class="yw-form-label">{{ _t('DATABASE_PASSWORD') }}</label>
        <div class="col-sm-9">
          <input type="password" class="yw-input" name="config[db_password]" id="db_password" {% if env.db_password is defined %}disabled title="{{ _t('VARIABLE_ENV_NOT_MODIFIABLE') }}" {% endif %}value="{{ config.db_password }}" />
        </div>
      </div>

      <div class="yw-form-group">
        <label class="yw-form-label">{{ _t('TABLE_PREFIX') }}</label>
        <div class="col-sm-9">
          <input type="text" required class="yw-input" name="config[table_prefix]" {% if env.table_prefix is defined %}disabled title="{{ _t('VARIABLE_ENV_NOT_MODIFIABLE') }}" {% endif %}value="{{ config.table_prefix }}" />
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <h3>{{ _t('CREATION_OF_ADMIN_ACCOUNT') }}</h3>

      <details class="yw-accordion__item">
        <summary class="yw-accordion__summary">{{ _t('MORE_INFOS') }}</summary>
        <div class="yw-accordion__body accordion-inner">
              <dl>
                <dt class="admin">{{ _t('ADMIN_ACCOUNT_CAN') }}</dt>
                <dd class="droits-admin">
                  <ul>
                    <li>{{ _t('MODIFY_AND_DELETE_ANY_PAGE') }}</li>
                    <li>{{ _t('MODIFY_ACCESS_RIGHTS_ON_ANY_PAGE') }}</li>
                    <li>{{ _t('GENERATE_ACCESS_RIGHTS_ON_ANY_ACTION_OR_HANDLER') }}</li>
                    <li>{{ _t('GENERATE_GROUPS') }}</li>
                  </ul>
                </dd>
              </dl>
              <p>{{ _t('ALL_ADMIN_TASKS_ARE_DESCRIBED_IN_THE_PAGE') }}</p>
        </div>
      </details>

      {% if backupFound %}
        <div class="admin-message alert alert-info{% if contentSQL != backupSqlFile %} hide{% endif %}" style="margin-top:2em;">{{ _t('ADMIN_INFO_WHEN_BACKUP') }}.</div>
      {% endif %}
      <div class="admin-form{% if backupFound and contentSQL == backupSqlFile %} hide{% endif %}">

        <div class="yw-form-group">
          <label class="yw-form-label">{{ _t('ADMIN') }}</label>
          <div class="col-sm-9">
            <input type="text" required class="yw-input" name="admin_name" {% if adminEnvForced.name %}disabled title="{{ _t('VARIABLE_ENV_NOT_MODIFIABLE') }}" {% endif %}value="{{ adminName }}" />
            <p class="help-block">{{ _t('USERNAME_MUST_BE_WIKINAME') }}</p>
          </div>
        </div>

        <div class="yw-form-group">
          <label class="yw-form-label">{{ _t('PASSWORD') }}</label>
          <div class="col-sm-9">
            <input type="password" required class="yw-input" name="admin_password" {% if adminEnvForced.password %}disabled title="{{ _t('VARIABLE_ENV_NOT_MODIFIABLE') }}" {% endif %}value="{{ adminPassword }}" />
            <p class="help-block">{{ _t('PASSWORD_SHOULD_HAVE_5_CHARS_MINIMUM') }}</p>
          </div>
        </div>

        <div class="yw-form-group">
          <label class="yw-form-label">{{ _t('PASSWORD_CONFIRMATION') }}</label>
          <div class="col-sm-9">
            <input type="password" required class="yw-input" size="50" name="admin_password_conf" {% if adminEnvForced.password %}disabled title="{{ _t('VARIABLE_ENV_NOT_MODIFIABLE') }}" {% endif %}value="{{ adminPassword }}" />
          </div>
        </div>

        <div class="yw-form-group">
          <label class="yw-form-label">{{ _t('EMAIL_ADDRESS') }}</label>
          <div class="col-sm-9">
            <input type="email" required class="yw-input" name="admin_email" {% if adminEnvForced.email %}disabled title="{{ _t('VARIABLE_ENV_NOT_MODIFIABLE') }}" {% endif %}value="{{ adminEmail }}" />
          </div>
        </div>

      </div>
    </div>
  </div>

  <details class="yw-accordion__item">
    <summary class="yw-accordion__summary">
      <h3 class="accordion-heading">{{ _t('ADVANCED_CONFIGURATION') }}</h3>
    </summary>
    <div class="yw-accordion__body" id="collapseFour">
          <div class="yw-form-group">
            <label class="yw-form-label">{{ _t('BASE_URL') }}</label>
            <div class="col-sm-9">
              <input type="text" required class="yw-input" name="config[base_url]" {% if env.base_url is defined %}disabled title="{{ _t('VARIABLE_ENV_NOT_MODIFIABLE') }}" {% endif %}value="{{ config.base_url }}" />
              <p class="help-block">{{ _t('PAGENAME_WILL_BE_ADDED_AFTER_CHANGE_JUST_FOR_REDIRECTION') }}</p>
            </div>
          </div>

          <div class="checkbox">
            <label>
              <input type="hidden" name="config[rewrite_mode]" value="0" />
              <input type="checkbox" name="config[rewrite_mode]" value="1" {% if env.rewrite_mode is defined %}disabled title="{{ _t('VARIABLE_ENV_NOT_MODIFIABLE') }}" {% endif %}{% if config.rewrite_mode %}checked{% endif %} />
              <span>&nbsp;{{ _t('ACTIVATE_REDIRECTION_MODE') }}</span>
            </label>
            <p class="help-block">{{ _t('REDIRECTION_SHOULD_BE_ACTIVE_ONLY_IF_USED_IN_YESWIKI') }}.</p>
          </div>

          <div class="checkbox">
            <label>
              <input type="checkbox" name="config[allow_raw_html]" value="1" {% if env.allow_raw_html is defined %}disabled title="{{ _t('VARIABLE_ENV_NOT_MODIFIABLE') }}" {% endif %}{% if config.allow_raw_html %}checked{% endif %} />
              <span>&nbsp;{{ _t('AUTHORIZE_HTML_INSERTION') }}</span>
            </label>
            <p class="help-block">{{ _t('HTML_INSERTION_HELP_TEXT') }}.</p>
          </div>

          <div class="checkbox">
            <label>
              <input type="checkbox" name="config[allow_robots]" value="1" {% if env.allow_robots is defined %}disabled title="{{ _t('VARIABLE_ENV_NOT_MODIFIABLE') }}" {% endif %}{% if config.allow_robots ?? true %}checked{% endif %} />
              <span>&nbsp;{{ _t('AUTHORIZE_INDEX_BY_ROBOTS') }}</span>
            </label>
            <p class="help-block">{{ _t('INDEX_HELP_TEXT') }}.</p>
          </div>
    </div>
  </details>

  <div class="yw-form-group">
    <div class="col-sm-offset-3 col-sm-9">
      <input class="btn btn-lg btn-primary" type="submit" value="{{ _t('CONTINUE') }}" />
    </div>
  </div>

</form>

<style>
  input:not(:placeholder-shown):invalid,
  textarea:not(:placeholder-shown):invalid {
    border-color: #DD2C00;
  }

  .yw-input[disabled] {
    background-color: #bdbdbd;
  }
</style>
