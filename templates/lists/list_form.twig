{{ include_javascript(config.debug ? 'javascripts/vendor/vue/vue.js' : 'javascripts/vendor/vue/vue.min.js') }}

{{ include_javascript('javascripts/vendor/sortablejs/sortable.js') }}
{{ include_javascript('javascripts/vendor/vuedraggable/vuedraggable.js') }}
{{ include_javascript('javascripts/list-form.js', false, true) }}
{{ include_css('styles/yw-entries.css') }}

<form method="post" @submit="onSubmit" class="list-form" data-list="{{ list|json_encode }}">
	<div class="yw-form-group">
		<label class="yw-form-label">
			<span class="required_symbol">*&nbsp;</span>
			{{ _t('BAZ_LIST_NAME') }}
		</label>
		<div class="controls">
			<input type="text" v-model="title" name="title" 
			       placeholder="{{ _t('BAZ_LIST_NAME') }}" class="yw-input" required/>
		</div>
	</div>

	{# List Nodes #}
	<label class="yw-form-label">{{ _t('BAZ_VALEURS_LISTE') }}</label>
	<div class="nodes-container">
		<list-node :node="rootNode" :depth="0" :index="0"></list-node>
	</div>
	{# Hidden JSON Nodes #}
	<input type="hidden" name="nodes" :value="jsonNodes" />

	{# Form Actions #}
	<div class="form-actions yw-form-group">
		<div class="col-sm-9 col-sm-offset-3">
			<button class="btn btn-primary" type="submit" name="submit">
				{{ _t('BAZ_SAVE') }}
			</button>
			<a class="btn btn-default" href="{{ url({ params: { view: 'listes' }})|raw }}">
				{{ _t('BAZ_ANNULER') }}
			</a>
		</div>
	</div>
</div>
