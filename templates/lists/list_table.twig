{{ include_javascript('javascripts/list-import.js') }}

{% if lists|length == 0 %}
	<div class="yw-alert yw-alert--info">
		<a data-yw-dismiss="alert" class="yw-close">&times;</a>
		{{ _t('BAZ_INTRO_AJOUT_LISTE')|raw }}
	</div>
{% else %}
  <div class="table-responsive">
  <table id="existing-lists-table" class="yw-table" data-yw-datatable>
    <thead>
    <tr>
        <th>{{ _t('BAZ_TITLE') }}</th>
        <th>{{ _t('BAZ_VALEURS_LISTE') }}</th>
        <th style="width:180px;">{{ _t('BAZ_ID') }}</th>
        <th style="width:140px;">{{ _t('BAZ_ACTIONS') }}</th>
    </tr>
    </thead>
    <tbody>
    {% for key, list in lists %}
      <tr>
        <td>
          <strong>{{ list.title }}</strong>
        </td>
        <td>
          {% if list.options %}
            <select class="yw-input input-sm" id="liste_{{ key }}">
              <option>{{ _t('BAZ_CHOISIR') }}</option>
              {% for option in list.options %}
                <option>{{ option|raw }}</option>
              {% endfor %}
            </select>
          {% endif %}
        </td>
        <td>{{ key }}</td>
        <td>
          {% if list.canDuplicate %}
          <a class="yw-btn yw-btn--sm" href="{{ url({ params: { view: 'listes', action: 'duplicate', listid: key }}) }}">
            <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#copy"/></svg>
          </a>
          {% endif %}
          {% if list.canEdit %}
          <a class="yw-btn yw-btn--sm" href="{{ url({ params: { view: 'listes', action: 'modif_liste', listid: key }}) }}">
            <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#pencil"/></svg>
          </a>
          {% endif %}
          {% if list.canDelete %}
          <a
            class="yw-btn yw-btn--sm yw-btn--danger"
            href="{{ url({ params: { view: 'listes', action: 'supprimer_liste', listid: key }}) }}"
            onclick="javascript:return confirm('{{ _t('BAZ_CONFIRM_SUPPRIMER_LISTE') }} ?');"
          >
            <svg class="yw-icon icon-white" aria-hidden="true"><use href="src/assets/icons.svg#trash"/></svg>
          </a>
          {% endif %}
      </td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}

<a href="{{ url({ params: { view: 'listes', action: 'saisir_liste'}})|raw }}" class="yw-btn yw-btn--primary" {% if not canCreate %} disabled data-toggle="tooltip" data-placement="bottom" title="{{ _t('WIKI_IN_HIBERNATION') }}" {% endif %}>
	<svg class="yw-icon icon-plus icon-white" aria-hidden="true"><use href="src/assets/icons.svg#plus"/></svg>
	{{ _t('BAZ_NOUVELLE_LISTE') }}
</a>

<hr/>

{# LIST IMPORT #}

<strong>{{ _t('BAZ_IMPORT_LISTS_FROM_URL') }}</strong>
<form action="javascript:undefined" class="">
	<div class="input-prepend input-append input-group">
		<span class="add-on input-group-addon">
			<svg class="yw-icon icon-globe" aria-hidden="true"><use href="src/assets/icons.svg#link"/></svg>
		</span>
		<input id="url-import-lists" class="yw-input input-xxlarge" {% if not loggedUser %} disabled {% endif %} placeholder="{{ _t('BAZ_URL_IMPORT_LISTS_INFO') }}" type="url"/>
		<span class="input-group-btn">
			<button id="btn-import-lists" {% if not loggedUser %} disabled {% endif %} class="yw-btn yw-btn--primary" type="submit">
				{{ _t('BAZ_GO') }}&nbsp;!
			</button>
		</span>
	</div>
</form>
<br/>
<div id="import-lists-result"></div>
<form id="import-lists-form" action="" class="hide" method="post">
	<div class="table-responsive">
		<table id="import-lists-table" class="yw-table" style="table-layout:fixed;word-wrap: break-word;">
			<thead>
				<tr>
					<th style="width:35px;" class="prevent-sorting">
						<label class="check-all-container">
							<input data-target="#import-lists-table tbody" type="checkbox" class="selectall"/>
							<span></span>
						</label>
					</th>
					<th>{{ _t('BAZ_ID') }}</th>
					<th>{{ _t('BAZ_TITLE') }}</th>
					<th>{{ _t('BAZ_VALEURS_LISTE') }}</th>
				</tr>
			</thead>
			<tbody></tbody>
		</table>
	</div>
	<!-- /.table-responsive -->
	<div class="checkbox">
		<label class="checkbox">
			<input data-target="#import-lists-table tbody" type="checkbox" class="selectall"/>
			{{ _t('BAZ_SELECT_ALL') }}
		</label>
	</div>
	<button id="btn-import-selection" type="submit" class="yw-btn yw-btn--primary">
		{{ _t('BAZ_IMPORT_SELECTION') }}
	</button>
</form>
<div
  id="list-translations"
  data-nblistsfound="{{ _t('BAZ_NBLISTSFOUND') }}"
  data-noanswers="{{ _t('BAZ_NOANSWERS') }}"
  data-notvalidurl="{{ _t('BAZ_NOTVALIDURL') }}"
  data-choose="{{ _t('BAZ_CHOISIR') }}"
  data-recuperation="{{ _t('BAZ_RECUPERATION') }}"
  data-loading="{{ _t('BAZ_LOADING') }}"
  data-existingmessage="{{ _t('BAZ_EXISTINGMESSAGE') }}"
>
</div>
