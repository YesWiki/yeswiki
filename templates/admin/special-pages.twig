{% extends "@core/dashboard/layout.twig" %}

{# The special pages a wiki has: the ones that make up its chrome. GererSite listed these
   by hand in page content; here the list is declared once and each entry links straight
   to that page's editor. `exists` tells apart "edit it" from "create it". #}
{% block dashboard_content %}
  <h1>{{ _t('DASHBOARD_ADMIN_SPECIAL_PAGES') }}</h1>
  <p class="yw-dashboard__intro">{{ _t('ADMIN_SPECIAL_PAGES_INTRO') }}</p>

  {% for group in groups %}
    <section class="yw-dashboard__card yw-dashboard__card--wide">
      <h2>{{ group.label }}</h2>
      <ul class="yw-dashboard__links">
        {% for page in group.pages %}
          <li>
            <a href="{{ url({ tag: page.tag, handler: 'edit' }) }}">
              {{ icon(page.exists ? 'pencil' : 'square-plus') }} {{ page.label }}
            </a>
            <code>{{ page.tag }}</code>
            {% if not page.exists %}<em class="text-muted">{{ _t('ADMIN_SPECIAL_PAGES_MISSING') }}</em>{% endif %}
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endfor %}
{% endblock %}
