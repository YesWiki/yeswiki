{% extends "@core/dashboard/layout.twig" %}

{% block dashboard_content %}

  <link rel="stylesheet" data-yw-preset-faces
        href="{{ url({ tag: 'api/presets/fonts.css' }) }}">

  <div class="yw-preset-head">
    <h1>{{ _t('DASHBOARD_ADMIN_PRESET') }}</h1>

    <button type="button" class="yw-btn yw-preset-head__open" data-yw-preset-open>
      {{ icon('brush') }} {{ _t('ADMIN_PRESET_LIST') }}
    </button>
  </div>

  <p class="yw-dashboard__intro">
    {{ _t('ADMIN_PRESET_INTRO') }}
    {{ _t('ADMIN_PRESET_TRY_HINT') }}
  </p>

  {% if not configWritable %}
    <div class="alert alert-danger">{{ _t('ADMIN_PRESET_CONFIG_NOT_WRITABLE') }}</div>
  {% endif %}
  {% if not presetsWritable %}
    <div class="alert alert-warning">{{ _t('ADMIN_PRESET_DIR_NOT_WRITABLE') }}</div>
  {% endif %}

  <div class="yw-preset-preview page">
    {{ format(include('@core/admin/preset-preview.twig'))|raw }}
  </div>

  <aside class="yw-designer__sidebar yw-preset-rail" id="yw-preset-rail"

         data-yw-preset-ink-for="{{ inkFor|json_encode }}">

    <div class="yw-preset-rail__screen" data-yw-preset-screen="list">
      <div class="yw-rail__header">
        <h2 class="yw-rail__title">{{ _t('ADMIN_PRESET_LIST') }}</h2>
        <button type="button" class="yw-close" data-yw-preset-close-rail
                aria-label="close">&times;</button>
      </div>

      <button type="button" class="yw-btn yw-btn--primary yw-btn--block" data-yw-preset-new
              data-preset-values="{{ defaultValues|json_encode }}">
        {{ icon('plus') }} {{ _t('ADMIN_PRESET_NEW') }}
      </button>

    <ul class="yw-preset-cards">

      <li class="yw-preset-card{{ defaultPreset == '' ? ' yw-preset-card--default' : '' }}"
          data-yw-preset-card="">
        <button type="button" class="yw-preset-card__choose" data-yw-preset-try data-preset-href="">
          <span class="yw-preset-card__swatches yw-preset-card__swatches--none">{{ icon('ban') }}</span>
          <span class="yw-preset-card__label">
            <span class="yw-preset-card__name">{{ _t('ADMIN_PRESET_NONE') }}</span>
            <span class="yw-preset-card__badge">{{ _t('ADMIN_PRESET_NONE_HINT') }}</span>
          </span>
        </button>

        <div class="yw-preset-card__tools">

          {% if defaultPreset == '' %}
            <span class="yw-preset-card__star yw-preset-card__star--on"
                  title="{{ _t('ADMIN_PRESET_IS_DEFAULT') }}">{{ icon('star-filled') }}</span>
          {% else %}
            <form method="post" action="{{ url({ tag: 'admin/preset' }) }}" hx-boost="false">
              <input type="hidden" name="csrf-token" value="{{ csrfToken({id: 'main', refresh: false}) }}">
              <input type="hidden" name="preset_action" value="select">
              <input type="hidden" name="preset" value="">
              <button type="submit" class="yw-btn yw-btn--sm yw-preset-card__star"
                      title="{{ _t('ADMIN_PRESET_SET_DEFAULT') }}">{{ icon('star') }}</button>
            </form>
          {% endif %}
        </div>
      </li>

      {% for preset in presets %}
        <li class="yw-preset-card{{ preset.default ? ' yw-preset-card--default' : '' }}"
            data-yw-preset-card="{{ preset.id }}">
          <button type="button" class="yw-preset-card__choose" data-yw-preset-try
                  data-preset-href="{{ preset.href }}">
            <span class="yw-preset-card__swatches">
              {% for swatch in swatches %}
                <span class="yw-preset-card__swatch" style="background: {{ preset.values.light[swatch] }}"></span>
              {% endfor %}
            </span>
            <span class="yw-preset-card__label">

              <span class="yw-preset-card__name"
                    style="font-family: {{ preset.values.light['yw-font-heading'] }}; font-size: {{ preset.values.light['yw-font-size-base'] }}">
                {{ preset.name }}
              </span>
              <span class="yw-preset-card__badge">
                {{ preset.custom ? _t('ADMIN_PRESET_BADGE_CUSTOM') : _t('ADMIN_PRESET_BADGE_THEME') }}
              </span>

              {% if not preset.complete %}
                <span class="yw-preset-card__badge yw-preset-card__badge--incomplete"
                      data-yw-tooltip="{{ preset.missing|join(', ') }}">
                  {{ _t('ADMIN_PRESET_INCOMPLETE_BADGE')|replace({'{count}': preset.missing|length}) }}
                </span>
              {% endif %}
            </span>
          </button>

          <div class="yw-preset-card__tools">
            {% if preset.custom %}
              <button type="button" class="yw-btn yw-btn--sm" data-yw-preset-edit
                      data-preset-id="{{ preset.id }}"
                      data-preset-name="{{ preset.name }}"
                      data-preset-values="{{ preset.values|json_encode }}"
                      title="{{ _t('ADMIN_PRESET_EDIT') }}">
                {{ icon('pencil') }}
              </button>

              <form method="post" action="{{ url({ tag: 'admin/preset' }) }}" hx-boost="false"
                    data-yw-preset-delete-form
                    data-confirm="{{ _t('ADMIN_PRESET_DELETE_CONFIRM')|replace({'{name}': preset.name}) }}">
                <input type="hidden" name="csrf-token" value="{{ csrfToken({id: 'main', refresh: false}) }}">
                <input type="hidden" name="preset_action" value="delete">
                <input type="hidden" name="preset" value="{{ preset.id }}">
                <button type="submit" class="yw-btn yw-btn--sm yw-btn--danger"
                        title="{{ _t('ADMIN_PRESET_DELETE') }}">{{ icon('trash') }}</button>
              </form>
            {% else %}

              <form method="post" action="{{ url({ tag: 'admin/preset' }) }}" hx-boost="false"
                    data-yw-preset-duplicate-form>
                <input type="hidden" name="csrf-token" value="{{ csrfToken({id: 'main', refresh: false}) }}">
                <input type="hidden" name="preset_action" value="duplicate">
                <input type="hidden" name="preset" value="{{ preset.id }}">
                <button type="submit" class="yw-btn yw-btn--sm"
                        title="{{ _t('ADMIN_PRESET_DUPLICATE') }}">{{ icon('copy') }}</button>
              </form>
            {% endif %}

            <form method="post" action="{{ url({ tag: 'admin/preset' }) }}" hx-boost="false">
              <input type="hidden" name="csrf-token" value="{{ csrfToken({id: 'main', refresh: false}) }}">
              <input type="hidden" name="preset_action" value="select">
              <input type="hidden" name="preset" value="{{ preset.default ? '' : preset.id }}">
              <button type="submit"
                      class="yw-btn yw-btn--sm yw-preset-card__star{{ preset.default ? ' yw-preset-card__star--on' : '' }}"
                      title="{{ preset.default ? _t('ADMIN_PRESET_UNSET_DEFAULT') : _t('ADMIN_PRESET_SET_DEFAULT') }}">
                {{ preset.default ? icon('star-filled') : icon('star') }}
              </button>
            </form>
          </div>
        </li>
      {% endfor %}
    </ul>
    </div>

    <div class="yw-preset-rail__screen" data-yw-preset-screen="edit" hidden>
    <form method="post" action="{{ url({ tag: 'admin/preset' }) }}" hx-boost="false">
      <div class="yw-rail__header">

        <button type="button" class="yw-btn yw-btn--sm yw-rail__back" data-yw-preset-back
                aria-label="{{ _t('ADMIN_PRESET_LIST') }}">{{ icon('chevron-left') }}</button>

        <h2 class="yw-rail__title" data-yw-preset-rail-title
            data-edit-label="{{ _t('ADMIN_PRESET_EDIT') }}"
            data-new-label="{{ _t('ADMIN_PRESET_NEW') }}">{{ _t('ADMIN_PRESET_EDIT') }}</h2>
      </div>

      <input type="hidden" name="csrf-token" value="{{ csrfToken({id: 'main', refresh: false}) }}">
      <input type="hidden" name="preset_action" value="save">

      <input type="hidden" name="preset" value="" data-yw-preset-id>

      <p class="yw-preset-rail__scheme-note" data-yw-preset-scheme-note
         data-light="{{ _t('ADMIN_PRESET_EDITING_LIGHT') }}"
         data-dark="{{ _t('ADMIN_PRESET_EDITING_DARK') }}"></p>

      {% for group, groupLabel in groups %}
        <fieldset class="yw-preset-rail__group">
          <legend>{{ _t(groupLabel) }}</legend>

          {% if group == 'spacing' %}
            <p class="yw-preset-rail__hint">{{ _t('ADMIN_PRESET_MEASURE_HINT') }}</p>
          {% endif %}

          {% for row in rows[group] %}
            <div class="yw-preset-rail__row{{ row|length > 1 ? ' yw-preset-rail__row--split' : '' }}">
              {% for name in row %}
                {% set token = tokens[name] %}
                <div class="yw-form-group">
                  <label class="yw-form-label" for="yw-preset-light-{{ name }}">
                    <span class="yw-preset-rail__label-text">{{ _t(token.label) }}</span>

                    {% if token.contrast is defined %}
                      {% for scheme in schemes %}
                        <span class="yw-preset-rail__badge-slot" data-scheme="{{ scheme }}">
                          <span class="yw-preset-rail__contrast"
                                data-yw-preset-contrast="{{ scheme }}.{{ name }}"

                                data-against="{{ token.contrast == 'auto-ink' or '.' in token.contrast ? token.contrast : scheme ~ '.' ~ token.contrast }}"
                                title="{{ _t('ADMIN_PRESET_CONTRAST_HINT') }}"></span>
                        </span>
                      {% endfor %}
                    {% endif %}
                  </label>

                  {% if token.kind == 'color-fixed' %}

                    <div class="yw-preset-rail__color">
                      <input type="color" class="yw-preset-rail__picker"
                             data-yw-preset-picker="light.{{ name }}"
                             aria-label="{{ _t(token.label) }}">
                      <input type="text" class="yw-input" id="yw-preset-light-{{ name }}"
                             name="light[{{ name }}]"
                             data-yw-preset-field="light.{{ name }}"
                             autocomplete="off" spellcheck="false">
                    </div>

                  {% elseif token.kind == 'color' %}

                    {% for scheme in schemes %}
                      <div class="yw-preset-rail__scheme" data-scheme="{{ scheme }}">

                        <div class="yw-preset-rail__color">
                          <input type="color" class="yw-preset-rail__picker"
                                 data-yw-preset-picker="{{ scheme }}.{{ name }}"
                                 aria-label="{{ _t(token.label) }}">
                          <input type="text" class="yw-input" id="yw-preset-{{ scheme }}-{{ name }}"
                                 name="{{ scheme }}[{{ name }}]"
                                 data-yw-preset-field="{{ scheme }}.{{ name }}"
                                 autocomplete="off" spellcheck="false">

                          <button type="button" class="yw-btn yw-btn--sm yw-preset-rail__palette-open"
                                  data-yw-preset-palette-open="{{ scheme }}.{{ name }}"
                                  title="{{ _t('ADMIN_PRESET_PALETTE') }}"
                                  aria-haspopup="true">{{ icon('palette') }}</button>
                        </div>
                      </div>
                    {% endfor %}

                  {% elseif token.kind == 'size' %}

                    <div class="yw-preset-rail__size">
                      <input type="range" class="yw-preset-rail__slider" id="yw-preset-light-{{ name }}"
                             data-yw-preset-slider="light.{{ name }}"
                             min="{{ token.min }}" max="{{ token.max }}" step="{{ token.step }}"
                             data-unit="{{ token.unit }}"
                             aria-label="{{ _t(token.label) }}">
                      <output class="yw-preset-rail__size-value"
                              data-yw-preset-readout="light.{{ name }}"
                              for="yw-preset-light-{{ name }}"></output>
                      <input type="hidden" name="light[{{ name }}]" data-yw-preset-field="light.{{ name }}">
                    </div>

                  {% elseif token.kind == 'choice' %}

                    <select class="yw-input yw-preset-rail__choice" id="yw-preset-light-{{ name }}"
                            name="light[{{ name }}]" data-yw-preset-field="light.{{ name }}">
                      {% for value, optionLabel in token.options %}
                        <option value="{{ value }}">{{ _t(optionLabel) }}</option>
                      {% endfor %}
                    </select>

                  {% elseif token.kind == 'font' %}

                    <select class="yw-input yw-preset-rail__font" id="yw-preset-light-{{ name }}"
                            name="light[{{ name }}]" data-yw-preset-field="light.{{ name }}">

                      <optgroup label="{{ _t('ADMIN_PRESET_FONTS_LOCAL') }}">
                        {% for stackName, stack in fontStacks %}
                          <option value="{{ stack }}" style="font-family: {{ stack }}">{{ stackName }}</option>
                        {% endfor %}
                      </optgroup>
                      <optgroup label="{{ _t('ADMIN_PRESET_FONTS_WEB') }}">
                        {% for family, stack in webfonts %}
                          <option value="{{ stack }}" style="font-family: {{ stack }}">{{ family }}</option>
                        {% endfor %}
                      </optgroup>
                    </select>

                  {% else %}
                    <input type="text" class="yw-input" id="yw-preset-light-{{ name }}"
                           name="light[{{ name }}]" data-yw-preset-field="light.{{ name }}"
                           autocomplete="off" spellcheck="false">
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          {% endfor %}

          {% if group == 'type' %}
            <button type="button" class="yw-btn yw-btn--block"
                    data-yw-modal-target="#yw-preset-font-modal">
              {{ icon('download') }} {{ _t('ADMIN_PRESET_FONT_ADD_OPEN') }}
            </button>
          {% endif %}
        </fieldset>
      {% endfor %}

      <div class="yw-rail__footer yw-preset-rail__save">
        <input type="text" class="yw-input" id="yw-preset-name" name="preset_name" required
               autocomplete="off" pattern="[A-Za-z0-9_\- ]+"
               aria-label="{{ _t('ADMIN_PRESET_NAME') }}" placeholder="{{ _t('ADMIN_PRESET_NAME') }}">
        <button type="submit" class="yw-btn yw-btn--primary">{{ _t('SAVE') }}</button>
      </div>
    </form>

    <div class="yw-modal" id="yw-preset-font-modal" tabindex="-1" role="dialog"
         aria-labelledby="yw-preset-font-modal-title">
      <div class="yw-modal__dialog">
        <div class="yw-modal__content">

          <form method="post" action="{{ url({ tag: 'admin/preset' }) }}" hx-boost="false"
                data-yw-preset-font-form="{{ url({ tag: 'api/presets/fonts' }) }}"
                data-yw-preset-font-working="{{ _t('ADMIN_PRESET_FONT_WORKING') }}">
            <input type="hidden" name="csrf-token" value="{{ csrfToken({id: 'main', refresh: false}) }}">
            <input type="hidden" name="preset_action" value="install_font">

            <div class="yw-modal__header">
              <h3 class="yw-modal__title" id="yw-preset-font-modal-title">
                {{ _t('ADMIN_PRESET_FONT_MODAL_TITLE') }}
              </h3>
              <button type="button" class="yw-close" data-yw-dismiss="modal" aria-label="close">&times;</button>
            </div>

            <div class="yw-modal__body">
              <p class="yw-preset-rail__hint">{{ _t('ADMIN_PRESET_FONT_ADD_HINT') }}</p>

              <div class="yw-form-group">
                <label class="yw-form-label" for="yw-preset-font-family">
                  <span class="yw-preset-rail__label-text">{{ _t('ADMIN_PRESET_FONT_FAMILY') }}</span>
                </label>

                {{ include_javascript('javascripts/yw-tags-input.js') }}
                <div class="yw-tag-input" data-yw-tag-input data-yw-tag-input-closed
                     data-yw-tag-input-options="{}" data-yw-tag-input-limit="12"
                     data-yw-google-fonts="{{ googleFontsUrl }}">
                  <input type="text" class="yw-input yw-tag-input__search" id="yw-preset-font-family"
                         data-yw-tag-input-search autocomplete="off" spellcheck="false"
                         placeholder="{{ _t('ADMIN_PRESET_FONT_PLACEHOLDER') }}">
                  <ul class="yw-suggestions" data-yw-tag-input-suggestions hidden></ul>
                  <input type="hidden" name="font_family" data-yw-tag-input-value value="">
                </div>
              </div>
            </div>

            <p class="yw-preset-font-result" data-yw-preset-font-result role="status" hidden></p>

            <div class="yw-modal__footer">
              <button type="submit" class="yw-btn yw-btn--primary">
                {{ icon('download') }} {{ _t('ADMIN_PRESET_FONT_ADD') }}
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <div class="yw-preset-palette" id="yw-preset-palette" hidden>
      <div class="yw-preset-palette__head">
        <span>{{ _t('ADMIN_PRESET_PALETTE') }}</span>
        <button type="button" class="yw-close" data-yw-preset-palette-close
                aria-label="close">&times;</button>
      </div>
      <ul class="yw-preset-palette__list">
        {% for token in palette %}
          <li>
            <button type="button" class="yw-preset-palette__pick" data-yw-preset-palette-pick="{{ token }}">
              <span class="yw-preset-palette__chip" data-yw-preset-palette-chip="{{ token }}"></span>
              <span class="yw-preset-palette__name">{{ _t(tokens[token].label) }}</span>
            </button>
          </li>
        {% endfor %}

        <li>
          <button type="button" class="yw-preset-palette__pick yw-preset-palette__pick--own"
                  data-yw-preset-palette-pick="">
            {{ _t('ADMIN_PRESET_PALETTE_OWN') }}
          </button>
        </li>
      </ul>
    </div>
    </div>
  </aside>

  {{ include_css('styles/yw-admin.css') }}
  {{ include_javascript('javascripts/admin-preset.js', false, true) }}
{% endblock %}
