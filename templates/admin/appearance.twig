{% extends "@core/dashboard/layout.twig" %}

{# What GererThemes carried as page content: the per-page theme table, the wiki's default
   theme, and the two pages a webmaster edits by hand to go further. #}
{% block dashboard_content %}
  <h1>{{ _t('DASHBOARD_ADMIN_APPEARANCE') }}</h1>

  <p class="yw-dashboard__intro">
    <a class="yw-btn yw-btn--info" href="{{ url({ tag: 'LookWiki' }) }}">{{ _t('ADMIN_APPEARANCE_CUSTOMIZE') }}</a>
    <a class="yw-btn yw-btn--info" href="{{ url({ tag: 'PageCss' }) }}"
       title="{{ _t('ADMIN_APPEARANCE_CSS_HINT') }}">{{ _t('ADMIN_APPEARANCE_CSS') }}</a>
  </p>

  <section class="yw-dashboard__card yw-dashboard__card--wide">
    <h2>{{ _t('ADMIN_APPEARANCE_DEFAULT_THEME') }}</h2>
    {{ renderAction('setwikidefaulttheme')|raw }}
  </section>

  <section class="yw-dashboard__card yw-dashboard__card--wide">
    <h2>{{ _t('ADMIN_APPEARANCE_PAGE_THEMES') }}</h2>
    {{ renderAction('adminthemes')|raw }}
  </section>
{% endblock %}
