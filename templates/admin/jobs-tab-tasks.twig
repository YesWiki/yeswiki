{% if rows is empty %}
  <p class="yw-text-muted">{{ _t('ADMIN_JOBS_EMPTY_TASKS') }}</p>
{% else %}
  <div class="yw-jobs__scroll">
    <table class="yw-table yw-table--striped yw-table--condensed yw-jobs__table">
      <thead>
        <tr>
          <th>{{ _t('ADMIN_JOBS_COL_TASK') }}</th>
          <th>{{ _t('ADMIN_JOBS_COL_EVERY') }}</th>
          <th>{{ _t('ADMIN_JOBS_COL_LAST_RUN') }}</th>
          <th>{{ _t('ADMIN_JOBS_COL_RESULT') }}</th>
          <th>{{ _t('ADMIN_JOBS_COL_NEXT') }}</th>
          <th><span class="sr-only">{{ _t('ADMIN_JOBS_COL_ACTIONS') }}</span></th>
        </tr>
      </thead>
      <tbody>
        {% for row in rows %}
          <tr>
            <td>{{ row.label }}</td>
            <td>{{ row.every ?? '–' }}</td>
            <td>{{ row.lastRun ?? _t('ADMIN_JOBS_NEVER') }}</td>
            <td class="yw-jobs__error">
              {% if row.status is null %}
                –
              {% else %}
                <span class="{{ row.status == 'handled' ? 'yw-text-success' : (row.status in ['failed', 'killed'] ? 'yw-text-danger' : 'yw-text-warning') }}">{{ row.statusLabel }}</span>
                {% if row.failures > 1 %}<small>({{ _t('ADMIN_JOBS_FAILURES', { count: row.failures }) }})</small>{% endif %}
                {% if row.error and row.status != 'handled' %}<br><small>{{ row.error|length > 160 ? row.error|slice(0, 160) ~ '…' : row.error }}</small>{% endif %}
              {% endif %}
            </td>
            <td>
              {% if row.late %}
                <span class="yw-text-danger">{{ _t('ADMIN_JOBS_LATE', { ago: row.next }) }}</span>
              {% elseif row.due %}
                {{ _t('ADMIN_JOBS_DUE') }}
              {% else %}
                {{ row.next ?? '–' }}
              {% endif %}
            </td>
            <td>
              <button type="button" class="yw-btn yw-btn--sm"
                      hx-post="{{ url({ tag: 'api/admin/jobs/tasks/' ~ row.taskId|url_encode ~ '/run' }) }}" {{ statusSwap|raw }}>{{ _t('ADMIN_JOBS_RUN_TASK') }}</button>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endif %}
