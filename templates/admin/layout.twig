{% extends "@core/dashboard/layout.twig" %}

{% block dashboard_content %}
  <h1>{{ _t('DASHBOARD_ADMIN_LAYOUT') }}</h1>

  <p class="yw-dashboard__intro">{{ _t('ADMIN_LAYOUT_INTRO') }}</p>

  {% if not configWritable %}
    <div class="alert alert-danger">{{ _t('ADMIN_LAYOUT_CONFIG_NOT_WRITABLE') }}</div>
  {% endif %}

  <form method="post" action="{{ url({ tag: 'admin/layout' }) }}" hx-boost="false" class="yw-layout-form"
        data-yw-unsaved-guard
        hx-post="{{ url({ tag: 'admin/layout/preview' }) }}"
        hx-trigger="input delay:300ms, change delay:150ms, yw:layout-preview delay:150ms"
        hx-target="#yw-layout-chrome" hx-swap="innerHTML">
    <input type="hidden" name="csrf-token" value="{{ csrfToken({id: 'main', refresh: false}) }}">

    <section class="yw-dashboard__card">
      <h2>{{ _t('ADMIN_LAYOUT_BRAND') }}</h2>
      <p class="yw-layout__hint">{{ _t('ADMIN_LAYOUT_BRAND_HINT') }}</p>
      <p class="yw-layout__hint yw-layout__live">{{ icon('eye') }} {{ _t('ADMIN_LAYOUT_LIVE_HINT') }}</p>

      <div class="yw-form-group">
        <label class="yw-form-label" for="yw-layout-title">{{ _t('ADMIN_LAYOUT_TITLE') }}</label>

        <input type="text" class="yw-input" id="yw-layout-title" name="layout_title"
               value="{{ title }}" placeholder="{{ fallbackTitle }}" autocomplete="off">
        <small class="yw-form-hint">{{ _t('ADMIN_LAYOUT_TITLE_HINT') }}</small>
      </div>

      <div class="yw-form-group">
        <span class="yw-form-label">{{ _t('ADMIN_LAYOUT_LOGO') }}</span>
        <input type="hidden" id="yw-layout-logo" name="layout_logo" value="{{ logo }}"
               data-yw-layout-logo>

        <div class="yw-layout__logo-field">
          <img class="yw-layout__logo-preview" src="{{ logo }}" alt=""
               data-yw-layout-logo-preview{{ logo ? '' : ' hidden' }}>

          <button type="button" class="yw-btn" data-yw-file-picker-field="yw-layout-logo"
                  data-yw-file-picker-only="image">
            {{ icon('photo') }} {{ _t('ADMIN_LAYOUT_LOGO_CHOOSE') }}
          </button>
          <button type="button" class="yw-btn yw-layout__logo-remove" data-yw-layout-logo-remove
                  {{ logo ? '' : 'hidden' }}>
            {{ icon('x') }} {{ _t('ADMIN_LAYOUT_LOGO_REMOVE') }}
          </button>
        </div>
      </div>

      <fieldset class="yw-form-group yw-layout__modes">
        <legend class="yw-form-label">{{ _t('ADMIN_LAYOUT_BRAND_MODE') }}</legend>
        {% for mode in brandModes %}
          <label class="yw-layout__mode">
            <input type="radio" name="layout_brand" value="{{ mode }}"
                   {{ mode == brandMode ? 'checked' : '' }}>
            <span class="yw-layout__mode-label">{{ _t('ADMIN_LAYOUT_BRAND_MODE_' ~ mode|upper|replace({'-': '_'})) }}</span>
          </label>
        {% endfor %}
      </fieldset>

      <div class="yw-form-group">
        <label class="yw-form-label" for="yw-layout-navbar-height">
          {{ _t('ADMIN_LAYOUT_NAVBAR_HEIGHT') }}
        </label>
        <div class="yw-layout__slider">
          <input type="range" id="yw-layout-navbar-height" name="layout_navbar_height"
                 min="{{ navbarHeightMin }}" max="{{ navbarHeightMax }}" step="2"
                 value="{{ navbarHeight }}" data-yw-layout-height>
          <output for="yw-layout-navbar-height" data-yw-layout-height-value>{{ navbarHeight }}px</output>
        </div>
        <small class="yw-form-hint">{{ _t('ADMIN_LAYOUT_NAVBAR_HEIGHT_HINT') }}</small>
      </div>
    </section>

    <section class="yw-dashboard__card">
      <h2>{{ _t('ADMIN_LAYOUT_PLACEMENT') }}</h2>
      <p class="yw-layout__hint">{{ _t('ADMIN_LAYOUT_PLACEMENT_HINT') }}</p>

      <fieldset class="yw-form-group yw-layout__modes">
        <legend class="yw-form-label">{{ _t('ADMIN_LAYOUT_NAVBAR_POSITION') }}</legend>
        {% for position in navbarPositions %}
          <label class="yw-layout__mode">
            <input type="radio" name="layout_navbar_position" value="{{ position }}"
                   {{ position == navbarPosition ? 'checked' : '' }} data-yw-layout-navbar-position>
            <span class="yw-layout__mode-label">{{ _t('ADMIN_LAYOUT_NAVBAR_POSITION_' ~ position|upper) }}</span>
          </label>
        {% endfor %}
      </fieldset>

      <fieldset class="yw-form-group yw-layout__modes">
        <legend class="yw-form-label">{{ _t('ADMIN_LAYOUT_HEADER_POSITION') }}</legend>
        {% for position in headerPositions %}
          <label class="yw-layout__mode">
            <input type="radio" name="layout_header_position" value="{{ position }}"
                   {{ position == headerPosition ? 'checked' : '' }}>
            <span class="yw-layout__mode-label">{{ _t('ADMIN_LAYOUT_HEADER_POSITION_' ~ position|upper) }}</span>
          </label>
        {% endfor %}
      </fieldset>
    </section>

    <section class="yw-dashboard__card">
      <h2>{{ _t('ADMIN_LAYOUT_NAVBAR') }}</h2>
      <p class="yw-layout__hint">{{ _t('ADMIN_LAYOUT_NAVBAR_HINT') }}</p>

      <ul class="yw-layout__rows" data-yw-layout-rows="navbar">
        {% for row in navbarRows %}
          {{ include('@core/admin/layout-navbar-row.twig', { row: row, index: loop.index0 }) }}
        {% endfor %}
      </ul>

      <template data-yw-layout-template="navbar">
        {{ include('@core/admin/layout-navbar-row.twig', {
          row: { label: '', link: '', child: false }, index: 0
        }) }}
      </template>

      <button type="button" class="yw-btn" data-yw-layout-add="navbar">
        {{ icon('plus') }} {{ _t('ADMIN_LAYOUT_ADD_ENTRY') }}
      </button>
    </section>

    <section class="yw-dashboard__card">
      <h2>{{ _t('ADMIN_LAYOUT_QUICK_MENU') }}</h2>
      <p class="yw-layout__hint">{{ _t('ADMIN_LAYOUT_QUICK_MENU_HINT') }}</p>

      <ul class="yw-layout__rows" data-yw-layout-rows="quick">
        {% for row in quickMenu %}
          {{ include('@core/admin/layout-quick-row.twig', { row: row, index: loop.index0 }) }}
        {% endfor %}
      </ul>

      <template data-yw-layout-template="quick">
        {{ include('@core/admin/layout-quick-row.twig', {
          row: { icon: '', label: '', link: '' }, index: 0
        }) }}
      </template>

      <button type="button" class="yw-btn" data-yw-layout-add="quick">
        {{ icon('plus') }} {{ _t('ADMIN_LAYOUT_ADD_ENTRY') }}
      </button>

      <label class="yw-layout__checkbox">
        <input type="checkbox" name="layout_account_button" {{ accountButton ? 'checked' : '' }}>
        {{ _t('ADMIN_LAYOUT_ACCOUNT_BUTTON') }}
      </label>
    </section>

    <div class="yw-layout__save">
      <button type="submit" class="yw-btn yw-btn--primary">{{ _t('SAVE') }}</button>
    </div>
  </form>

  {% for page in pages %}
    <section class="yw-dashboard__card">
      <h2>{{ page.label }}</h2>
      <p class="yw-layout__hint">{{ _t('ADMIN_LAYOUT_PAGE_HINT_' ~ page.tag|upper) }}</p>

      <form method="post" action="{{ url({ tag: 'admin/layout/page' }) }}" hx-boost="false"
            class="yw-layout__page" data-yw-unsaved-guard>
        <input type="hidden" name="csrf-token" value="{{ csrfToken({id: 'main', refresh: false}) }}">
        <input type="hidden" name="tag" value="{{ page.tag }}">

        {{ renderAction('aceditor', {
          name: 'content_' ~ page.tag,
          value: page.content|escape('html'),
          rows: 8
        })|raw }}

        <div class="yw-layout__page-save">
          <button type="submit" class="yw-btn yw-btn--primary">{{ _t('SAVE') }}</button>
        </div>
      </form>
    </section>
  {% endfor %}

  {{ include('@core/aceditor-rails.twig') }}

  {{ include_css('styles/yw-admin.css') }}

  {{ include_javascript('javascripts/inputs/file-picker-field.js', false, true) }}
  {{ include_javascript('javascripts/admin-layout.js', false, true) }}
{% endblock %}
