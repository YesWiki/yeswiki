{# Shown once, right after the secret is written: the configuration keeps it, the page never shows it again. #}
{% if secret %}
  <div class="yw-jobs__notice yw-jobs__notice--success" role="status">
    <p>{{ _t('ADMIN_JOBS_SECRET_DONE') }}</p>
    <p><code class="yw-jobs__secret">{{ secret }}</code></p>
    <p>{{ _t('ADMIN_JOBS_SECRET_CALL') }}</p>
    <pre class="yw-jobs__secret">curl -X POST -H '{{ header }}: {{ secret }}' {{ url({ tag: 'api/queue/consume' }) }}</pre>
    <p>{{ _t('ADMIN_JOBS_SECRET_CALL_GET') }}</p>
    <pre class="yw-jobs__secret">{{ url({ tag: 'api/queue/consume', params: { (query): secret } }) }}</pre>
  </div>
{% else %}
  <p class="yw-jobs__notice yw-jobs__notice--danger" role="alert">{{ _t('ADMIN_JOBS_SECRET_FAILED') }}</p>
{% endif %}
