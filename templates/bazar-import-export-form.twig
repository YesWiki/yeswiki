<form id="form-bazar-import" method="post" class=""
  action="{{ url({params:params}) }}" {% block formDetails %}{% endblock %}>
  {% block formContent %}
    {% if not (forms|length > 0) %}
      <div class="yw-alert yw-alert--danger">{{ _t('BAZ_PAS_DE_FORMULAIRES_TROUVES') }}</div>
    {% else %}
      <div class="yw-form-group">
        <label class="yw-form-label">{% block label %}{{ _t('BAZ_TYPE_FICHE_EXPORT') }}{% endblock %} :</label>
        <div class="controls">
          <select class="yw-input" name="form_id" onchange="javascript:this.form.submit();">
            {% if not id or id == 0 %}

              <option value="" selected="selected">{{ _t('BAZ_CHOISIR') }}</option>
            {% endif %}

            {% for form in forms %}
              <option value="{{ form.id }}"
                  {{ id == form.id ? ' selected="selected"' }}>
                {{ form.label }}
              </option>
            {% endfor %}
          </select>
        </div>
      </div>
    {% endif %}
    {% block appendToForm %}
      {% if csv and selectedForm %}
        <em>
          {% block appendToFormLabel %}{{ _t('BAZ_VISUALISATION_FICHIER_CSV_A_EXPORTER') ~ selectedForm.label }}{% endblock %}
        </em>
        <pre class="precsv">
          {{- csv|raw -}}
        </pre>

        <a href="#" id="btnCSV" 
            class="yw-btn btn-neutral link-csv-file">
          <svg class="yw-icon" aria-hidden="true"><use href="src/assets/icons.svg#download"/></svg>
            {% block appendToFormButtonLabel %}{{- _t('BAZ_TELECHARGER_FICHIER_EXPORT_CSV') -}}{% endblock %}
        </a>
      {% endif %}
    {% endblock %}
  {% endblock %}
</form>

<script type="module">
	import { downloadCSV, removeCSVCrochet } from '/javascripts/bazar.js'

	window.addEventListener ("load", function ()
	{
		const cCSVBtn = document.getElementById('btnCSV');

		if (cCSVBtn !== null)
		{
			cCSVBtn.addEventListener('click', function ()
			{
				downloadCSV(removeCSVCrochet(document.querySelector('.precsv').innerHTML), '{% block downloadFileName %}{{filename}}{% endblock %}');return false;
			});		
		}
	});	  
</script>

