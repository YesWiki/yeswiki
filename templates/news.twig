<!-- this template is a duplicate of the agenda template, with some modification
To be relevant for news, like displaying news that have a date before today -->

{% if entries|length > 0 %}
{% set imgwidth = 450 %}
{% set imgheight = 450 %}

{% set entries = entries|sort((a, b) => timestamp(b.date|default('')) <=> timestamp(a.date|default(''))) %}

<div class="agenda-container">
  {% for entry in entries %}
  <div class="agenda-entry-container">
    <figure class="bazar-entry agenda-entry" {{ entry.html_data|raw }}>
      <div class="image">
        {% if entry.imagebf_image is defined and entry.imagebf_image is not empty %}
          <img loading="lazy" class="img-responsive" alt="" src="{{ resizedImage(entry.imagebf_image, imgwidth, imgheight, 'crop') }}">
        {% else %}
          <div class="trombi-image img-placeholder" aria-hidden="true"></div>
          <svg class="yw-icon trombi-image icon-placeholder" aria-hidden="true"><use href="src/assets/icons.svg#calendar"/></svg>
        {% endif %}
      </div>
      <fig-caption>
        {% set fdate = '@' ~ timestamp(entry.date|default('')) %}
        {% set moisfr = fdate|date('M')|replace({'Feb': 'fev', 'Apr': 'avr', 'May': 'mai', 'Jun': 'jui', 'Aug': 'aou'}) %}

        <div class="date"><span class="day">{{ fdate|date('d') }}</span><span class="month">{{ moisfr }}</span></div>
        <h5>{{ entry.title|raw }}</h5>
        {% if entry.content is defined and entry.content is not empty %}
            <div class='agenda-subtitle'>
              {{ entry.content|striptags }}
            </div>
        {% endif %}

        </p>
      </fig-caption>
      {% set useModal = params.modal|default('') == 1 %}
      <a class="{{ useModal ? 'modalbox' : '' }}"
         href="{{ url({tag: entry.tag}) }}">
      </a>
    </figure>
  </div>
  {% endfor %}
</div>

{{ include_css('styles/yw-entries.css') }}
{{ include_css('styles/yw-entries.css') }}
{% set width = params.columns|default('') is empty ? 25 : 100 / params.columns %}

{% endif %}

<style>
  .agenda-entry-container {
    width: {{ width|default(25) }}%;
    padding: 1rem;
  }
  @media (max-width: 900px) { .agenda-entry-container { width: 33%; } }
  @media (max-width: 700px) { .agenda-entry-container { width: 50%; } }

</style>
