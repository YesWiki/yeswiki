<div class="yw-form-group input-{{ field.type }} {% block groupClass %}{% endblock %}">
    <label class="yw-form-label">
        {#- No leading/trailing whitespace, see https://twig.symfony.com/doc/3.x/templates.html#templates-whitespace-control-#}
        {%- block label -%}
            {% if field.required %}<span class="symbole_obligatoire"></span>{% endif %}
            {% if field.hint %}
                <img loading="lazy" class="tooltip_aide" title="{{ field.hint|striptags }}" alt="{{ field.hint|striptags }}" src="images/bazar/aide.png" width="16" height="16" />
            {% endif %}
            {{ field.label|raw }}
        {%- endblock -%}
    </label>
    <div class="controls">
        {% block input %}
        {% endblock %}
        {% block submit %}
        {% endblock %}
    </div>
</div>
