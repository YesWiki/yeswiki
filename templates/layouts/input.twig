<div class="yw-form-group input-{{ field.type }} {% block groupClass %}{% endblock %}">
    <label class="yw-form-label">

        {%- block label -%}
            {% if field.required %}<span class="symbole_obligatoire"></span>{% endif %}
            {% if field.hint %}
                <span class="tooltip_aide" tabindex="0" role="img" aria-label="{{ field.hint|striptags }}" data-yw-tooltip="{{ field.hint|striptags }}">{{ icon('help-circle') }}</span>
            {% endif %}
            {{ field.label|raw }}
        {%- endblock -%}
    </label>
    <div class="controls">
        {% block input %}
        {% endblock %}
        {% block submit %}
        {% endblock %}
    </div>
</div>
