<div class="BAZ_rubrique field-{{ field.type}}" data-id="{{ field.propertyName }}">
    {% block label_container %}

        {% if field.label is not empty %}
        <span class="BAZ_label">
            {%- block label -%}{{ field.label|raw }}{%- endblock -%}
        </span>
        {% endif %}
    {% endblock %}
    {% block value_container %}
        <div class="BAZ_texte">
            {% block value %}{{ value }}{% endblock %}
        </div>
    {% endblock %}
</div>