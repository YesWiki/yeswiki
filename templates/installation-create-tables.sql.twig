<# Unified SQL template for creating YesWiki tables. #>
<# Works with MySQL, SQLite, and PostgreSQL. #>
<# Variable driver must be one of: mysql, sqlite, pgsql. #>
<# Custom Twig delimiters are used here, matching default-content.sql.twig, #>
<# because that other template embeds YesWiki own templating syntax verbatim. #>
<% set q = driver == 'mysql' ? '`' : '"' %>
<% set now = driver == 'sqlite' ? "datetime('now')" : 'NOW()' %>

<# Table: pages #>
CREATE TABLE IF NOT EXISTS [[ q ]]{{prefix}}pages[[ q ]] (
<% if driver == 'sqlite' %>
  "id" INTEGER PRIMARY KEY AUTOINCREMENT,
  "tag" TEXT NOT NULL,
  "time" TEXT NOT NULL,
  "body" TEXT NOT NULL,
  "owner" TEXT NOT NULL,
  "user" TEXT NOT NULL,
  "latest" TEXT NOT NULL DEFAULT 'N' CHECK("latest" IN ('Y', 'N')),
  "type" TEXT NOT NULL DEFAULT 'page',
  "parent" TEXT NOT NULL DEFAULT '',
  "metadata" TEXT DEFAULT NULL
<% elseif driver == 'pgsql' %>
  "id" SERIAL PRIMARY KEY,
  "tag" VARCHAR(191) NOT NULL,
  "time" TIMESTAMP NOT NULL,
  "body" TEXT NOT NULL,
  "owner" VARCHAR(191) NOT NULL,
  "user" VARCHAR(191) NOT NULL,
  "latest" VARCHAR(1) NOT NULL DEFAULT 'N' CHECK("latest" IN ('Y', 'N')),
  "type" VARCHAR(30) NOT NULL DEFAULT 'page',
  "parent" VARCHAR(191) NOT NULL DEFAULT '',
  "metadata" TEXT DEFAULT NULL
<% else %>
  `id` INT UNSIGNED NOT NULL AUTO_INCREMENT,
  `tag` VARCHAR(191) NOT NULL,
  `time` DATETIME NOT NULL,
  `body` LONGTEXT NOT NULL,
  `owner` VARCHAR(191) NOT NULL,
  `user` VARCHAR(191) NOT NULL,
  `latest` ENUM('Y','N') NOT NULL DEFAULT 'N',
  `type` VARCHAR(30) NOT NULL DEFAULT 'page',
  `parent` VARCHAR(191) NOT NULL DEFAULT '',
  `metadata` TEXT DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `idx_tag` (`tag`),
  KEY `idx_time` (`time`),
  KEY `idx_latest` (`latest`),
  KEY `idx_parent` (`parent`),
  KEY `idx_type` (`type`)
<# ticket 18: `body` used to carry a FULLTEXT index for a search that read it directly.
   Search reads its own index table now (ADR-0015), and nothing ever queried this one with
   MATCH ... AGAINST even before that -- all it did was amplify writes on a LONGTEXT column,
   on every page save. Existing installs lose it in 20260802120000_CreateSearchIndex. #>
<% endif %>
)<% if driver == 'mysql' %> CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci ENGINE=InnoDB<% endif %>;

<% if driver != 'mysql' %>
CREATE INDEX IF NOT EXISTS "{{prefix}}pages_idx_tag" ON "{{prefix}}pages" ("tag");
CREATE INDEX IF NOT EXISTS "{{prefix}}pages_idx_time" ON "{{prefix}}pages" ("time");
CREATE INDEX IF NOT EXISTS "{{prefix}}pages_idx_latest" ON "{{prefix}}pages" ("latest");
CREATE INDEX IF NOT EXISTS "{{prefix}}pages_idx_parent" ON "{{prefix}}pages" ("parent");
CREATE INDEX IF NOT EXISTS "{{prefix}}pages_idx_type" ON "{{prefix}}pages" ("type");
<% endif %>

<# Table: triples #>
CREATE TABLE IF NOT EXISTS [[ q ]]{{prefix}}triples[[ q ]] (
<% if driver == 'sqlite' %>
  "id" INTEGER PRIMARY KEY AUTOINCREMENT,
  "resource" TEXT NOT NULL,
  "property" TEXT NOT NULL,
  "value" TEXT NOT NULL
<% elseif driver == 'pgsql' %>
  "id" SERIAL PRIMARY KEY,
  "resource" VARCHAR(255) NOT NULL,
  "property" VARCHAR(255) NOT NULL,
  "value" TEXT NOT NULL
<% else %>
  `id` INT UNSIGNED NOT NULL AUTO_INCREMENT,
  `resource` VARCHAR(255) NOT NULL,
  `property` VARCHAR(255) NOT NULL,
  `value` TEXT NOT NULL,
  PRIMARY KEY (`id`),
  KEY `resource` (`resource`),
  KEY `property` (`property`)
<% endif %>
)<% if driver == 'mysql' %> CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci ENGINE=InnoDB<% endif %>;

<% if driver != 'mysql' %>
CREATE INDEX IF NOT EXISTS "{{prefix}}triples_idx_resource" ON "{{prefix}}triples" ("resource");
CREATE INDEX IF NOT EXISTS "{{prefix}}triples_idx_property" ON "{{prefix}}triples" ("property");
<% endif %>

<# Insert admin group and user -- the admin account is a `pages` row of type 'user' #>
<# (see UserManager), not a standalone `users` table row #>
<% if driver == 'mysql' %>
INSERT INTO [[ q ]]{{prefix}}triples[[ q ]] ([[ q ]]id[[ q ]], [[ q ]]resource[[ q ]], [[ q ]]property[[ q ]], [[ q ]]value[[ q ]]) VALUES
(1, 'ThisWikiGroup:admins', 'http://www.wikini.net/_vocabulary/acls', '{{WikiName}}');

INSERT INTO [[ q ]]{{prefix}}pages[[ q ]] ([[ q ]]tag[[ q ]], [[ q ]]time[[ q ]], [[ q ]]body[[ q ]], [[ q ]]owner[[ q ]], [[ q ]]user[[ q ]], [[ q ]]latest[[ q ]], [[ q ]]type[[ q ]], [[ q ]]parent[[ q ]], [[ q ]]metadata[[ q ]]) VALUES
('{{WikiName}}', [[ now ]], '{{adminUserBody}}', '{{WikiName}}', '{{WikiName}}', 'Y', 'user', '', '{{adminUserMetadata}}');
<% else %>
INSERT INTO [[ q ]]{{prefix}}triples[[ q ]] ([[ q ]]resource[[ q ]], [[ q ]]property[[ q ]], [[ q ]]value[[ q ]]) VALUES
('ThisWikiGroup:admins', 'http://www.wikini.net/_vocabulary/acls', '{{WikiName}}');

INSERT INTO [[ q ]]{{prefix}}pages[[ q ]] ([[ q ]]tag[[ q ]], [[ q ]]time[[ q ]], [[ q ]]body[[ q ]], [[ q ]]owner[[ q ]], [[ q ]]user[[ q ]], [[ q ]]latest[[ q ]], [[ q ]]type[[ q ]], [[ q ]]parent[[ q ]], [[ q ]]metadata[[ q ]]) VALUES
('{{WikiName}}', [[ now ]], '{{adminUserBody}}', '{{WikiName}}', '{{WikiName}}', 'Y', 'user', '', '{{adminUserMetadata}}');
<% endif %>
