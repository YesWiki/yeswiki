{% import "@core/multidelete-macro.twig" as multidelete %}

<div id='comments-table-action'>

  <table class="yw-table" data-yw-datatable data-yw-datatable-sort="1,desc">
    <thead>
      <tr>
        {{ multidelete.insertSelectAll('comments-table-action','top') }}
        <th>{{ _t('COMMENT_DATE') }}</th>
        <th>{{ _t('COMMENT_CONTENT') }}</th>
        <th class="comments-table-break-word-column">{{ _t('COMMENT_USER') }}</th>
        <th class="comments-table-break-word-column">{{ _t('COMMENT_TAG') }}</th>
        <th class="comments-table-break-word-column">{{ _t('COMMENT_ON_PAGE') }}</th>
        <th data-yw-no-sort>{{ _t('MODIFY') }}</th>
        <th data-yw-no-sort>{{ _t('DELETE') }}</th>
      </tr>
    </thead>
    <tbody>
      {% for com in comments %}
        <tr>
          {{ multidelete.insertSelectLine(
                'comments-table-action',
                com.tag,
                not hasAcl(com.owner),
                'comments') }}
          <td>{{ com.time }}</td>
          <td>{{ format(com.body)|raw  }}</td>
          <td>{{ com.owner }}</td>
          <td>{{ com.tag }}</td>
          <td>{% set tagAnchor = com.parentTag ?? com.parent %}<a class="new-window" href="{{ url({tag:tagAnchor}) }}">{{ tagAnchor }}</a></td>
          <td>

            {% if hasAcl(com.owner) %}
              <a href="{{ url({tag:com.tag,handler:'edit'}) }}"
                class="yw-btn yw-btn--sm yw-btn--warning new-window" role="button"
                title="{{ _t('MODIFY') }} {{ com.tag }}">
                {{ _t('MODIFY') }}
              </a>
            {% endif %}
          </td>
          <td>
            {% if hasAcl(com.owner) %}
              <a
                data-toggle="modal"
                role="button"
                href="#commentsTableDeleteModal"
                class="yw-btn yw-btn--sm yw-btn--danger"
                data-name="{{ com.tag }}"
                title="{{ _t('COMMENT_DELETE') }}">
                {{ _t('DELETE') }}
              </a>
            {% endif %}
          </td>
      {% endfor %}
    </tbody>
    <tfoot>
      <tr>
        {{ multidelete.insertSelectAll('comments-table-action','bottom') }}
        <th></th>
        <th></th>
        <th></th>
        <th></th>
        <th></th>
        <th></th>
      </tr>
    </tfoot>
  </table>
  {{ multidelete.insertButton('comments-table-action','comments') }}
</div>

<div class="yw-modal"
  id="commentsTableDeleteModal"
  tabindex="-1"
  role="dialog"
  aria-labelledby="commentsTableDeleteModalLabel">
  <div class="yw-modal__dialog yw-modal__dialog--lg">
    <div class="yw-modal__content">
      <div class="yw-modal__header">
        <h3 class="yw-modal__title" id="commentsTableDeleteModalLabel">{{ _t('COMMENT_DELETE') }} : <span id="commentToDelete"></span></h3>
        <button type="button" class="yw-close" data-yw-dismiss="modal" aria-label="close">&times;</button>
      </div>
      <div class="yw-modal__body">
        <div class="yw-alert yw-alert--warning">
          {{ _t('COMMENT_CONFIRM_DELETE') }}
        </div>
        <button class="yw-btn yw-btn--sm yw-btn--warning start-btn-delete-comment">{{ _t('DELETE') }}</button>
        <br/><br/>
        <div class="multi-delete-results"></div>
      </div>
      <div class="yw-modal__footer">
        <div class="yw-progressbar">
          <div class="yw-progressbar__bar" role="progressbar"
            style="width: 0%;"
            aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
          </div>
        </div>
      </div>
    </div>
  </div>
</div>