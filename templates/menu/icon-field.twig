{# A node's icon: a sprite symbol, an emoji or a file of the wiki, chosen through the shared icon picker. #}
<span class="yw-icon-field" data-yw-icon-field>
  <input type="hidden" name="{{ name }}[icon_source]" value="{{ source }}" data-yw-icon-field-source>
  <input type="hidden" name="{{ name }}[icon_value]" value="{{ value }}" data-yw-icon-field-value>
  <button type="button" class="yw-input yw-icon-field__button" data-yw-icon-field-open
          title="{{ _t('ICON_PICKER_TITLE') }}" aria-label="{{ _t('ICON_PICKER_TITLE') }}">
    <span class="yw-icon-field__preview" data-yw-icon-field-preview>{{ nodeIcon(source, value) }}</span>
  </button>
</span>
