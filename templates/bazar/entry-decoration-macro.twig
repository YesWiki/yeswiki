
{% macro pellet(params, entry) %}
{%- set color = customValueForEntry(params.color|default(''), params.colorfield|default(''), entry, '') -%}
{%- if color is not empty %}<span class="pellet" style="background-color:{{ color }};"></span> {% endif -%}
{% endmacro %}

{% macro icon(params, entry) %}
{%- set icon = customValueForEntry(params.icon|default(''), params.iconfield|default(''), entry, '') -%}
{%- if icon is not empty %}<i class="{{ icon }}"></i> {% endif -%}
{% endmacro %}
