{% if entries|length > 0 %}
{% set imgwidth = 450 %}
{% set imgheight = 450 %}

<div class="agenda-container">
  {% for entry in entries %}
  <div class="agenda-entry-container">
    <figure class="bazar-entry agenda-entry" {{ entry.html_data|raw }}>
      <div class="image">
        {% if entry.imagebf_image is defined and entry.imagebf_image != '' %}
          <img loading="lazy" class="img-responsive" alt=""
            src="{{ entry['external-data'] is defined
              ? entry['external-data'].baseUrl ~ 'cache/image_' ~ imgwidth ~ 'x' ~ imgheight ~ '_' ~ entry.imagebf_image
              : resizedImage(entry.imagebf_image, imgwidth, imgheight, 'crop') }}"
              {{ entry['external-data'] is defined
                ? 'onerror="this.src=\'' ~ entry['external-data'].baseUrl ~ 'files/' ~ entry.imagebf_image ~ '\'"'
                : '' }}>
        {% else %}
          <div class="trombi-image img-placeholder" aria-hidden="true"></div>
          <svg class="yw-icon trombi-image icon-placeholder" aria-hidden="true"><use href="src/assets/icons.svg#calendar"/></svg>
        {% endif %}
      </div>
      <fig-caption>
        {% set moisfr = entry.bf_date_debut_evenement|date('M')|replace({'Feb': 'fev', 'Apr': 'avr', 'May': 'mai', 'Jun': 'jui', 'Aug': 'aou'}) %}
        <div class="date"><span class="day">{{ entry.bf_date_debut_evenement|slice(8, 2) }}</span><span class="month">{{ moisfr }}</span></div>
        <h5>{{ entry.title|raw }}</h5>
        {% if entry.soustitre is defined and entry.soustitre is not empty %}
          {% set soustitre = format(entry.soustitre)|striptags('<br>')|nl2br %}
            <small class='agenda-subtitle'>
              {{ (soustitre|slice(0, 280) ~ (soustitre|length > 280 ? '...' : ''))|raw }}
            </small>
        {% endif %}

        </p>
      </fig-caption>
      {% set useModal = params.modal|default('') == 1 %}
      <a class="{{ useModal ? 'modalbox' : '' }}"
         title="{{ entry.title|striptags }}"
         href="{{ entry.url|raw }}{{ (entry['external-data'] is defined and useModal) ? '/iframe" data-iframe="1' : '' }}">
      </a>
    </figure>
  </div>
  {% endfor %}
</div>

{{ include_css('styles/yw-entries.css') }}
<style>
  {% set width = params.columns|default('') is empty ? 25 : 100 / params.columns %}
  .agenda-entry-container {
    width: {{ width }}%;
    padding: 1rem;
  }
  @media (max-width: 900px) { .agenda-entry-container { width: 33%; } }
  @media (max-width: 700px) { .agenda-entry-container { width: 50%; } }

</style>

{% endif %}
{{ pager_links|raw }}
