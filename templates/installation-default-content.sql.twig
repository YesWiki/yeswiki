<# The rows every fresh wiki starts with, for MySQL, SQLite and PostgreSQL. #>
<# Twig delimiters are changed because page bodies hold YesWiki's own {{ }} syntax; #>
<# {{prefix}}, {{WikiName}} and the like are replaced afterwards by InstallationService. #>
<% set q = driver == 'mysql' ? '`' : '"' %>
<% set now = driver == 'sqlite' ? "datetime('now')" : 'now()' %>

INSERT INTO [[ q ]]{{prefix}}pages[[ q ]] ([[ q ]]tag[[ q ]], [[ q ]]time[[ q ]], [[ q ]]body[[ q ]], [[ q ]]owner[[ q ]], [[ q ]]user[[ q ]], [[ q ]]latest[[ q ]], [[ q ]]type[[ q ]], [[ q ]]parent[[ q ]]) VALUES
('BacASable',  [[ now ]], '{"content": "# Bac à sable\nCette page est faite pour essayer. Modifiez-la, cassez-la, rien de grave : chaque version est gardée.\n\n## Premiers défis\n1. **Écrire dans cette page** : cliquez sur « Éditer la page » en bas, ou double-cliquez dans la page. Écrivez ce que vous voulez, puis cliquez sur « Sauver ».\n2. **Insérer un bouton** : en édition, placez votre curseur, cliquez sur « Composants » puis « Bouton » et laissez-vous guider.\n3. **Modifier ce bouton** : en édition, cliquez sur la ligne du bouton. Un petit crayon apparaît dans la marge : il rouvre les paramètres.\n4. **Revenir en arrière** : cliquez sur la date de dernière édition en bas de la page, choisissez une version et restaurez-la.\n5. **Insérer une image** : en édition, cliquez sur « Fichier » dans la barre d''édition et choisissez une image sur votre ordinateur.\n\n## L''essentiel de la syntaxe\n| Vous écrivez | Vous obtenez |\n| --- | --- |\n| `**gras**` | **gras** |\n| `*italique*` | *italique* |\n| `~~barré~~` | ~~barré~~ |\n| `[un lien](https://yeswiki.net)` | [un lien](https://yeswiki.net) |\n| `[une page du wiki](BacASable)` | [une page du wiki](BacASable) |\n\n### Titres\n```\n# Titre de niveau 1\n## Titre de niveau 2\n### Titre de niveau 3\n```\n\n### Listes\n```\n- un élément\n- un autre\n  - un sous-élément\n\n1. premier\n2. deuxième\n```\n\n### Citation\n```\n> Une phrase citée.\n```\n\n> Une phrase citée.\n\n### Image\n```\n![texte alternatif](https://adresse-de-l-image.png)\n```\n\n### Tableau\n```\n| Nom | Couleur |\n| --- | --- |\n| Gaston | jaune |\n| Jeanne | vert |\n```\n\n| Nom | Couleur |\n| --- | --- |\n| Gaston | jaune |\n| Jeanne | vert |\n\n### Ligne de séparation\n```\n---\n```\n\nPour tout le reste (sections, colonnes, boutons, formulaires), passez par le menu « Composants » de la barre d''édition."}', '{{WikiName}}', '{{WikiName}}', 'Y', 'page', ''),
('PageFooter',  [[ now ]], '{"content":"{{section class=\"text-center\"}}\n{{yeswikiversion}}\n{{end elem=\"section\"}}"}', '{{WikiName}}', '{{WikiName}}', 'Y', 'page', ''),
('PageHeader',  [[ now ]], '{"content":""}', '{{WikiName}}', '{{WikiName}}', 'Y', 'page', '');

