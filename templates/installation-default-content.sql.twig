<# Unified SQL template for default YesWiki content (pages, forms, demo entries). #>
<# Works with MySQL, SQLite, and PostgreSQL. #>
<# Variable driver must be one of: mysql, sqlite, pgsql. #>
<# Custom Twig delimiters are used here because YesWiki own templating syntax is #>
<# embedded verbatim in the page content below and must not be parsed by Twig. #>
<# The double curly brace placeholders below, prefix, WikiName, rootPage, url and #>
<# so on, are resolved afterwards by querySqlFile through plain string replacement. #>
<% set q = driver == 'mysql' ? '`' : '"' %>
<% set now = driver == 'sqlite' ? "datetime('now')" : 'now()' %>
<% set cmt = driver == 'mysql' ? '#' : '--' %>

