<a
  href="#search"
  class="btn btn-default navbar-btn"
  title="{{ _t('TEMPLATE_SEARCH') }}"
>
  {{ icon('search') }}
  <span class="sr-only"> {{ _t('TEMPLATE_SEARCH') }} </span>
</a>
<div id="search" class="hide">
  <button type="button" class="btn btn-default close-search">&times;</button>
  <form
    class="yeswiki-search-form navbar-search navbar-form {{ class }}"
    method="get"
    action="{{ url }}"
    role="search"
  >
    <div class="yw-form-group form-group-lg">
      <div class="input-group input-append">
        <input
          type="text"
          class="search-query yw-input"
          placeholder="{{ _t('TEMPLATE_SEARCH_PLACEHOLDER') }}"
          value="{{ phrase }}"
          title="{{ _t('TEMPLATE_SEARCH_INPUT_TITLE') }}"
          accesskey="C"
          tabindex="1"
          name="phrase"
        />
        <span class="input-group-btn">
          <button
            type="submit"
            class="btn btn-default btn-lg btn-search search-btn"
            title="{{ _t('TEMPLATE_SEARCH_BUTTON_TITLE') }}"
          >
            {{ icon('search') }}
          </button>
        </span>
      </div>
    </div>
    <input type="hidden" value="RechercheTexte" name="wiki" />
  </form>
  <!-- /.yeswiki-search-form -->
</div>
