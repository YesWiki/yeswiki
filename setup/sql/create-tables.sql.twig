{# Unified SQL template for creating YesWiki tables #}
{# Works with MySQL, SQLite, and PostgreSQL #}
{# Variable 'driver' must be one of: 'mysql', 'sqlite', 'pgsql' #}

{# Table: acls #}
CREATE TABLE IF NOT EXISTS {% if driver == 'mysql' %}`{{ prefix }}acls`{% else %}"{{ prefix }}acls"{% endif %} (
  {% if driver == 'mysql' %}`page_tag`{% else %}"page_tag"{% endif %} {% if driver == 'sqlite' %}TEXT{% else %}VARCHAR(191){% endif %} NOT NULL,
  {% if driver == 'mysql' %}`privilege`{% else %}"privilege"{% endif %} {% if driver == 'sqlite' %}TEXT{% else %}VARCHAR(20){% endif %} NOT NULL,
  {% if driver == 'mysql' %}`list`{% else %}"list"{% endif %} TEXT NOT NULL,
  PRIMARY KEY ({% if driver == 'mysql' %}`page_tag`, `privilege`{% else %}"page_tag", "privilege"{% endif %})
){% if driver == 'mysql' %} CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci ENGINE=InnoDB{% endif %};

{# Table: links #}
CREATE TABLE IF NOT EXISTS {% if driver == 'mysql' %}`{{ prefix }}links`{% else %}"{{ prefix }}links"{% endif %} (
{% if driver == 'sqlite' %}
  "id" INTEGER PRIMARY KEY AUTOINCREMENT,
  "from_tag" TEXT NOT NULL,
  "to_tag" TEXT NOT NULL,
  UNIQUE ("from_tag", "to_tag")
{% elseif driver == 'pgsql' %}
  "id" SERIAL PRIMARY KEY,
  "from_tag" VARCHAR(191) NOT NULL,
  "to_tag" VARCHAR(191) NOT NULL,
  UNIQUE ("from_tag", "to_tag")
{% else %}
  `id` INT UNSIGNED NOT NULL AUTO_INCREMENT,
  `from_tag` VARCHAR(191) NOT NULL,
  `to_tag` VARCHAR(191) NOT NULL,
  PRIMARY KEY (`id`),
  UNIQUE KEY `from_tag` (`from_tag`, `to_tag`)
{% endif %}
){% if driver == 'mysql' %} CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci ENGINE=InnoDB{% endif %};

{# Table: nature (forms) #}
CREATE TABLE IF NOT EXISTS {% if driver == 'mysql' %}`{{ prefix }}nature`{% else %}"{{ prefix }}nature"{% endif %} (
{% if driver == 'sqlite' %}
  "bn_id_nature" INTEGER PRIMARY KEY AUTOINCREMENT,
  "bn_label_nature" TEXT DEFAULT NULL,
  "bn_description" TEXT DEFAULT NULL,
  "bn_condition" TEXT DEFAULT NULL,
  "bn_sem_context" TEXT DEFAULT NULL,
  "bn_sem_type" TEXT DEFAULT NULL,
  "bn_sem_use_template" INTEGER NOT NULL DEFAULT 1,
  "bn_template" TEXT NOT NULL,
  "bn_ce_i18n" TEXT NOT NULL,
  "bn_only_one_entry" TEXT NOT NULL DEFAULT 'N' CHECK("bn_only_one_entry" IN ('Y', 'N')),
  "bn_only_one_entry_message" TEXT DEFAULT NULL
{% elseif driver == 'pgsql' %}
  "bn_id_nature" SERIAL PRIMARY KEY,
  "bn_label_nature" VARCHAR(255) DEFAULT NULL,
  "bn_description" TEXT DEFAULT NULL,
  "bn_condition" TEXT DEFAULT NULL,
  "bn_sem_context" TEXT DEFAULT NULL,
  "bn_sem_type" VARCHAR(255) DEFAULT NULL,
  "bn_sem_use_template" SMALLINT NOT NULL DEFAULT 1,
  "bn_template" TEXT NOT NULL,
  "bn_ce_i18n" VARCHAR(5) NOT NULL,
  "bn_only_one_entry" VARCHAR(1) NOT NULL DEFAULT 'N' CHECK("bn_only_one_entry" IN ('Y', 'N')),
  "bn_only_one_entry_message" TEXT DEFAULT NULL
{% else %}
  `bn_id_nature` INT UNSIGNED NOT NULL AUTO_INCREMENT,
  `bn_label_nature` VARCHAR(255) DEFAULT NULL,
  `bn_description` TEXT DEFAULT NULL,
  `bn_condition` TEXT DEFAULT NULL,
  `bn_sem_context` TEXT DEFAULT NULL,
  `bn_sem_type` VARCHAR(255) DEFAULT NULL,
  `bn_sem_use_template` TINYINT(1) NOT NULL DEFAULT 1,
  `bn_template` TEXT NOT NULL,
  `bn_ce_i18n` VARCHAR(5) NOT NULL,
  `bn_only_one_entry` ENUM('Y','N') NOT NULL DEFAULT 'N',
  `bn_only_one_entry_message` TEXT DEFAULT NULL,
  PRIMARY KEY (`bn_id_nature`)
{% endif %}
){% if driver == 'mysql' %} CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci ENGINE=InnoDB{% endif %};

{# Table: pages #}
CREATE TABLE IF NOT EXISTS {% if driver == 'mysql' %}`{{ prefix }}pages`{% else %}"{{ prefix }}pages"{% endif %} (
{% if driver == 'sqlite' %}
  "id" INTEGER PRIMARY KEY AUTOINCREMENT,
  "tag" TEXT NOT NULL,
  "time" TEXT NOT NULL,
  "body" TEXT NOT NULL,
  "body_r" TEXT NOT NULL,
  "owner" TEXT NOT NULL,
  "user" TEXT NOT NULL,
  "latest" TEXT NOT NULL DEFAULT 'N' CHECK("latest" IN ('Y', 'N')),
  "handler" TEXT NOT NULL DEFAULT 'page',
  "comment_on" TEXT NOT NULL DEFAULT ''
{% elseif driver == 'pgsql' %}
  "id" SERIAL PRIMARY KEY,
  "tag" VARCHAR(191) NOT NULL,
  "time" TIMESTAMP NOT NULL,
  "body" TEXT NOT NULL,
  "body_r" TEXT NOT NULL,
  "owner" VARCHAR(191) NOT NULL,
  "user" VARCHAR(191) NOT NULL,
  "latest" VARCHAR(1) NOT NULL DEFAULT 'N' CHECK("latest" IN ('Y', 'N')),
  "handler" VARCHAR(30) NOT NULL DEFAULT 'page',
  "comment_on" VARCHAR(191) NOT NULL DEFAULT ''
{% else %}
  `id` INT UNSIGNED NOT NULL AUTO_INCREMENT,
  `tag` VARCHAR(191) NOT NULL,
  `time` DATETIME NOT NULL,
  `body` LONGTEXT NOT NULL,
  `body_r` TEXT NOT NULL,
  `owner` VARCHAR(191) NOT NULL,
  `user` VARCHAR(191) NOT NULL,
  `latest` ENUM('Y','N') NOT NULL DEFAULT 'N',
  `handler` VARCHAR(30) NOT NULL DEFAULT 'page',
  `comment_on` VARCHAR(191) NOT NULL DEFAULT '',
  PRIMARY KEY (`id`),
  KEY `idx_tag` (`tag`),
  KEY `idx_time` (`time`),
  KEY `idx_latest` (`latest`),
  KEY `idx_comment_on` (`comment_on`),
  FULLTEXT KEY `tag` (`tag`, `body`)
{% endif %}
){% if driver == 'mysql' %} CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci ENGINE=InnoDB{% endif %};

{% if driver != 'mysql' %}
CREATE INDEX IF NOT EXISTS "{{ prefix }}pages_idx_tag" ON "{{ prefix }}pages" ("tag");
CREATE INDEX IF NOT EXISTS "{{ prefix }}pages_idx_time" ON "{{ prefix }}pages" ("time");
CREATE INDEX IF NOT EXISTS "{{ prefix }}pages_idx_latest" ON "{{ prefix }}pages" ("latest");
CREATE INDEX IF NOT EXISTS "{{ prefix }}pages_idx_comment_on" ON "{{ prefix }}pages" ("comment_on");
{% endif %}

{# Table: referrers #}
CREATE TABLE IF NOT EXISTS {% if driver == 'mysql' %}`{{ prefix }}referrers`{% else %}"{{ prefix }}referrers"{% endif %} (
{% if driver == 'sqlite' %}
  "id" INTEGER PRIMARY KEY AUTOINCREMENT,
  "page_tag" TEXT NOT NULL,
  "referrer" TEXT NOT NULL,
  "time" TEXT NOT NULL
{% elseif driver == 'pgsql' %}
  "id" SERIAL PRIMARY KEY,
  "page_tag" VARCHAR(191) NOT NULL,
  "referrer" TEXT NOT NULL,
  "time" TIMESTAMP NOT NULL
{% else %}
  `id` INT UNSIGNED NOT NULL AUTO_INCREMENT,
  `page_tag` VARCHAR(191) NOT NULL,
  `referrer` TEXT NOT NULL,
  `time` DATETIME NOT NULL,
  PRIMARY KEY (`id`),
  KEY `idx_page_tag` (`page_tag`),
  KEY `idx_time` (`time`)
{% endif %}
){% if driver == 'mysql' %} CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci ENGINE=InnoDB{% endif %};

{% if driver != 'mysql' %}
CREATE INDEX IF NOT EXISTS "{{ prefix }}referrers_idx_page_tag" ON "{{ prefix }}referrers" ("page_tag");
CREATE INDEX IF NOT EXISTS "{{ prefix }}referrers_idx_time" ON "{{ prefix }}referrers" ("time");
{% endif %}

{# Table: triples #}
CREATE TABLE IF NOT EXISTS {% if driver == 'mysql' %}`{{ prefix }}triples`{% else %}"{{ prefix }}triples"{% endif %} (
{% if driver == 'sqlite' %}
  "id" INTEGER PRIMARY KEY AUTOINCREMENT,
  "resource" TEXT NOT NULL,
  "property" TEXT NOT NULL,
  "value" TEXT NOT NULL
{% elseif driver == 'pgsql' %}
  "id" SERIAL PRIMARY KEY,
  "resource" VARCHAR(255) NOT NULL,
  "property" VARCHAR(255) NOT NULL,
  "value" TEXT NOT NULL
{% else %}
  `id` INT UNSIGNED NOT NULL AUTO_INCREMENT,
  `resource` VARCHAR(255) NOT NULL,
  `property` VARCHAR(255) NOT NULL,
  `value` TEXT NOT NULL,
  PRIMARY KEY (`id`),
  KEY `resource` (`resource`),
  KEY `property` (`property`)
{% endif %}
){% if driver == 'mysql' %} CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci ENGINE=InnoDB{% endif %};

{% if driver != 'mysql' %}
CREATE INDEX IF NOT EXISTS "{{ prefix }}triples_idx_resource" ON "{{ prefix }}triples" ("resource");
CREATE INDEX IF NOT EXISTS "{{ prefix }}triples_idx_property" ON "{{ prefix }}triples" ("property");
{% endif %}

{# Table: users #}
CREATE TABLE IF NOT EXISTS {% if driver == 'mysql' %}`{{ prefix }}users`{% else %}"{{ prefix }}users"{% endif %} (
{% if driver == 'sqlite' %}
  "name" TEXT NOT NULL PRIMARY KEY,
  "password" TEXT NOT NULL,
  "email" TEXT NOT NULL,
  "motto" TEXT NOT NULL,
  "revisioncount" INTEGER NOT NULL DEFAULT 20,
  "changescount" INTEGER NOT NULL DEFAULT 50,
  "doubleclickedit" TEXT NOT NULL DEFAULT 'Y' CHECK("doubleclickedit" IN ('Y', 'N')),
  "signuptime" TEXT NOT NULL,
  "show_comments" TEXT NOT NULL DEFAULT 'N' CHECK("show_comments" IN ('Y', 'N'))
{% elseif driver == 'pgsql' %}
  "name" VARCHAR(80) NOT NULL PRIMARY KEY,
  "password" VARCHAR(256) NOT NULL,
  "email" VARCHAR(191) NOT NULL,
  "motto" TEXT NOT NULL,
  "revisioncount" INTEGER NOT NULL DEFAULT 20,
  "changescount" INTEGER NOT NULL DEFAULT 50,
  "doubleclickedit" VARCHAR(1) NOT NULL DEFAULT 'Y' CHECK("doubleclickedit" IN ('Y', 'N')),
  "signuptime" TIMESTAMP NOT NULL,
  "show_comments" VARCHAR(1) NOT NULL DEFAULT 'N' CHECK("show_comments" IN ('Y', 'N'))
{% else %}
  `name` VARCHAR(80) NOT NULL,
  `password` VARCHAR(256) NOT NULL,
  `email` VARCHAR(191) NOT NULL,
  `motto` TEXT NOT NULL,
  `revisioncount` INT UNSIGNED NOT NULL DEFAULT 20,
  `changescount` INT UNSIGNED NOT NULL DEFAULT 50,
  `doubleclickedit` ENUM('Y','N') NOT NULL DEFAULT 'Y',
  `signuptime` DATETIME NOT NULL,
  `show_comments` ENUM('Y','N') NOT NULL DEFAULT 'N',
  PRIMARY KEY (`name`),
  KEY `idx_name` (`name`),
  KEY `idx_signuptime` (`signuptime`)
{% endif %}
){% if driver == 'mysql' %} CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci ENGINE=InnoDB{% endif %};

{% if driver != 'mysql' %}
CREATE INDEX IF NOT EXISTS "{{ prefix }}users_idx_name" ON "{{ prefix }}users" ("name");
CREATE INDEX IF NOT EXISTS "{{ prefix }}users_idx_signuptime" ON "{{ prefix }}users" ("signuptime");
{% endif %}

