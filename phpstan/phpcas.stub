<?php

/**
 * phpCAS documents both arguments of setExtraCurlOption() as strings, but hands them to curl_setopt_array():
 * the key is a CURLOPT_* constant, an int, and the value is whatever that option takes.
 * It documents getAttributes() as an array, but an attributes element with no attribute in it (LemonLDAP::NG's, when it
 * releases none) comes back as that element's text.
 */
class CAS_Client
{
    /**
     * @return array<string, mixed>|string
     */
    public function getAttributes()
    {
    }

    /**
     * @param int   $key   a CURLOPT_* constant
     * @param mixed $value
     *
     * @return void
     */
    public function setExtraCurlOption($key, $value)
    {
    }
}
