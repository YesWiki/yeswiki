# Copy to docker/.env. Docker Compose reads it from this directory; it is not committed.

# The dev image runs as your own user, so that files in the mounted checkout stay yours.
# Find these with `id -u` and `id -g`.
UID=1000
GID=1000

# The defaults below suit a single stack. To run several YesWiki stacks side by side, give
# each checkout its own project name and its own free ports. The project name also names
# the containers (<name>-app, <name>-db, ...) and the volumes (<name>-db, <name>-pg).
#COMPOSE_PROJECT_NAME=yeswiki
#YESWIKI_WEB_PORT=8085
#YESWIKI_MYADMIN_PORT=8086
#YESWIKI_MAIL_PORT=1080
#YESWIKI_S3_PORT=8333
#YESWIKI_SSO_PORT=8088
#YESWIKI_MOCK_PORT=8087
#YESWIKI_LDAP_PORT=1389
