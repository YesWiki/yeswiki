
# Yeswiki dev image
FROM php:8.4-fpm

RUN apt-get update && \
    # libpq-dev builds pdo_pgsql; the two clients are for the e2e reset script, which
    # drops and recreates the test database before every spec
    apt-get install -y libfreetype-dev libjpeg-dev libpng-dev libwebp-dev zlib1g-dev libzip-dev git unzip mariadb-client libpq-dev postgresql-client && \
    # Playwright dependencies
    apt-get install -y libglib2.0-0 libnss3 libnspr4 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 libatspi2.0-0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 libxkbcommon0 libasound2 libcups2 libpango-1.0-0 libcairo2 && \
    rm -rf /var/lib/apt/lists/*
RUN docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp
# pdo_mysql, not mysqli: the app talks to the database through PDO (DbService), and
# composer.json suggests ext-pdo_mysql. Without it the yeswiki-db service in this compose
# stack is unreachable and the installer fails with "could not find driver".
#
# pdo_pgsql for the same reason one level up: ADR-0015 commits the search index to all three
# dialects, and the PostgreSQL one -- a generated tsvector with a GIN index -- had never been
# executed by anything. A driver the image cannot load is a dialect nobody can test.
RUN docker-php-ext-install pdo_mysql pdo_pgsql gd zip

COPY --from=composer:latest /usr/bin/composer /usr/local/bin/composer

ARG UID

ARG GID

RUN groupadd -g "${GID}" yeswiki \
  && useradd --no-log-init --create-home -u "${UID}" -g "${GID}" -G www-data yeswiki

USER yeswiki

RUN curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/master/install.sh | bash && \
  export NVM_DIR="$HOME/.nvm" && \
  [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh" && \
  echo 'export NVM_DIR="/home/yeswiki/.nvm"' >> $HOME/.bashrc && \
  echo '[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"' >> $HOME/.bashrc && \
  nvm install 22 && \
  nvm alias default 22 && \
  corepack enable
