# The dev image: php-fpm with the extensions composer.json names, Node and Yarn for the assets and Playwright, run as the developer's own uid.
FROM node:24-trixie-slim AS node

FROM php:8.4-fpm

# libldap-dev builds the ldap extension for the LDAP sign-in provider; ldap-utils is for docker/sso-check.sh.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libfreetype-dev libjpeg-dev libpng-dev libwebp-dev zlib1g-dev libzip-dev libpq-dev libldap-dev \
        git unzip mariadb-client postgresql-client ldap-utils \
        libglib2.0-0 libnss3 libnspr4 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 libatspi2.0-0 libxcomposite1 libxdamage1 \
        libxfixes3 libxrandr2 libgbm1 libxkbcommon0 libasound2 libcups2 libpango-1.0-0 libcairo2 \
    && rm -rf /var/lib/apt/lists/*

RUN docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-configure ldap --with-libdir=lib/$(uname -m)-linux-gnu/ \
    && docker-php-ext-install pdo_mysql pdo_pgsql pcntl gd zip ldap

COPY --from=composer:2.11 /usr/bin/composer /usr/local/bin/composer
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && ln -s ../lib/node_modules/corepack/dist/corepack.js /usr/local/bin/corepack \
    && corepack enable

ARG UID=1000
ARG GID=1000
RUN (getent group "${GID}" >/dev/null || groupadd -g "${GID}" yeswiki) \
    && useradd --no-log-init --create-home --non-unique -u "${UID}" -g "${GID}" -G www-data yeswiki

USER ${UID}:${GID}
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
