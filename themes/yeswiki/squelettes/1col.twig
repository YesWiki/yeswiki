{# Squelette = page-level layout.

   Two named blocks, and the renderer renders them OUT OF ORDER: `body` first, then `head`
   (ticket 15, ADR-0014). That is what lets <head> carry every asset the page turned out to
   need -- by the time it renders, every action, field and included page has declared its own.
   Before this, assets registered during the page body could only be flushed at </body>,
   stylesheets included, so content was painted before its own styles arrived.

   Consequences for a theme author:
     - `{{ page_content|raw }}` is where the page goes. The old `{WIKINI_PAGE}` brace marker
       was plain text the renderer split the file on; it no longer exists.
     - `{{ declared_assets() }}` goes LAST in the head block. It emits everything declared, and
       an action written after it in that block would register too late to be included.
     - `{{linkstyle}}` and `{{linkjavascript}}` are gone. Nothing replaces them: assets are
       declared by whatever needs them and emitted once, here.
     - Actions may still be called anywhere in either block -- that freedom is why this is two
       Twig blocks rather than a fixed set of pre-rendered slots. #}
{% block head %}
<!doctype html>
<html lang="{{ action('configuration param="lang"') }}">
<head>
  <!-- HTML Metas -->
  <meta charset="{{ action('configuration param="charset"') }}">
  {{ action('metarobots')|raw }}
  <meta name="keywords" content="{{ action('configuration param="meta_keywords"') }}" />
  <meta name="description" content="{{ action('configuration param="meta_description"') }}" />
  <meta name="viewport" content="width=device-width" />

  <!-- Title of the page -->
  <title>{{ action('configuration param="wakka_name"') }} : {{ action('titrepage')|raw }}</title>

  {{ action('favicon')|raw }}
  {{ action('linkrss')|raw }}

  {# every stylesheet and script the whole page declared -- keep this last #}
  {{ declared_assets()|raw }}
</head>
{% endblock %}

{% block body %}
<body {{ action('parambody')|raw }}>

  <div id="yw-container">

    <a id="yw-a11y-jump-content" class="sr-only sr-only-focusable yw-btn" href="#yw-main">
      Aller au contenu principal
    </a>

    <nav id="yw-topnav" class="fixable" role="navigation">
      <div class="container">
          <button class="yw-btn btn-menu">{{ icon('menu-2') }}</button>
          <div class="navbar-header">
            <a class="navbar-brand" href="{{ action('configuration param="base_url"') }}{{ action('configuration param="root_page"') }}">
              {{ action('include page="PageTitre" doubleclic="1"')|raw }}
            </a>
          </div>
          {{ action('include page="PageMenuHaut" class="yw-topnav topnavpage links-container" doubleclic="1" actif="1"')|raw }}
          {{ action('include page="PageRapideHaut" class="yw-topnav-fast-access pull-right" doubleclic="1" actif="1"')|raw }}
        </div>
    </nav>

    <header id="yw-header">
      <div class="navbar-header">
        <a class="navbar-brand" href="{{ action('configuration param="base_url"') }}{{ action('configuration param="root_page"') }}">
          {{ action('include page="PageTitre" doubleclic="1"')|raw }}
        </a>
      </div>
      {{ action('include page="PageHeader" class="yw-headerpage" doubleclic="1"')|raw }}
    </header>

    <div id="yw-main" role="main" {{ action('doubleclic')|raw }}>
      <div class="yw-main-content alone">
        {{ page_content|raw }}
      </div>
    </div>

    {{ action('barreredaction')|raw }}

    <footer id="yw-footer">
      <div class="container">
        {{ action('include page="PageFooter" class="footerpage" doubleclic="1"')|raw }}
      </div> <!-- /.container -->
    </footer><!-- /#yw-footer -->
  </div> <!-- /#yw-container -->

</body>
</html>
{% endblock %}
