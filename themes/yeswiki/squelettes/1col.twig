
{% block head %}
<!doctype html>

<html lang="{{ action('configuration param="lang"') }}" style="{{ layout_root_style() }}">
<head>
  <!-- HTML Metas -->
  <meta charset="{{ action('configuration param="charset"') }}">
  {{ action('metarobots')|raw }}
  <meta name="keywords" content="{{ action('configuration param="meta_keywords"') }}" />
  <meta name="description" content="{{ action('configuration param="meta_description"') }}" />
  <meta name="viewport" content="width=device-width" />

  <!-- Title of the page -->
  <title>{{ action('configuration param="wakka_name"') }} : {{ action('pagetitle')|raw }}</title>

  {{ action('favicon')|raw }}
  {{ action('linkrss')|raw }}

  {{ declared_assets()|raw }}
</head>
{% endblock %}

{% block body %}
<body {{ action('parambody')|raw }}{% if htmx_navigation %} hx-boost="true" hx-indicator=".yw-progress" hx-headers='{"{{ layout_fingerprint_header }}": "{{ layout_fingerprint }}"}'{% endif %}>
  {{ page_state()|raw }}

  <div class="yw-progress htmx-indicator" aria-hidden="true"></div>

  <div id="yw-navigation-announcer" class="sr-only" role="status" aria-live="polite"></div>

  <div id="yw-container">

    <a id="yw-a11y-jump-content" class="sr-only sr-only-focusable yw-btn" href="#yw-main">
      Aller au contenu principal
    </a>

    <nav id="yw-topnav" class="fixable" role="navigation">
      <div class="container" id="yw-layout-chrome">
        {{ layout_chrome()|raw }}
      </div>
    </nav>

    <header id="yw-header" class="yw-chrome-editable">
      {{ layout_edit('header')|raw }}
      {{ action('include page="' ~ layout_page('PageHeader') ~ '" class="yw-headerpage" doubleclick="1"')|raw }}
    </header>

    <div id="yw-main" role="main" tabindex="-1" {{ action('doubleclick')|raw }}>
      <div class="yw-main-content alone">
        {{ page_content|raw }}
      </div>

      {{ action('editbar')|raw }}
    </div>

    <footer id="yw-footer" class="yw-chrome-editable">

      {{ layout_edit('footer')|raw }}
      <div class="container">
        {{ action('include page="' ~ layout_page('PageFooter') ~ '" class="footerpage" doubleclick="1"')|raw }}
      </div> <!-- /.container -->
    </footer><!-- /#yw-footer -->
  </div> <!-- /#yw-container -->

</body>
</html>
{% endblock %}
