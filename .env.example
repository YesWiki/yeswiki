# YesWiki environment file example.
#
# Copy this file to private/.env (NOT to the YesWiki root: the root is served by
# the web server, while private/ is denied to web requests). It is loaded for
# every entry point (web, CLI console, tests) and is per-instance: in a wiki farm,
# each instance has its own private/.env.
#
# Real environment variables (e.g. set by Docker, the vhost or CI) always take
# precedence over values defined in this file.
#
# Configuration overrides: every value below wins over yeswiki.config.php. Beyond
# this list, ANY configuration value (including extension parameters from the
# tools' config.yaml) can be overridden from this file by using its uppercased
# name, e.g. FAVORITES_ACTIVATED=false for favorites_activated. Array-valued
# configuration keys cannot be overridden.

# ------------------------------------------------------------------------------
# Process environment (not configuration values)
# ------------------------------------------------------------------------------

# Path to the configuration file of this instance (default: yeswiki.config.php)
#YESWIKI_CONFIG_FILE="yeswiki.config.php"

# PHP binary used to spawn asynchronous background jobs (default: auto-detected)
#ASYNC_PHP_BINARY="/usr/bin/php"

# ------------------------------------------------------------------------------
# Database connection (config keys db_driver, db_host, ...)
# ------------------------------------------------------------------------------

#DB_DRIVER="mysql"            # mysql or sqlite
#DB_HOST="localhost"
#DB_DATABASE="yeswikidb"
#DB_USER="yeswikidbuser"
#DB_PASSWORD="secret"
#DB_PORT="3306"
#TABLE_PREFIX="yeswiki_"

# ------------------------------------------------------------------------------
# Wiki identity and behaviour
# ------------------------------------------------------------------------------

#BASE_URL="http://yeswiki.test:8000/?"
#YESWIKI_NAME="YesWiki Dev"
#DEFAULT_LANGUAGE="fr"
#TIMEZONE="Europe/Paris"
#ROOT_PAGE="PagePrincipale"
#META_DESCRIPTION="Description of this YesWiki"
#META_KEYWORDS="yeswiki, php, collaboration"
#DEBUG=true                   # boolean (the historical 'yes'/'no' values of old config files are still accepted there)
#ALLOW_RAW_HTML=true
#REWRITE_MODE=false

# ------------------------------------------------------------------------------
# Outgoing mail
# ------------------------------------------------------------------------------

#CONTACT_MAIL_FUNC="smtp"     # mail, sendmail or smtp
#CONTACT_SMTP_HOST="127.0.0.1"
#CONTACT_SMTP_PORT="1025"
#CONTACT_SMTP_USER=""
#CONTACT_SMTP_PASS=""
#CONTACT_SMTP_SECURE=""       # ssl, tls or empty for auto
#CONTACT_REPLY_TO=""
#CONTACT_DEBUG=0              # 0 none, 1 client, 2 client and server messages

# ------------------------------------------------------------------------------
# Planned variables — NOT read by the code yet
# ------------------------------------------------------------------------------
# These will be honored by the upcoming web installer / automated installation.

#ALLOW_ROBOTS=false

# Initial administrator account, to fully automate the installation of YesWiki.
# These are deliberately never merged into the configuration. Still, avoid keeping
# plain passwords in this file: prefer passing them as real environment variables,
# or delete them once the installation is done.
#ADMIN_NAME="WikiAdmin"
#ADMIN_PASSWORD="A very long and secure password, with spécials chars and UPPERCASES !!!"
#ADMIN_EMAIL="me@example.com"
