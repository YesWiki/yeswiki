{% extends "@bazar/layouts/input.twig" %}

{% block input %}
{{ include_css('tools/bazar/presentation/styles/inputs/checkbox-drag-and-drop.css') }}
{% set selectedCount = not (attribute(selectedOptionsId,0) is empty) ? selectedOptionsId|length : 0 %}
{% set panelHeight = height ?? 320 %}
<div class="row row-fluid yeswiki-checkbox checkbox{{ field.required ? ' chk_required' : ''}}">
	<div class="col-sm-6 export-table-container">
		<div class="checkbox-panel-header">
			<h4 class="checkbox-panel-title">
				{{ formName ?: _t('BAZ_DRAG_n_DROP_CHECKBOX_AVAILABLE_ITEM') }}
				<img loading="lazy" class="tooltip_aide" title="{{ _t('BAZ_DRAG_n_DROP_CHECKBOX_ITEM_INFO') ~ "'+'." }}" alt="{{ _t('BAZ_DRAG_n_DROP_CHECKBOX_ITEM_INFO') ~ "'+'." }}" src="tools/bazar/presentation/images/aide.png" width="16" height="16" />
			</h4>
			<a class="btn btn-sm btn-success checkbox-select-all" title="{{ _t('BAZ_DRAG_n_DROP_CHECKBOX_ADD_ALL') }}" href="#">
				<i class="fas fa-plus"></i> {{ _t('BAZ_DRAG_n_DROP_CHECKBOX_ADD_ALL') }}
			</a>
		</div>
		<div class="input-group input-group-sm checkbox-filter-group">
			<span class="input-group-addon add-on"><i class="fas fa-filter"></i></span>
			<input class="checkbox-filter-input form-control input-sm" type="text" id="filter-{{ field.propertyName }}" value="" placeholder="{{ _t('BAZ_DRAG_n_DROP_CHECKBOX_FILTER_ITEM') }}" />
			<span class="input-group-btn add-on">
				<button class="btn btn-default btn-sm btn-erase-filter" type="button">&times;</button>
			</span>
		</div>
		<div class="checkbox-panel-count">{{ _t('BAZ_DRAG_n_DROP_CHECKBOX_FILTER_TEXT') }}<span class="checkbox-filter-count">{{ options|length - selectedCount }}</span></div>
		<div class="checkbox-panel-scroll" style="max-height:{{ panelHeight }}px;">
			<ul class="list-entries-to-export list-group group-{{ field.propertyName }}" data-group="{{ field.propertyName }}">
			{% block list_options %}
				{% for item_id, item in options %}
					{% if item_id not in selectedOptionsId %}
						{% set selected = false %}
						{% set detail = optionsDetails[item_id]|default(null) %}
						{% block li_item %}
						<li class="list-group-item">
							<span class="{{ not selected ? 'hide ' }}movable btn btn-default btn-xs"><i class="fas fa-arrows-alt-v"></i></span>
							<div class="checkbox-icons-up-down{{ not selected ? ' hide ' }}">
								<div class="checkbox-icons-up btn btn-default btn-xs"><i class="fas fa-chevron-up"></i></div>
								<div class="checkbox-icons-down btn btn-default btn-xs"><i class="fas fa-chevron-down"></i></div>
							</div>
							<div class="checkbox-icon-column-left">
								<span class="movable-h btn btn-default btn-xs{{ selected ? ' hide ' }}"><i class="fas fa-arrows-alt-h"></i></span>
								{%~ block link_for_entry ~%}
								{%~ endblock ~%}
							</div>
							<input type="checkbox" id="{{ field.propertyName }}_{{ item_id }}" value="1" name="{{ field.propertyName }}[{{ item_id }}]" class="element_checkbox hide"{{ selected ? ' checked' }}>
							{% if detail.image is defined and detail.image %}
								<img loading="lazy" class="checkbox-item-thumbnail" src="{{ detail.image }}" alt="">
							{% endif %}
							<div class="checkbox-item-body">
								<span class="list-item-text">{{ item|striptags }}</span>
								{% if detail.description is defined and detail.description %}
									<span class="checkbox-item-description">{{ detail.description }}</span>
								{% endif %}
							</div>
							<a class="btn btn-xs btn-success select-page-item{{ selected ? ' hide ' }}" title="{{ _t('BAZ_DRAG_n_DROP_CHECKBOX_SELECT_ITEM') ~ " " ~ item|e ~ " " ~ _t('BAZ_DRAG_n_DROP_CHECKBOX_FOR_THE_LIST') }}" href="#">
								<i class="fas fa-plus"></i>
							</a>
							<a class="btn btn-xs btn-danger remove-page-item{{ not selected ? ' hide ' }}" title="{{ _t('BAZ_DRAG_n_DROP_CHECKBOX_DELETE_ITEM') ~ " " ~ item|e ~ " " ~ _t('BAZ_DRAG_n_DROP_CHECKBOX_FROM_THE_LIST') }}" href="#">
								<i class="fas fa-minus"></i>
							</a>
						</li>
						{% endblock %}
					{% endif %}{# if item_id not in selectedOptionsId #}
				{% endfor %}{# for item_id, item in options #}
			{% endblock %}
				<li class="list-group-item empty-list" style="display:none;">{{ _t('BAZ_DRAG_n_DROP_CHECKBOX_EMPTY_LIST') }}</li>
			</ul>
			<input type="hidden" value="{{ oldValue ?? '\'\''}}" name="{{ field.propertyName ~ field.fromFormId }}">
		</div>
	</div><!-- /.col-sm-6.export-table-container -->

	<div class="col-sm-6 import-table-container">
		<div class="checkbox-panel-header">
			<h4 class="checkbox-panel-title">
				{{ _t('BAZ_DRAG_n_DROP_CHECKBOX_YOUR') }} {{ name }}
				<img loading="lazy" class="tooltip_aide" title="{{ _t('BAZ_DRAG_n_DROP_CHECKBOX_ORDER_ITEM_INFO') }}" alt="{{ _t('BAZ_DRAG_n_DROP_CHECKBOX_ORDER_ITEM_INFO') }}" src="tools/bazar/presentation/images/aide.png" width="16" height="16" />
			</h4>
			<a class="btn btn-sm btn-danger checkbox-remove-all" title="{{ _t('BAZ_DRAG_n_DROP_CHECKBOX_REMOVE_ALL') }}" href="#">
				<i class="fas fa-minus"></i> {{ _t('BAZ_DRAG_n_DROP_CHECKBOX_REMOVE_ALL') }}
			</a>
		</div>
		<div class="checkbox-panel-count">{{ _t('BAZ_DRAG_n_DROP_CHECKBOX_SELECTED_TEXT') }}<span class="checkbox-selected-count">{{ selectedCount }}</span></div>
		<div class="checkbox-panel-scroll" style="max-height:{{ panelHeight }}px;">
			<ul class="checkbox-selection-container list-group group-{{ field.propertyName }}" data-group="{{ field.propertyName }}">
			{% if selectedCount > 0 %}
			{% block list_selected %}
			  {% for item_id in selectedOptionsId %}
				{% set item = attribute(options,item_id) %}
				{% set selected = true %}
				{% set detail = optionsDetails[item_id]|default(null) %}
				{{ block('li_item') }}
			  {% endfor %}{# for item_id in selectedOptionsId #}
			{% endblock %}
			{% endif %}{# if selectedCount > 0 #}
			<li class="list-group-item empty-list" {% if selectedCount > 0 %}style="display:none;"{% endif %}>{{ _t('BAZ_DRAG_n_DROP_CHECKBOX_EMPTY_LIST') }}</li>
			</ul>
		</div>
	</div> <!-- /.col-sm-6.import-table-container -->
</div> <!-- /.row -->
{{ include_javascript('javascripts/vendor/jquery-ui-sortable/jquery-ui.min.js') }}
{{ include_javascript('tools/bazar/presentation/javascripts/inputs/checkbox-drag-and-drop.js') }}
{% endblock %}
