{% 
	
	set vIDsParameter = params.idtypeannonce is defined
						? params.idtypeannonce
						: ( params.id is defined
							? params.id
							: null)

%}

{%

	set vIDsString = vIDsParameter is iterable
					? ( vIDsParameter is not empty
							? vIDsParameter | join(',')
							: ""
					  )
					: vIDsParameter 
%}

{% 
	set vIDsObject = (
						vIDsString is defined
						? { id : vIDsString }
						: {}
		 			 )
%}

{%
	set vBase64EncodedIDs = b64 (vIDsString) | url_encode
%}

{% 
	set vQuery =	(
						params.query is defined and params.query is not empty
						? { query : (params.query	| map(p => p.name ~ p.operator ~ (p.values|join(",")))
													| filter(v => v is not empty)
    		  										| join('|')) }
    		  			: {}
    		  		) 
%}

{% 
	set vKeywords =	(
						params.keywords is defined
						? { keywords : params.keywords }
						: {}
					)
%}

{% 
	set vSearchFields =	(
							params.searchfields is defined
							? { searchfields : params.searchfields | join(",") }													
							: {}
						)
%}

{% 
	set vCorrespondance =	(
								params.correspondance is defined
								? { correspondance : params.correspondance }
								: {}
							)
%}

{% 
	set vOrdre =	(
							params.ordre is defined
							? { ordre : params.ordre }
							: {}
					)
%}

{% 
	set vChamp =	(
							params.champ is defined
							? { champ : params.champ }
							: {}
					)
%}

{% 
	set vPeriod =	(
						params.period is defined
						? { period : params.period }
						: {}
					)
%}

{% 
	set vDateFilter =	(
							params.datefilter is defined
							? { datefilter : params.datefilter }
							: {}
						)
%}

{% 
	set vNb =	(
					params.nb is defined
					? { nb : params.nb }
					: {}
				)
%}

{% 
	set vPeriod =	(
						params.period is defined
						? { period : params.period }
						: {}
					)
%}

{% 
	set vGenericParams = {}
		| merge (vQuery)
		| merge (vKeywords)
		| merge (vSearchFields)
		| merge (vCorrespondance)
		| merge (vDateFilter)
		| merge (vNb)
		| merge (vPeriod)
		
%}

{% 
	set vRSSParams = {} 
		| merge (vGenericParams)
		| merge (vIDsObject)
		
%}

{%
	set vCSVParams = {} 
		| merge (vGenericParams)
		| merge (vOrdre) 
		| merge (vChamp)  

%}

{%
	set vJSONParams = {}
		| merge (vGenericParams)
		| merge (vOrdre) 
		| merge (vChamp)  		
%}

<div class="export-links pull-right">
	<a class="btn btn-default btn-mini btn-xs" data-toggle="tooltip" data-placement="bottom" title="{{ _t('BAZ_RSS')|raw('html') }}" target="_blank" href="{{ url ({handler:'rss', params: vRSSParams  }) }}"><i class="fa fa-signal icon-signal"></i></a>

	<a class="btn btn-default btn-mini btn-xs" data-toggle="tooltip" data-placement="bottom" title="{{ _t('BAZ_CSV')|raw('html') }}" target="_blank" href="{{ url ({ tag: 'api', handler: 'forms/' ~ 'b64_' ~ vBase64EncodedIDs ~ '/entries/csv', params: vCSVParams }) }}">CSV</a>
  
	<a class="btn btn-default btn-mini btn-xs" data-toggle="tooltip" data-placement="bottom" title="{{ _t('BAZ_JSON')|raw('html') }}" target="_blank" href="{{ url ({ tag: 'api', handler: 'forms/' ~ 'b64_' ~ vBase64EncodedIDs ~ '/entries', params: vJSONParams }) }}">JSON</a>
  
</div>

