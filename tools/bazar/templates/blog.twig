{{ include_css('tools/bazar/presentation/styles/blog.css') }}
{{ include_javascript('tools/bazar/presentation/javascripts/relative-time.js', false, true) }}
{% set withLead = ((params.header ?? 'true') ~ '')|lower in ['true', '1'] %}
{% set showAuthor = ((params.show_author ?? '1') ~ '') != '0' %}
{% set showDate = ((params.show_date ?? '1') ~ '') != '0' %}

{% macro image(fiche, width, height) %}
  {% set file = fiche.imagebf_image %}
  {% if fiche['external-data'] %}
    {% set src = fiche['external-data'].baseUrl ~ 'files/' ~ file %}
  {% elseif file matches '#^(https?:)?//#i' %}
    {% set src = urlImage({fileName: file, width: width, height: height, mode: 'crop'}) %}
  {% else %}
    {% set src = urlImage({fileName: 'files/' ~ file, width: width, height: height, mode: 'crop'}) %}
  {% endif %}
  <a class="blog-entry__media" href="{{ fiche.url }}" tabindex="-1" aria-hidden="true">
    <img loading="lazy" alt="" src="{{ src }}" width="{{ width }}" height="{{ height }}">
  </a>
{% endmacro %}

{% macro meta(fiche, showDate, showAuthor) %}
  {% set author = fiche.origin.author ?? {} %}
  {% if (showDate and fiche.date_creation_fiche is not empty) or (showAuthor and author.name is not empty) %}
    <p class="blog-entry__meta">
      {% if showDate and fiche.date_creation_fiche is not empty %}
        {% set time %}<time class="yw-relative-time" datetime="{{ fiche.date_creation_fiche|date('c') }}">{{ fiche.date_creation_fiche|date('d/m/Y H:i') }}</time>{% endset %}
        {% if fiche.origin.generatedTitle ?? false %}
          <a class="blog-entry__permalink" href="{{ fiche.url }}">{{ time }}</a>
        {% else %}
          {{ time }}
        {% endif %}
      {% endif %}
      {% if showAuthor and author.name is not empty %}
        {% if author.url %}
          <a class="blog-entry__author" href="{{ author.url }}" title="{{ author.handle }}" rel="nofollow noopener">{{ author.name }}</a>
        {% else %}
          <span class="blog-entry__author">{{ author.name }}</span>
        {% endif %}
      {% endif %}
    </p>
  {% endif %}
{% endmacro %}

{% import _self as blog %}
{% if fiches|length > 0 %}
  <div class="blog-entries">
    {% for fiche in fiches %}
      {% set isLead = withLead and loop.first %}
      {% set summary = fiche.bf_chapeau ?? fiche.soustitre ?? '' %}
      <article class="blog-entry bazar-entry{{ isLead ? ' blog-entry--lead' }}{{ fiche.imagebf_image is empty ? ' blog-entry--no-media' }}" {{ fiche.html_data|raw }}>
        {% if fiche.imagebf_image is not empty %}
          {{ blog.image(fiche, isLead ? 650 : 340, isLead ? 416 : 212) }}
        {% endif %}
        <div class="blog-entry__body">
          {% if fiche.origin.generatedTitle ?? false %}
            <div class="blog-entry__text">{{ format(summary is not empty ? summary : (fiche.bf_description ?? ''))|raw }}</div>
          {% else %}
            <h3 class="blog-entry__title"><a href="{{ fiche.url }}">{{ fiche.bf_titre }}</a></h3>
          {% endif %}
          {% if isLead and summary is not empty and not (fiche.origin.generatedTitle ?? false) %}
            {% set text = format(summary)|striptags|trim %}
            <p class="blog-entry__summary">{{ (text|length > 280 ? text|slice(0, 280)|split(' ')|slice(0, -1)|join(' ') ~ '…' : text)|raw }}</p>
          {% endif %}
          {{ blog.meta(fiche, showDate, showAuthor) }}
        </div>
      </article>
    {% endfor %}
  </div>
{% endif %}
{{ pager_links|raw }}
