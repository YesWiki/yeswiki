<div class="mail-period">
  {% for messageType, message in messages %}
    <div class="alert alert-{{ messageType }}">{{ message }}</div>
  {% endfor %}

  <label>{{ _t('CONTACT_PERIOD') }}</label>

  {% if user %}
    <form method="post" class="btn-group btn-group-sm" role="group" style="margin-left: 1rem">
      <input type="hidden" name="csrf-token" value="{{ csrfToken({id: 'main', refresh: false})|e('html_attr') }}">
      {% for config in periods %}
        <button type="submit" name="subscribe" value="{{ config.period }}" class="btn btn-{{ config.subscribed ? 'primary' : 'default' }}">
          {{ config.label }}
        </button>
      {% endfor %}
      {% if subscribed %}
        <button type="submit" name="unsubscribe" value="1" class="btn btn-danger">
          {{ _t('CONTACT_UNSUBSCRIBE') }}
        </button>
      {% endif %}
    </form>
  {% else %}
    <div class="btn-group btn-group-sm" role="group" style="margin-left: 1rem">
      {% for config in periods %}
        <a href="#LoginModal" data-toggle="modal" class="btn btn-default">{{ config.label }}</a>
      {% endfor %}
    </div>
  {% endif %}
</div>
