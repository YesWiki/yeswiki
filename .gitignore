# we ignore all folders other than yeswiki's ones, to be able to use farm for example
/*/
!.github/
!actions/
!cache/
!custom/
!docs/
!files/
!handlers/
!javascripts/
!lang/
!private/
!src/
!styles/
!templates/
!tests/
!themes/
!extensions/
!docker/
!phpstan/
!binary/

# Composer
vendor

# Node modules
node_modules
javascripts/vendor/
styles/vendor/

# SEO
robots.txt

# PHPStan's config, baseline, bootstrap and stubs are repo content -- CI runs
# `composer analyse` against them. Only a result cache, if ever pointed here
# (parameters.tmpDir), is generated.
/phpstan/cache/

# YesWiki stuff
.env
.php-version
*.config.php
info.php
cache/*
!cache/README.md
files/*
!files/README.md
themes/*
!themes/README.md
# the bundled yw-native default theme (ticket 16) is part of core
!themes/yeswiki
custom/*
!custom/.gitkeep
!custom/extensions
custom/extensions/*
!custom/extensions/.gitkeep
private/*
!private/.htaccess
!private/backups
private/backups/*
!private/backups/.htaccess
!private/backups/README.md

# tools
# extensions (ticket 25, formerly tools/): the shared dir ships only the
# helloworld sample; community extensions installed there stay untracked
extensions/*
!extensions/README.md
!extensions/helloworld
!extensions/helloworld/**

# Macintosh OS
.DS_Store

# Eclipse IDE
.buildpath
.project
.settings/

# PHPStorm IDE
.idea
*.iml

# vscode IDE
!.vscode
.vscode/settings.json

# IA slop
CLAUDE.md
docs/agents

# Docker
.db
docker-compose.local.yml

# Other
.phpintel/
*.old
.php-cs-fixer.cache
.twig-cs-fixer.cache
.gitconfig
